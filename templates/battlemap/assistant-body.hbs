<section class="acks-extras-battlemap-body">

  {{#if warnNotSquare}}
    <p class="acks-extras-battlemap-warn"><i class="fa-solid fa-triangle-exclamation"></i> {{localize "ACKS-BATTLEMAP.warn.notSquareGrid"}}</p>
  {{/if}}
  {{#if warnNoBackground}}
    <p class="acks-extras-battlemap-warn"><i class="fa-solid fa-triangle-exclamation"></i> {{localize "ACKS-BATTLEMAP.warn.noBackground"}}</p>
  {{/if}}

  {{! The fit, read at a glance: this is the live feedback while sampling, so
      it leads. Sampling itself is the Battlemap scene controls' job. }}
  <div class="acks-extras-battlemap-card">
    {{#if fitOk}}
      <div class="acks-extras-battlemap-cardhead">
        <span class="acks-extras-battlemap-cell">{{cellLabel}}</span>
        <span class="acks-extras-battlemap-unit">{{localize "ACKS-BATTLEMAP.fit.pxCell"}}</span>
      </div>
      <div class="acks-extras-battlemap-meter">
        <div class="acks-extras-battlemap-meterbar" style="width: {{residualBar}}%"></div>
      </div>
      <div class="acks-extras-battlemap-sub">{{residualPct}}% · {{confidenceLabel}}</div>
      {{#if sampleSummary}}<div class="acks-extras-battlemap-sub">{{sampleSummary}}</div>{{/if}}
      {{#if fitAffine}}<div class="acks-extras-battlemap-sub">{{localize "ACKS-BATTLEMAP.fit.affine"}} {{fitAffine.skew}}° / {{fitAffine.rotation}}°</div>{{/if}}
    {{else}}
      <div class="acks-extras-battlemap-sub">{{localize "ACKS-BATTLEMAP.fit.none"}}</div>
    {{/if}}
  </div>

  {{#if warnResidual}}
    <p class="acks-extras-battlemap-warn"><i class="fa-solid fa-triangle-exclamation"></i> {{localize "ACKS-BATTLEMAP.warn.highResidual"}}</p>
  {{/if}}

  {{#if sampleRows.length}}
    <ul class="acks-extras-battlemap-samples">
      {{#each sampleRows}}
        <li>
          <span>{{label}}</span>
          <button type="button" data-action="deleteSample" data-kind="{{kind}}" data-index="{{index}}" data-tooltip="{{localize 'ACKS-BATTLEMAP.samples.drop'}}"><i class="fa-solid fa-xmark"></i></button>
        </li>
      {{/each}}
    </ul>
  {{/if}}

  <div class="acks-extras-battlemap-rule"><span>{{localize "ACKS-BATTLEMAP.scale.title"}}</span></div>

  <div class="acks-extras-battlemap-row">
    <label class="acks-extras-battlemap-field">
      <span>{{localize "ACKS-BATTLEMAP.fields.mapCellFeet"}}</span>
      <input type="number" name="mapCellFeet" min="0" step="any" value="{{opts.mapCellFeet}}" placeholder="{{mapCellFeet}}">
    </label>
    <label class="acks-extras-battlemap-field">
      <span>{{localize "ACKS-BATTLEMAP.scale.output"}}</span>
      <input type="number" name="outputFeet" min="0" step="any" value="{{opts.outputFeet}}" placeholder="{{outputFeet}}">
    </label>
  </div>

  <div class="acks-extras-battlemap-chips">
    {{#each outputChips}}
      <button type="button" data-action="outputChip" data-value="{{value}}" class="{{#if active}}active{{/if}}">{{value}}</button>
    {{/each}}
  </div>

  {{#if barFeet}}
    <div class="acks-extras-battlemap-sub">{{localize "ACKS-BATTLEMAP.scale.fromBar"}}: <strong>{{barFeet}}</strong> {{units}}</div>
  {{/if}}
  {{#if suggestions.length}}
    <div class="acks-extras-battlemap-chips">
      {{#each suggestions}}
        <button type="button" data-action="confirmChip" data-value="{{value}}" class="{{#if active}}active{{/if}}">{{value}}</button>
      {{/each}}
    </div>
  {{/if}}
  {{#if notAligned}}
    <p class="acks-extras-battlemap-warn"><i class="fa-solid fa-triangle-exclamation"></i> {{localize "ACKS-BATTLEMAP.warn.notAligned"}}</p>
  {{/if}}

  <div class="acks-extras-battlemap-row">
    <label class="acks-extras-battlemap-field">
      <span>{{localize "ACKS-BATTLEMAP.fields.scaleValue"}}</span>
      <input type="number" name="scaleValue" min="0" step="any" value="{{opts.scaleValue}}">
    </label>
    <label class="acks-extras-battlemap-field">
      <span>{{localize "ACKS-BATTLEMAP.scale.gridPx"}}</span>
      <input type="number" name="gridSizePx" min="0" step="1" value="{{opts.gridSizePx}}" placeholder="{{gridSizePx}}">
    </label>
  </div>

  <div class="acks-extras-battlemap-rule"><span>{{localize "ACKS-BATTLEMAP.fit.title"}}</span></div>

  <label class="acks-extras-battlemap-check">
    <input type="checkbox" name="independentXY" {{checked independentXY}}>
    <span>{{localize "ACKS-BATTLEMAP.fit.independentXY"}}</span>
  </label>
  <label class="acks-extras-battlemap-check">
    <input type="checkbox" name="allowSkew" {{checked allowSkew}}>
    <span>{{localize "ACKS-BATTLEMAP.fit.allowSkew"}}</span>
  </label>
  {{#if dropBack}}<div class="acks-extras-battlemap-sub">{{localize "ACKS-BATTLEMAP.fit.dropBack"}}</div>{{/if}}

  {{#if canBake}}
    <div class="acks-extras-battlemap-note">
      <div>{{localize "ACKS-BATTLEMAP.apply.bakeWhy"}}</div>
      <button type="button" data-action="bake">
        <i class="fa-solid fa-wand-magic-sparkles"></i> {{localize "ACKS-BATTLEMAP.apply.bake"}}
      </button>
    </div>
  {{/if}}

  <div class="acks-extras-battlemap-rule"><span>{{localize "ACKS-BATTLEMAP.tokens.title"}}</span></div>

  <div class="acks-extras-battlemap-chips">
    {{#each hotbar}}
      <button type="button" data-action="sizeChip" data-feet="{{value}}">{{label}}</button>
    {{/each}}
    <button type="button" data-action="resetFootprints" data-tooltip="{{localize 'ACKS-BATTLEMAP.tokens.reset'}}"><i class="fa-solid fa-rotate-left"></i></button>
  </div>

</section>
