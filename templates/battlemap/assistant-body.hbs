<section class="acks-extras-battlemap-body">

  {{#if warnNotSquare}}
    <p class="acks-extras-battlemap-warn"><i class="fa-solid fa-triangle-exclamation"></i> {{localize "ACKS-BATTLEMAP.warn.notSquareGrid"}}</p>
  {{/if}}
  {{#if warnNoBackground}}
    <p class="acks-extras-battlemap-warn"><i class="fa-solid fa-triangle-exclamation"></i> {{localize "ACKS-BATTLEMAP.warn.noBackground"}}</p>
  {{/if}}

  <fieldset>
    <legend>{{localize "ACKS-BATTLEMAP.capture.title"}}</legend>
    <div class="acks-extras-battlemap-modes">
      {{#each modes}}
        <button type="button" data-action="setMode" data-mode="{{mode}}" class="{{#if active}}active{{/if}}">{{label}}</button>
      {{/each}}
      <button type="button" data-action="wipe" data-tooltip="{{localize 'ACKS-BATTLEMAP.samples.wipeHint'}}">
        <i class="fa-solid fa-trash"></i> {{localize "ACKS-BATTLEMAP.samples.wipe"}}
      </button>
    </div>
    <p class="hint">{{localize "ACKS-BATTLEMAP.capture.hint"}}</p>

    <div class="form-group">
      <label>{{localize "ACKS-BATTLEMAP.fields.mapCellFeet"}}</label>
      <div class="form-fields"><input type="number" name="mapCellFeet" min="0" step="any" value="{{opts.mapCellFeet}}" placeholder="5"></div>
      <p class="hint">{{localize "ACKS-BATTLEMAP.fields.mapCellFeetHint"}}</p>
    </div>
    <div class="form-group">
      <label>{{localize "ACKS-BATTLEMAP.fields.scaleValue"}}</label>
      <div class="form-fields"><input type="number" name="scaleValue" min="0" step="any" value="{{opts.scaleValue}}"></div>
      <p class="hint">{{localize "ACKS-BATTLEMAP.fields.scaleValueHint"}}</p>
    </div>

    {{#if sampleRows.length}}
      <ul class="acks-extras-battlemap-samples">
        {{#each sampleRows}}
          <li>
            <span>{{label}}</span>
            <button type="button" data-action="deleteSample" data-kind="{{kind}}" data-index="{{index}}"><i class="fa-solid fa-xmark"></i></button>
          </li>
        {{/each}}
      </ul>
    {{else}}
      <p class="hint">{{localize "ACKS-BATTLEMAP.samples.empty"}}</p>
    {{/if}}
  </fieldset>

  <fieldset>
    <legend>{{localize "ACKS-BATTLEMAP.fit.title"}}</legend>
    <div class="form-group">
      <label>{{localize "ACKS-BATTLEMAP.fit.independentXY"}}</label>
      <div class="form-fields"><input type="checkbox" name="independentXY" {{checked independentXY}}></div>
    </div>
    <div class="form-group">
      <label>{{localize "ACKS-BATTLEMAP.fit.allowSkew"}}</label>
      <div class="form-fields"><input type="checkbox" name="allowSkew" {{checked allowSkew}}></div>
    </div>

    {{#if fitOk}}
      <p class="acks-extras-battlemap-fit">{{fitCells}} · {{fitQuality}}</p>
      {{#if fitAffine}}
        <p class="acks-extras-battlemap-fit">{{localize "ACKS-BATTLEMAP.fit.affine"}}: {{fitAffine.skew}}° / {{fitAffine.rotation}}°</p>
      {{/if}}
      {{#if dropBack}}
        <p class="hint">{{localize "ACKS-BATTLEMAP.fit.dropBack"}}</p>
      {{/if}}
      {{#if warnResidual}}
        <p class="acks-extras-battlemap-warn"><i class="fa-solid fa-triangle-exclamation"></i> {{localize "ACKS-BATTLEMAP.warn.highResidual"}}</p>
      {{/if}}
    {{else}}
      <p class="hint">{{localize "ACKS-BATTLEMAP.fit.none"}}</p>
    {{/if}}
  </fieldset>

  <fieldset>
    <legend>{{localize "ACKS-BATTLEMAP.scale.title"}}</legend>
    {{#if barFeet}}
      <p class="acks-extras-battlemap-raw">{{localize "ACKS-BATTLEMAP.scale.fromBar"}}: <strong>{{barFeet}}</strong> {{units}}</p>
    {{/if}}
    {{#if suggestions.length}}
      <div class="acks-extras-battlemap-chips">
        {{#each suggestions}}
          <button type="button" data-action="confirmChip" data-value="{{value}}" class="{{#if active}}active{{/if}}">{{value}}</button>
        {{/each}}
      </div>
    {{/if}}
    <div class="form-group">
      <label>{{localize "ACKS-BATTLEMAP.scale.confirm"}}</label>
      <div class="form-fields"><input type="number" name="confirmFeet" min="0" step="any" value="{{opts.confirmFeet}}" placeholder="{{mapCellFeet}}"></div>
      <p class="hint">{{localize "ACKS-BATTLEMAP.scale.confirmHint"}}</p>
    </div>

    <div class="form-group">
      <label>{{localize "ACKS-BATTLEMAP.scale.output"}}</label>
      <div class="form-fields"><input type="number" name="outputFeet" min="0" step="any" value="{{opts.outputFeet}}" placeholder="{{outputFeet}}"></div>
      <p class="hint">{{localize "ACKS-BATTLEMAP.scale.outputHint"}}</p>
    </div>
    <div class="acks-extras-battlemap-chips">
      {{#each outputChips}}
        <button type="button" data-action="outputChip" data-value="{{value}}" class="{{#if active}}active{{/if}}">{{value}}</button>
      {{/each}}
    </div>
    {{#if notAligned}}
      <p class="acks-extras-battlemap-warn"><i class="fa-solid fa-triangle-exclamation"></i> {{localize "ACKS-BATTLEMAP.warn.notAligned"}}</p>
    {{/if}}

    <div class="form-group">
      <label>{{localize "ACKS-BATTLEMAP.scale.gridPx"}}</label>
      <div class="form-fields"><input type="number" name="gridSizePx" min="0" step="1" value="{{opts.gridSizePx}}" placeholder="{{gridSizePx}}"></div>
      <p class="hint">{{localize "ACKS-BATTLEMAP.scale.gridPxHint"}}</p>
    </div>
  </fieldset>

  <fieldset>
    <legend>{{localize "ACKS-BATTLEMAP.apply.title"}}</legend>
    <div class="acks-extras-battlemap-actions">
      <button type="button" data-action="applyGrid" {{#unless canApply}}disabled{{/unless}}>
        <i class="fa-solid fa-border-all"></i> {{localize "ACKS-BATTLEMAP.apply.grid"}}
      </button>
      <button type="button" data-action="rescaleTokens">
        <i class="fa-solid fa-maximize"></i> {{localize "ACKS-BATTLEMAP.apply.tokens"}}
      </button>
      {{#if canBake}}
        <button type="button" data-action="bake">
          <i class="fa-solid fa-wand-magic-sparkles"></i> {{localize "ACKS-BATTLEMAP.apply.bake"}}
        </button>
      {{/if}}
    </div>
    <p class="hint">{{localize "ACKS-BATTLEMAP.apply.hint"}}</p>
  </fieldset>

  <fieldset>
    <legend>{{localize "ACKS-BATTLEMAP.tokens.title"}}</legend>
    <div class="acks-extras-battlemap-chips">
      {{#each hotbar}}
        <button type="button" data-action="sizeChip" data-feet="{{value}}">{{label}}</button>
      {{/each}}
    </div>
    <div class="form-group">
      <label>{{localize "ACKS-BATTLEMAP.tokens.custom"}}</label>
      <div class="form-fields">
        <input type="number" name="customFeet" min="0" step="any" value="{{opts.customFeet}}">
        <button type="button" data-action="applyCustomSize"><i class="fa-solid fa-check"></i></button>
      </div>
    </div>
    <div class="acks-extras-battlemap-actions">
      <button type="button" data-action="resetFootprints">
        <i class="fa-solid fa-rotate-left"></i> {{localize "ACKS-BATTLEMAP.tokens.reset"}}
      </button>
    </div>
    <p class="hint">{{localize "ACKS-BATTLEMAP.tokens.hint"}}</p>
  </fieldset>

</section>
