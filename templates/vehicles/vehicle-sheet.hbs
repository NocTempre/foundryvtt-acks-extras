<section class="acks-extras-vehicle-sheet">

  {{! The number the table asks for, and what reduced it. }}
  <fieldset class="acks-extras-vehicle-speed">
    <legend>{{localize "ACKS-VEHICLES.speed.legend"}}</legend>

    {{#if isSea}}
      <div class="form-group">
        <label>{{localize "ACKS-VEHICLES.speed.wind"}}</label>
        <div class="form-fields">
          <select name="wind">
            {{#each winds}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
        </div>
      </div>

      <table class="acks-extras-vehicle-speeds">
        <tr><th>{{localize "ACKS-VEHICLES.speed.oarSprint"}}</th><td>{{speed.oarSprint}}'</td>
            <th>{{localize "ACKS-VEHICLES.speed.sail"}}</th><td>{{speed.sail}}'</td></tr>
        <tr><th>{{localize "ACKS-VEHICLES.speed.oarCruise"}}</th><td>{{speed.oarCruise}}'</td>
            <th>{{localize "ACKS-VEHICLES.speed.voyageSail"}}</th><td>{{speed.voyageSail}}</td></tr>
        <tr><th>{{localize "ACKS-VEHICLES.speed.oarSlow"}}</th><td>{{speed.oarSlow}}'</td>
            <th>{{localize "ACKS-VEHICLES.speed.voyageOar"}}</th><td>{{speed.voyageOar}}</td></tr>
      </table>

      {{#if speed.becalmed}}
        <p class="notification warning">{{localize "ACKS-VEHICLES.speed.becalmed"}}</p>
      {{/if}}
      {{#unless speed.canTack}}
        <p class="hint">{{localize "ACKS-VEHICLES.speed.noTack"}}</p>
      {{/unless}}

      {{! A ship's day is twelve hours where a marching column's is eight, so
          the hour is printed beside it — the only figure the two share. }}
      {{#if voyage}}
        <p class="acks-extras-vehicle-voyage">
          {{localize "ACKS-VEHICLES.voyage.legend"}}:
          <strong>{{voyage.milesPerDay}}</strong>
          {{localize "ACKS-VEHICLES.voyage.milesPerDay" hours=voyage.hours}}
          — {{voyage.milesPerHour}} {{localize "ACKS-VEHICLES.voyage.perHour"}}
        </p>
        <p class="hint">{{localize "ACKS-VEHICLES.voyage.dayHint"}}</p>
      {{/if}}

      {{#if hull}}
        <div class="acks-extras-vehicle-hull">
          <div class="acks-extras-vehicle-hull-bar" role="img"
               aria-label="{{hull.value}}/{{hull.max}}">
            <span style="width:{{hull.pct}}%"></span>
          </div>
          <span class="acks-extras-vehicle-hull-figure">{{hull.value}}/{{hull.max}}</span>

          {{#if hull.sinking}}
            <p class="notification error">
              {{#if hull.sinkFormula}}
                {{localize "ACKS-VEHICLES.damage.sinking" formula=hull.sinkFormula}}
              {{else}}
                {{localize "ACKS-VEHICLES.damage.sinkingUnpriced"}}
              {{/if}}
            </p>
            {{#if editable}}
            <div class="acks-extras-vehicle-sinkclock">
              {{#if sinkingClock}}
                <span class="acks-extras-vehicle-sinkclock-count">{{localize "ACKS-VEHICLES.sea.roundsLeft" rounds=sinkingClock.rounds}}</span>
                <button type="button" data-action="sinkTick" data-tooltip="{{localize 'ACKS-VEHICLES.sea.tickHint'}}">
                  <i class="fa-solid fa-hourglass-half"></i> {{localize "ACKS-VEHICLES.sea.tick"}}
                </button>
              {{else if hull.sinkFormula}}
                <button type="button" data-action="sinkStart" data-tooltip="{{localize 'ACKS-VEHICLES.sea.startClockHint'}}">
                  <i class="fa-solid fa-water"></i> {{localize "ACKS-VEHICLES.sea.startClock"}}
                </button>
              {{/if}}
            </div>
            {{/if}}
          {{else if hull.damage}}
            {{! Which of the two governs, so nobody patches a hull to fix a
                speed the missing rowers were costing all along. }}
            <p class="hint">
              {{localize hull.governsKey factor=hull.factorLabel
                         crew=hull.crewFactorLabel hull=hull.hullFactorLabel}}
            </p>
            <p class="hint">
              {{#if hull.repairMissing}}
                {{localize "ACKS-VEHICLES.damage.repairUnpriced"}}
              {{else}}
                {{localize "ACKS-VEHICLES.damage.repair"
                           repairable=hull.repairable dockOnly=hull.dockOnly
                           crew=hull.crewPerPoint hands=hull.handsAboard}}
                {{#if hull.repairTurns}}
                  {{localize "ACKS-VEHICLES.damage.repairTurns" turns=hull.repairTurns}}
                {{else}}
                  {{localize "ACKS-VEHICLES.damage.repairNoHands"}}
                {{/if}}
              {{/if}}
            </p>
          {{/if}}
        </div>
      {{/if}}
    {{else}}
      {{! Where it is today. A view choice, not a property of the wagon. }}
      <div class="form-group">
        <label>{{localize "ACKS-VEHICLES.terrain.legend"}}</label>
        <div class="form-fields">
          <select name="ground.terrain">
            {{#each terrains}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
          <label class="checkbox">
            <input type="checkbox" name="ground.road" {{checked ground.road}}> {{localize "ACKS-VEHICLES.terrain.road"}}
          </label>
          <label class="checkbox">
            <input type="checkbox" name="ground.raining" {{checked ground.raining}}> {{localize "ACKS-VEHICLES.terrain.raining"}}
          </label>
        </div>
      </div>

      <div class="form-group">
        <label>{{localize "ACKS-VEHICLES.speed.pace"}}</label>
        <div class="form-fields">
          <select name="pace">
            {{#each paces}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
        </div>
      </div>

      {{! Exploration pace, and the day's march it makes. Two scales, named,
          because quoting one where the other is meant is how a party ends up
          marching sixty miles down a corridor. }}
      <p class="acks-extras-vehicle-landspeed">
        <strong>{{speed.feetPerTurn}}'</strong> {{localize "ACKS-VEHICLES.speed.perTurn"}}
      </p>
      {{#if expedition}}
      <table class="acks-extras-vehicle-speeds">
        <tr><th>{{localize "ACKS-LIB.scale.milesPerDay"}}</th><td>{{expedition.milesPerDay}}</td>
            <th>{{localize "ACKS-VEHICLES.speed.hexesPerDay"}}</th><td>{{expedition.hexesPerDay}}</td></tr>
      </table>
      {{/if}}
      {{#if blockedByGround}}
        <p class="notification warning">{{localize "ACKS-VEHICLES.terrain.needsRoad"}}</p>
      {{/if}}
      {{#if speed.overloaded}}
        <p class="notification warning">{{localize "ACKS-VEHICLES.speed.overloaded"}}</p>
      {{/if}}
    {{/if}}

    {{! Every factor the derivation applied, named. }}
    {{#if reasons.length}}
      <ul class="acks-extras-vehicle-reasons">
        {{#each reasons}}
          <li>{{label}}{{#if factor}} <span>&times;{{factor}}</span>{{/if}}{{#if over}} <span>+{{over}} st</span>{{/if}}</li>
        {{/each}}
      </ul>
    {{/if}}
  </fieldset>

  {{! The stations: who is in what role, seat by seat. Which groups exist is a
      property of the vehicle — a wagon is pulled and driven, a ship is crewed
      — and each group is a drop target for its own seat. }}
  <fieldset class="acks-extras-vehicle-stations">
    <legend>{{localize "ACKS-VEHICLES.station.legend"}}</legend>
    {{#each stations}}
    <div class="acks-extras-vehicle-station{{#if short}} is-short{{/if}}" data-station="{{dropStation}}">
      <div class="acks-extras-vehicle-station-head">
        <span class="acks-extras-vehicle-station-label">{{label}}</span>
        <span class="acks-extras-vehicle-station-count">{{count}}</span>
        {{#if effectiveNote}}<span class="hint">{{effectiveNote}}</span>{{/if}}
      </div>
      <div class="acks-extras-vehicle-station-cells">
        {{#each named}}
          {{> "modules/acks-extras/templates/lib/station-chip.hbs"}}
        {{/each}}
        {{#if stepperName}}
          <span class="acks-extras-vehicle-station-unnamed">
            <input type="number" name="{{stepperName}}" min="0" step="1" value="{{unnamed}}"
                   {{#unless @root.editable}}disabled{{/unless}}>
            <span class="hint">{{localize "ACKS-VEHICLES.station.unnamed"}}</span>
          </span>
        {{else if unnamedNote}}
          <span class="acks-extras-vehicle-station-unnamed"><span class="hint">{{unnamed}} {{unnamedNote}}</span></span>
        {{/if}}
        {{#each empties}}
          <span class="acks-extras-vehicle-station-empty"
                data-tooltip="{{localize 'ACKS-VEHICLES.station.emptySeat'}}">+</span>
        {{/each}}
      </div>
      {{#if consequence}}<p class="acks-extras-vehicle-station-note">{{consequence}}</p>{{/if}}
    </div>
    {{/each}}
  </fieldset>

  {{! The hold. }}
  <fieldset>
    <legend>{{localize "ACKS-VEHICLES.cargo.legend"}}</legend>
    <div class="acks-extras-vehicle-hold{{#if hold.over}} is-over{{/if}}" data-accept-drop>
      <div class="acks-extras-vehicle-bar"><span style="width:{{hold.pct}}%"></span></div>
      <p>{{hold.aboardStone}} / {{hold.capacity}} {{localize "ACKS-VEHICLES.cargo.stone"}}
         {{#if hold.passengerStone}}<span class="hint">({{hold.passengerStone}} {{localize "ACKS-VEHICLES.cargo.asPassengers"}})</span>{{/if}}
         {{#if hold.marineGear}}<span class="hint">({{hold.marineGear}} {{localize "ACKS-VEHICLES.cargo.marineGear"}})</span>{{/if}}</p>
      {{#if hold.trade}}
        <p class="hint acks-extras-vehicle-trade">
          {{#if hold.trade.missing}}
            {{localize "ACKS-VEHICLES.cargo.tradeUnpriced" hands=hold.trade.hands}}
          {{else}}
            {{localize "ACKS-VEHICLES.cargo.trade" hands=hold.trade.hands stone=hold.trade.stone}}
          {{/if}}
        </p>
      {{/if}}
    </div>
    <div class="form-group">
      <label>{{localize "ACKS-VEHICLES.cargo.capacity"}}</label>
      <div class="form-fields"><input type="number" name="system.cargo.capacityStone" min="0" value="{{system.cargo.capacityStone}}"></div>
    </div>
    {{! Actor-shaped freight — a boat on the wagon. Full mass, no berth.
        Named passengers live in the Stations panel above. }}
    {{#if cargoRiders.length}}
      <ol class="acks-extras-vehicle-riders">
        {{#each cargoRiders}}
          <li><span>{{name}}</span> <span class="hint">{{localize "ACKS-VEHICLES.cargo.asCargo"}}</span>
            <span class="acks-extras-vehicle-pull">{{stone}} st</span>
            {{#if @root.editable}}<a data-action="disembark" data-uuid="{{uuid}}"
              data-tooltip="{{localize 'ACKS-VEHICLES.cargo.unload'}}"><i class="fa-solid fa-person-walking-arrow-right"></i></a>{{/if}}
          </li>
        {{/each}}
      </ol>
    {{/if}}
    {{! The freight itself. Its weight is already in the bar above. }}
    <ol class="acks-extras-vehicle-cargo" data-accept-drop>
      {{#each cargo}}
        <li data-item-id="{{id}}">
          <img src="{{img}}" alt="" width="24" height="24">
          <a class="acks-extras-vehicle-cargo-name" data-action="openCargo" data-item-id="{{id}}">{{name}}</a>
          {{#if stacks}}
            <input class="acks-extras-vehicle-cargo-qty" type="number" min="0" step="1"
                   data-cargo-qty data-item-id="{{id}}" value="{{qty}}"
                   data-tooltip="{{localize 'ACKS-VEHICLES.cargo.qty'}}"
                   {{#unless @root.editable}}disabled{{/unless}}>
          {{/if}}
          <span class="acks-extras-vehicle-pull">{{stone}} st</span>
          {{#if @root.editable}}
            <a data-action="unloadCargo" data-item-id="{{id}}"
               data-tooltip="{{localize 'ACKS-VEHICLES.cargo.unload'}}"><i class="fa-solid fa-trash"></i></a>
          {{/if}}
        </li>
      {{/each}}
    </ol>
    <p class="hint">{{localize "ACKS-VEHICLES.cargo.freightHint"}}</p>
    <p class="hint">{{localize "ACKS-VEHICLES.cargo.boardHint"}}</p>
    {{#if isLand}}{{#if editable}}
    <div class="acks-extras-vehicle-boarding">
      <button type="button" data-action="boardBest" data-tooltip="{{localize 'ACKS-VEHICLES.board.maxSpeedHint'}}">
        <i class="fa-solid fa-users-line"></i> {{localize "ACKS-VEHICLES.board.maxSpeed"}}
      </button>
      <button type="button" data-action="reboard" data-tooltip="{{localize 'ACKS-VEHICLES.board.reboardHint'}}">
        <i class="fa-solid fa-rotate-left"></i> {{localize "ACKS-VEHICLES.board.reboard"}}
      </button>
    </div>
    {{/if}}{{/if}}

  </fieldset>

  {{#if isSea}}
  {{! Who is aboard. A short motive role is what slows the vessel. }}
  <fieldset>
    <legend>{{localize "ACKS-VEHICLES.crew.legend"}}
      {{#if editable}}<a data-action="addRole"><i class="fa-solid fa-plus"></i></a>{{/if}}</legend>
    {{! Who is ABOARD each role lives in the Stations panel (the unnamed
        stepper writes the same field); this table states the complement. }}
    <table class="acks-extras-vehicle-crew">
      <tr><th>{{localize "ACKS-VEHICLES.crew.role"}}</th>
          <th>{{localize "ACKS-VEHICLES.crew.required"}}</th><th>{{localize "ACKS-VEHICLES.crew.motive"}}</th>
          <th data-tooltip="{{localize 'ACKS-VEHICLES.crew.gearStoneHint'}}">{{localize "ACKS-VEHICLES.crew.gearStone"}}</th><th></th></tr>
      {{#each roles}}
      <tr class="{{#if short}}is-short{{/if}}">
        <td><input type="text" name="system.crew.roles.{{index}}.label" value="{{label}}"></td>
        <td><input type="number" name="system.crew.roles.{{index}}.required" min="0" value="{{required}}"></td>
        <td><input type="checkbox" name="system.crew.roles.{{index}}.motive" {{checked motive}}></td>
        <td>{{#unless motive}}<input type="number" name="system.crew.roles.{{index}}.gearStone" min="0" step="any" value="{{gearStone}}" placeholder="—">{{/unless}}</td>
        <td>{{#if @root.editable}}<a data-action="removeRole" data-index="{{index}}"><i class="fa-solid fa-trash"></i></a>{{/if}}</td>
      </tr>
      {{/each}}
    </table>
    <p class="hint">{{localize "ACKS-VEHICLES.crew.hint"}}</p>
  </fieldset>

  {{! Seamanship: the day's throws, decomposed before they are rolled. }}
  {{#if editable}}
  <fieldset class="acks-extras-vehicle-seamanship">
    <legend>{{localize "ACKS-VEHICLES.sea.legend"}}</legend>
    <button type="button" data-action="seaNavigation" data-tooltip="{{localize 'ACKS-VEHICLES.sea.navigationHint'}}">
      <i class="fa-solid fa-compass"></i> {{localize "ACKS-VEHICLES.sea.navigationTitle"}}
    </button>
    <button type="button" data-action="seaHazard" data-tooltip="{{localize 'ACKS-VEHICLES.sea.hazardHint'}}">
      <i class="fa-solid fa-water"></i> {{localize "ACKS-VEHICLES.sea.hazardTitle"}}
    </button>
  </fieldset>
  {{/if}}
  {{/if}}

  {{#if isLand}}
  {{! What is in harness. Drop an animal here to hitch it. }}
  <fieldset class="acks-extras-vehicle-team" data-accept-drop>
    <legend>{{localize "ACKS-VEHICLES.team.legend"}} ({{pull}})</legend>
    {{#if underTeamed}}
      <p class="notification warning">{{localize "ACKS-VEHICLES.team.under"}}</p>
    {{/if}}
    {{! Real animals in harness are chips in the Stations panel; the rows here
        are the ABSTRACT complement a Judge states by hand. }}
    <ol class="acks-extras-vehicle-animals">
      {{#each animals}}
        <li class="{{#unless pulling}}is-idle{{/unless}}">
          <input class="acks-extras-vehicle-animal-count" type="number" min="1" step="1"
                 name="system.team.animals.{{index}}.count" value="{{count}}"
                 data-tooltip="{{localize 'ACKS-VEHICLES.team.count'}}">
          <span class="acks-extras-vehicle-animal-name">{{name}}</span>
          <select name="system.team.animals.{{index}}.kind">
            {{#each @root.draftKinds}}<option value="{{value}}" {{#if (eq value ../kind)}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
          <span class="acks-extras-vehicle-pull">{{#if pull}}{{pull}}{{else}}&mdash;{{/if}}</span>
          {{#if @root.editable}}
            <a data-action="togglePulling" data-index="{{index}}"
               data-tooltip="{{localize 'ACKS-VEHICLES.team.togglePulling'}}"><i class="fa-solid {{#if pulling}}fa-link{{else}}fa-link-slash{{/if}}"></i></a>
            <a data-action="removeAnimal" data-index="{{index}}"><i class="fa-solid fa-trash"></i></a>
          {{/if}}
        </li>
      {{/each}}
    </ol>
    {{#if draftUnpriced}}
      <p class="hint acks-extras-vehicle-team-unpriced">
        {{localize "ACKS-VEHICLES.team.unpriced" kinds=draftUnpriced}}
      </p>
    {{/if}}
    <p class="hint">{{localize "ACKS-VEHICLES.team.dropHint"}}</p>
  </fieldset>

  {{! The printed load/speed rows. }}
  <fieldset>
    <legend>{{localize "ACKS-VEHICLES.tiers.legend"}}
      {{#if editable}}<a data-action="addTier"><i class="fa-solid fa-plus"></i></a>{{/if}}</legend>
    <table class="acks-extras-vehicle-tiers">
      <tr><th>{{localize "ACKS-VEHICLES.tiers.team"}}</th><th>{{localize "ACKS-VEHICLES.tiers.upTo"}}</th>
          <th>{{localize "ACKS-VEHICLES.tiers.at"}}</th><th></th></tr>
      {{#each tiers}}
      <tr>
        <td><input type="number" name="system.speeds.tiers.{{index}}.team" step="0.5" min="0" value="{{team}}"></td>
        <td><input type="number" name="system.speeds.tiers.{{index}}.maxLoadStone" min="0" value="{{maxLoadStone}}"></td>
        <td><input type="number" name="system.speeds.tiers.{{index}}.feetPerTurn" min="0" step="5" value="{{feetPerTurn}}"></td>
        <td>{{#if @root.editable}}<a data-action="removeTier" data-index="{{index}}"><i class="fa-solid fa-trash"></i></a>{{/if}}</td>
      </tr>
      {{/each}}
    </table>
    <p class="hint">{{localize "ACKS-VEHICLES.tiers.hint"}}</p>
  </fieldset>
  {{/if}}

  {{! The rest: what it is, what it can take, and how the crew is faring. }}
  <fieldset>
    <legend>{{localize "ACKS-VEHICLES.vessel.legend"}}</legend>
    <div class="form-group">
      <label>{{localize "ACKS-VEHICLES.vessel.kind"}}</label>
      <div class="form-fields">
        <select name="system.kind">
          {{#each kinds}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
        </select>
      </div>
    </div>
    <div class="form-group">
      <label>{{localize "ACKS-VEHICLES.means.label"}}</label>
      <div class="form-fields">
        <select name="system.crew.means">
          <option value="" {{#unless system.crew.means}}selected{{/unless}}>{{meansAuto}}</option>
          {{#each meansOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
        </select>
      </div>
      <p class="hint">{{localize "ACKS-VEHICLES.means.hint"}}</p>
    </div>
    <div class="form-group">
      <label>{{localize "ACKS-VEHICLES.vessel.shp"}}</label>
      <div class="form-fields">
        <input type="number" name="system.shp.value" value="{{system.shp.value}}"> /
        <input type="number" name="system.shp.max" value="{{system.shp.max}}">
      </div>
    </div>
    <div class="form-group">
      <label>{{localize "ACKS-VEHICLES.vessel.ac"}}</label>
      <div class="form-fields"><input type="number" name="system.ac" value="{{system.ac}}"></div>
    </div>
    {{#if isSea}}
    <div class="form-group">
      <label>{{localize "ACKS-VEHICLES.vessel.mastStowed"}}</label>
      <div class="form-fields"><input type="checkbox" name="system.mastStowed" {{checked system.mastStowed}}></div>
      <p class="hint">{{localize "ACKS-VEHICLES.vessel.mastHint"}}</p>
    </div>
    {{/if}}
    {{#if isLand}}
    <div class="form-group">
      <label>{{localize "ACKS-VEHICLES.carriage.label"}}</label>
      <div class="form-fields">
        <select name="system.carriage">
          {{#each carriages}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
        </select>
      </div>
      <p class="hint">{{localize "ACKS-VEHICLES.carriage.hint"}}</p>
    </div>
    <div class="form-group">
      <label>{{localize "ACKS-VEHICLES.vessel.driving"}}</label>
      <div class="form-fields"><input type="checkbox" name="system.driverProficient" {{checked system.driverProficient}}></div>
      <p class="hint">{{localize "ACKS-VEHICLES.vessel.drivingHint"}}</p>
      {{#if skills.driving}}<p class="hint">{{skills.driving}}</p>{{/if}}
    </div>
    {{else}}
    <div class="form-group">
      <label>{{localize "ACKS-VEHICLES.vessel.seafaring"}}</label>
      <div class="form-fields">
        <input type="number" name="system.seafaringRank" min="0" max="3" value="{{system.seafaringRank}}">
      </div>
      <p class="hint">{{localize "ACKS-VEHICLES.vessel.seafaringHint"}}</p>
      {{#if skills.seafaring}}<p class="hint">{{skills.seafaring}}</p>{{/if}}
      {{#if skills.charts}}<p class="hint">{{skills.charts}}</p>{{/if}}
    </div>
    {{#if speed.tackSpeed}}
      <p class="hint">{{localize "ACKS-VEHICLES.speed.masterTack"}} <strong>{{speed.tackSpeed}}'</strong></p>
    {{/if}}
    {{/if}}

    <div class="form-group">
      <label>{{localize "ACKS-VEHICLES.vessel.underfed"}}</label>
      <div class="form-fields"><input type="checkbox" name="system.condition.underfed" {{checked system.condition.underfed}}></div>
    </div>
    <div class="form-group">
      <label>{{localize "ACKS-VEHICLES.vessel.starving"}}</label>
      <div class="form-fields"><input type="checkbox" name="system.condition.starving" {{checked system.condition.starving}}></div>
      <p class="hint">{{localize "ACKS-VEHICLES.vessel.hungerHint"}}</p>
    </div>
  </fieldset>

</section>
