<section class="tab acks-extras-vehicle-tab {{tab.cssClass}}" data-tab="travel" data-group="primary">

  {{! The number the table asks for, and what reduced it. }}
  <fieldset class="acks-extras-vehicle-speed">
    <legend>{{localize "ACKS-VEHICLES.speed.legend"}}</legend>

    {{#if isSea}}
      <div class="form-group">
        <label>{{localize "ACKS-VEHICLES.speed.wind"}}</label>
        <div class="form-fields">
          <select name="wind">
            {{#each winds}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
        </div>
      </div>

      <table class="acks-extras-vehicle-speeds">
        <tr><th>{{localize "ACKS-VEHICLES.speed.oarSprint"}}</th><td>{{speed.oarSprint}}'</td>
            <th>{{localize "ACKS-VEHICLES.speed.sail"}}</th><td>{{speed.sail}}'</td></tr>
        <tr><th>{{localize "ACKS-VEHICLES.speed.oarCruise"}}</th><td>{{speed.oarCruise}}'</td>
            <th>{{localize "ACKS-VEHICLES.speed.voyageSail"}}</th><td>{{speed.voyageSail}}</td></tr>
        <tr><th>{{localize "ACKS-VEHICLES.speed.oarSlow"}}</th><td>{{speed.oarSlow}}'</td>
            <th>{{localize "ACKS-VEHICLES.speed.voyageOar"}}</th><td>{{speed.voyageOar}}</td></tr>
      </table>

      {{#if speed.becalmed}}
        <p class="notification warning">{{localize "ACKS-VEHICLES.speed.becalmed"}}</p>
      {{/if}}
      {{#unless speed.canTack}}
        <p class="hint">{{localize "ACKS-VEHICLES.speed.noTack"}}</p>
      {{/unless}}
      {{#if speed.tackSpeed}}
        <p class="hint">{{localize "ACKS-VEHICLES.speed.masterTack"}} <strong>{{speed.tackSpeed}}'</strong></p>
      {{/if}}

      {{! A ship's day and a marching column's run on different clocks, so the
          hour is printed beside it — the only figure the two share. }}
      {{#if voyage}}
        <p class="acks-extras-vehicle-voyage">
          {{localize "ACKS-VEHICLES.voyage.legend"}}:
          <strong>{{voyage.milesPerDay}}</strong>
          {{localize "ACKS-VEHICLES.voyage.milesPerDay" hours=voyage.hours}}
          — {{voyage.milesPerHour}} {{localize "ACKS-VEHICLES.voyage.perHour"}}
        </p>
        <p class="hint">{{localize "ACKS-VEHICLES.voyage.dayHint"}}</p>
      {{/if}}
    {{else}}
      {{! Where it is today. A view choice, not a property of the wagon. }}
      <div class="form-group">
        <label>{{localize "ACKS-VEHICLES.terrain.legend"}}</label>
        <div class="form-fields">
          <select name="ground.terrain">
            {{#each terrains}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
          <label class="checkbox">
            <input type="checkbox" name="ground.road" {{checked ground.road}}> {{localize "ACKS-VEHICLES.terrain.road"}}
          </label>
          <label class="checkbox">
            <input type="checkbox" name="ground.raining" {{checked ground.raining}}> {{localize "ACKS-VEHICLES.terrain.raining"}}
          </label>
        </div>
      </div>

      <div class="form-group">
        <label>{{localize "ACKS-VEHICLES.speed.pace"}}</label>
        <div class="form-fields">
          <select name="pace">
            {{#each paces}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
        </div>
      </div>

      {{! Exploration pace, and the day's march it makes. Two scales, named,
          because quoting one where the other is meant is how a party ends up
          marching sixty miles down a corridor. }}
      <p class="acks-extras-vehicle-landspeed">
        <strong>{{speed.feetPerTurn}}'</strong> {{localize "ACKS-VEHICLES.speed.perTurn"}}
      </p>
      {{#if expedition}}
      <table class="acks-extras-vehicle-speeds">
        <tr><th>{{localize "ACKS-LIB.scale.milesPerDay"}}</th><td>{{expedition.milesPerDay}}</td>
            <th>{{localize "ACKS-VEHICLES.speed.hexesPerDay"}}</th><td>{{expedition.hexesPerDay}}</td></tr>
      </table>
      {{/if}}
      {{#if blockedByGround}}
        <p class="notification warning">{{localize "ACKS-VEHICLES.terrain.needsRoad"}}</p>
      {{/if}}
      {{#if speed.overloaded}}
        <p class="notification warning">{{localize "ACKS-VEHICLES.speed.overloaded"}}</p>
      {{/if}}
    {{/if}}

    {{! Every factor the derivation applied, named. }}
    {{#if reasons.length}}
      <ul class="acks-extras-vehicle-reasons">
        {{#each reasons}}
          <li>{{label}}{{#if factor}} <span>&times;{{factor}}</span>{{/if}}{{#if over}} <span>+{{over}} st</span>{{/if}}</li>
        {{/each}}
      </ul>
    {{/if}}
  </fieldset>

  {{! What the crew is suffering and how she is rigged — the switches the
      speed above answers to. }}
  <fieldset class="acks-extras-vehicle-conditions">
    <legend>{{localize "ACKS-VEHICLES.conditions.legend"}}</legend>
    {{#if isSea}}
    <div class="form-group">
      <label>{{localize "ACKS-VEHICLES.vessel.mastStowed"}}</label>
      <div class="form-fields"><input type="checkbox" name="system.mastStowed" {{checked system.mastStowed}}></div>
      <p class="hint">{{localize "ACKS-VEHICLES.vessel.mastHint"}}</p>
    </div>
    {{/if}}
    <div class="form-group">
      <label>{{localize "ACKS-VEHICLES.vessel.underfed"}}</label>
      <div class="form-fields"><input type="checkbox" name="system.condition.underfed" {{checked system.condition.underfed}}></div>
    </div>
    <div class="form-group">
      <label>{{localize "ACKS-VEHICLES.vessel.starving"}}</label>
      <div class="form-fields"><input type="checkbox" name="system.condition.starving" {{checked system.condition.starving}}></div>
      <p class="hint">{{localize "ACKS-VEHICLES.vessel.hungerHint"}}</p>
    </div>
  </fieldset>

  {{#if hull}}
  <fieldset class="acks-extras-vehicle-hull">
    <legend>{{localize "ACKS-VEHICLES.damage.legend"}}</legend>
    <div class="acks-extras-vehicle-hull-row">
      <div class="acks-extras-vehicle-hull-bar" role="img" aria-label="{{hull.value}}/{{hull.max}}">
        <span style="width:{{hull.pct}}%"></span>
      </div>
      <span class="acks-extras-vehicle-hull-figure">{{hull.value}}/{{hull.max}}</span>
    </div>

    {{#if hull.sinking}}
      <p class="notification error">
        {{#if hull.sinkFormula}}
          {{localize "ACKS-VEHICLES.damage.sinking" formula=hull.sinkFormula}}
        {{else}}
          {{localize "ACKS-VEHICLES.damage.sinkingUnpriced"}}
        {{/if}}
      </p>
      {{#if editable}}
      <div class="acks-extras-vehicle-sinkclock">
        {{#if sinkingClock}}
          <span class="acks-extras-vehicle-sinkclock-count">{{localize "ACKS-VEHICLES.sea.roundsLeft" rounds=sinkingClock.rounds}}</span>
          <button type="button" data-action="sinkTick" data-tooltip="{{localize 'ACKS-VEHICLES.sea.tickHint'}}">
            <i class="fa-solid fa-hourglass-half" inert></i> {{localize "ACKS-VEHICLES.sea.tick"}}
          </button>
        {{else if hull.sinkFormula}}
          <button type="button" data-action="sinkStart" data-tooltip="{{localize 'ACKS-VEHICLES.sea.startClockHint'}}">
            <i class="fa-solid fa-water" inert></i> {{localize "ACKS-VEHICLES.sea.startClock"}}
          </button>
        {{/if}}
      </div>
      {{/if}}
    {{else if hull.damage}}
      {{! Which of the two governs, so nobody patches a hull to fix a
          speed the missing rowers were costing all along. }}
      <p class="hint">
        {{localize hull.governsKey factor=hull.factorLabel
                   crew=hull.crewFactorLabel hull=hull.hullFactorLabel}}
      </p>
      <p class="hint">
        {{#if hull.repairMissing}}
          {{localize "ACKS-VEHICLES.damage.repairUnpriced"}}
        {{else}}
          {{localize "ACKS-VEHICLES.damage.repair"
                     repairable=hull.repairable dockOnly=hull.dockOnly
                     crew=hull.crewPerPoint hands=hull.handsAboard}}
          {{#if hull.repairTurns}}
            {{localize "ACKS-VEHICLES.damage.repairTurns" turns=hull.repairTurns}}
          {{else}}
            {{localize "ACKS-VEHICLES.damage.repairNoHands"}}
          {{/if}}
        {{/if}}
      </p>
    {{/if}}
  </fieldset>
  {{/if}}

  {{! Seamanship: the day's throws, decomposed before they are rolled. }}
  {{#if isSea}}{{#if editable}}
  <fieldset class="acks-extras-vehicle-seamanship">
    <legend>{{localize "ACKS-VEHICLES.sea.legend"}}</legend>
    <button type="button" data-action="seaNavigation" data-tooltip="{{localize 'ACKS-VEHICLES.sea.navigationHint'}}">
      <i class="fa-solid fa-compass" inert></i> {{localize "ACKS-VEHICLES.sea.navigationTitle"}}
    </button>
    <button type="button" data-action="seaHazard" data-tooltip="{{localize 'ACKS-VEHICLES.sea.hazardHint'}}">
      <i class="fa-solid fa-water" inert></i> {{localize "ACKS-VEHICLES.sea.hazardTitle"}}
    </button>
  </fieldset>
  {{/if}}{{/if}}
</section>
