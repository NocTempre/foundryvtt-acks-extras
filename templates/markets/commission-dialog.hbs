<div class="acks-extras-markets-dialog-body">
  <div class="acks-extras-markets-itemline">
    <img src="{{item.img}}" width="28" height="28" alt="">
    <strong>{{item.name}}</strong>
    <span>{{item.costGp}}gp</span>
  </div>

  {{#unless noRates}}
  <div class="form-group">
    <label>{{localize "ACKS-MARKETS.purchase.buyer"}}</label>
    <select name="buyerUuid">
      {{#each buyers}}
      <option value="{{id}}">{{name}}</option>
      {{/each}}
    </select>
  </div>

  <div class="form-group">
    <label>{{localize "ACKS-MARKETS.purchase.qty"}}</label>
    <input type="number" name="qty" value="1" min="1" step="1">
  </div>

  <div class="form-group">
    <label>{{localize "ACKS-MARKETS.commissions.workerLabel"}}</label>
    <select name="worker">
      {{#each workers}}
      <option value="{{id}}">{{label}}{{#if planLine}} — {{planLine}}{{/if}}</option>
      {{/each}}
    </select>
  </div>
  <p class="hint">{{localize "ACKS-MARKETS.commissions.hint"}}</p>

  <footer class="form-footer">
    <button type="submit"><i class="fas fa-hammer"></i> {{localize "ACKS-MARKETS.commissions.submit"}}</button>
  </footer>
  {{/unless}}
</div>
