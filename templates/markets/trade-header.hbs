{{#if tradeClass}}
<p class="hint acks-extras-markets-class">
  {{localize "ACKS-MARKETS.trade.marketClass"}}: {{tradeClass.trueLabel}}{{#if tradeClass.shifted}} · {{localize "ACKS-MARKETS.trade.classFor" name=tradeClass.traderName}}: <strong>{{tradeClass.effectiveLabel}}</strong>{{/if}}{{#if tradeClass.network}}{{#unless tradeClass.known}} · {{localize "ACKS-MARKETS.trade.networkUnknown"}}{{/unless}}{{/if}}
  {{#if isGM}}{{#if tradeClass.network}}
  <button type="button" class="acks-location-btn {{#if tradeClass.judgeListed}}active{{/if}}" data-action="toggleKnownMarket"
          data-tooltip="{{localize 'ACKS-MARKETS.trade.knownMarketHint'}}">
    <i class="fas fa-map-pin"></i> {{localize "ACKS-MARKETS.trade.knownMarket"}}:
    {{#if tradeClass.judgeListed}}{{localize "ACKS-MARKETS.on"}}{{else}}{{localize "ACKS-MARKETS.off"}}{{/if}}
  </button>
  {{/if}}{{/if}}
</p>
{{/if}}

{{#if demandRows.length}}
<div class="acks-extras-markets-demand">
  <strong>{{localize "ACKS-MARKETS.trade.demandHeader"}}:</strong>
  {{#each demandRows}}<span class="acks-extras-markets-demand-chip {{#if pinned}}pinned{{/if}}">{{label}} {{modifier}}{{#if pinned}} <i class="fas fa-thumbtack" aria-hidden="true"></i> {{localize "ACKS-MARKETS.trade.pinned"}}{{#if baseNote}} ({{baseNote}}){{/if}}{{/if}}</span>{{/each}}
</div>
{{/if}}
