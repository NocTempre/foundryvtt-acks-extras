<div class="location-sheet-body">
  <header class="location-header">
    <img class="profile" src="{{actor.img}}" data-action="editImage" data-edit="img" alt="{{actor.name}}" />
    <div class="header-fields">
      {{#if breadcrumb.length}}
      <nav class="acks-extras-place-crumbs" aria-label="{{localize 'ACKS-LOCATION.place.breadcrumb'}}">
        {{#each breadcrumb}}<a data-action="openPlace" data-place-uuid="{{this.uuid}}">{{this.name}}</a><i class="fas fa-angle-right"></i>{{/each}}
      </nav>
      {{/if}}
      <input class="location-name" name="name" type="text" value="{{actor.name}}" placeholder="{{localize 'ACKS-HENCHMEN.location.name'}}" />
      <div class="market-class-line">
        {{#if isStacked}}
        <span class="acks-tag acks-extras-place-stack" data-tooltip="{{localize 'ACKS-LOCATION.place.stackHint'}}">
          <i class="fas fa-layer-group"></i> ×{{stackCount}}
        </span>
        {{/if}}
        {{#if scene}}
        <a class="acks-tag acks-extras-place-scene{{#if scene.active}} is-active{{/if}}" data-action="openScene" data-tooltip="{{localize 'ACKS-LOCATION.place.openSceneHint'}}">
          <i class="fas fa-map"></i> {{scene.name}}
        </a>
        {{/if}}
        {{#if hasMarket}}
        <span class="market-class-badge acks-tag" data-tooltip="{{marketClassSource}}">
          {{localize "ACKS-HENCHMEN.location.marketClass"}}: <strong>{{marketClassRoman}}</strong>
        </span>
        {{/if}}
        {{#if searchFeeFormula}}
        <span class="market-class-badge acks-tag" data-tooltip="{{localize 'ACKS-HENCHMEN.location.searchFeeHint'}}">
          {{localize "ACKS-HENCHMEN.location.searchFee"}}: <strong>{{searchFeeFormula}}</strong> gp/{{localize "ACKS-HENCHMEN.location.perWeek"}}
        </span>
        {{/if}}
        {{#if marketWeek}}
        <span class="market-class-badge acks-tag" data-tooltip="{{localize 'ACKS-HENCHMEN.location.marketWeekHint'}}">
          {{localize "ACKS-HENCHMEN.location.marketWeek"}} <strong>{{marketWeek}}</strong>{{#if nextRollDays}} · {{localize "ACKS-HENCHMEN.location.nextRoll"}} {{nextRollDays}}d{{/if}}
        </span>
        {{/if}}
        {{#if hasMarket}}
          {{#if canProcess}}
          <button type="button" class="acks-btn acks-btn--secondary acks-btn--sm" data-action="processNow" data-tooltip="{{localize 'ACKS-HENCHMEN.location.processNowHint'}}">
            <i class="fas fa-rotate"></i> {{localize "ACKS-HENCHMEN.location.processNow"}}
          </button>
          <button type="button" class="acks-btn acks-btn--secondary acks-btn--sm" data-action="reloadMarket" data-tooltip="{{localize 'ACKS-HENCHMEN.location.reloadHint'}}">
            <i class="fas fa-arrows-rotate"></i> {{localize "ACKS-HENCHMEN.location.reload"}}
          </button>
          {{/if}}
          {{#if isGM}}
          <button type="button" class="acks-btn acks-btn--secondary acks-btn--sm" data-action="advanceWeek" data-tooltip="{{localize 'ACKS-HENCHMEN.location.advanceWeekHint'}}">
            <i class="fas fa-forward"></i> {{localize "ACKS-HENCHMEN.location.advanceWeek"}}
          </button>
          {{/if}}
        {{else if isGM}}
        <button type="button" class="acks-btn acks-btn--secondary acks-btn--sm" data-action="addMarket" data-tooltip="{{localize 'ACKS-LOCATION.place.addMarketHint'}}">
          <i class="fas fa-store"></i> {{localize "ACKS-LOCATION.place.addMarket"}}
        </button>
        {{/if}}
      </div>
    </div>
  </header>

  <nav class="tabs sheet-tabs" data-group="primary">
    {{#each tabs}}
    <a class="{{this.cssClass}}" data-action="tab" data-group="primary" data-tab="{{this.id}}"><i class="{{this.icon}}"></i> {{this.label}}</a>
    {{/each}}
  </nav>

  {{!-- --------------------------- Contents --------------------------- --}}
  {{!-- What this place is inside of, what places are inside it, and who is
        here. Every place has this tab; the market tabs below are the opt-in
        specialisation. --}}
  <section class="tab location-tab {{tabs.contents.cssClass}}" data-group="primary" data-tab="contents">

    <div class="acks-extras-place-idline">
      <label>
        {{localize "ACKS-HENCHMEN.location.region"}}
        <input type="text" name="system.region" value="{{system.region}}" />
      </label>
      {{#if coinRollupGC}}
      <span class="acks-tag" data-tooltip="{{localize 'ACKS-LOCATION.place.coinRollupHint'}}">
        <i class="fas fa-coins"></i> {{coinRollupGC}} gp
      </span>
      {{/if}}
      {{#if headcount}}
      <span class="acks-tag" data-tooltip="{{localize 'ACKS-LOCATION.place.headcountHint'}}">
        <i class="fas fa-users"></i> {{headcount}}
      </span>
      {{/if}}
    </div>

    {{!-- ---- Places inside this one, and the goods kept here ---- --}}
    <details class="section" open>
      <summary>
        {{localize "ACKS-LOCATION.place.contents"}} ({{contentRows.length}})
        {{#if isGM}}
        <button type="button" class="inline-add" data-action="addChildPlace">
          <i class="fas fa-plus"></i> {{localize "ACKS-LOCATION.place.addChild"}}
        </button>
        {{/if}}
      </summary>
      {{#if contentRows.length}}
      <ul class="acks-extras-place-list">
        {{#each contentRows}}
        <li class="acks-extras-place-row{{#if this.isPlace}} is-place{{/if}}" data-place-uuid="{{this.uuid}}">
          <i class="fas {{this.icon}}"></i>
          {{#if this.img}}<img src="{{this.img}}" alt="" />{{/if}}
          {{#if this.isPlace}}
          <a data-action="openPlace" class="acks-extras-place-name">{{this.name}}</a>
          {{#if this.stacked}}<span class="acks-tag">×{{this.count}}</span>{{/if}}
          {{else}}
          <span class="acks-extras-place-name">{{this.name}}</span>
          {{#if this.ownerName}}<span class="acks-extras-place-owner">{{this.ownerName}}</span>{{/if}}
          {{/if}}
          {{#if @root.isGM}}{{#if this.isPlace}}
          <a class="acks-extras-place-detach" data-action="detachPlace" data-tooltip="{{localize 'ACKS-LOCATION.place.detachHint'}}">
            <i class="fas fa-link-slash"></i>
          </a>
          {{/if}}{{/if}}
        </li>
        {{/each}}
      </ul>
      {{else}}
      <p class="acks-empty">{{localize "ACKS-LOCATION.place.contentsEmpty"}}</p>
      {{/if}}
    </details>

    {{!-- ---- Who is here ---- --}}
    <details class="section" open>
      <summary>
        {{localize "ACKS-LOCATION.place.occupants"}} ({{occupants.length}})
        <span class="acks-extras-place-hint">{{localize "ACKS-LOCATION.place.dropHint"}}</span>
      </summary>
      {{#if occupants.length}}
      <table class="acks-table acks-extras-occupant-table">
        <tbody>
          {{#each occupants}}
          <tr data-occupant-uuid="{{this.uuid}}" class="{{#if this.derived}}is-derived{{/if}}{{#if this.missing}} is-missing{{/if}}">
            <td class="portrait">{{#if this.img}}<img src="{{this.img}}" alt="" />{{/if}}</td>
            <td>
              <a data-action="openPlace" data-place-uuid="{{this.uuid}}">{{this.name}}</a>
              {{#if this.missing}}<i class="fas fa-triangle-exclamation" data-tooltip="{{localize 'ACKS-LOCATION.place.occupantMissing'}}"></i>{{/if}}
            </td>
            <td>{{this.kindLabel}}</td>
            <td>{{#if this.quantity}}{{#unless (eq this.quantity 1)}}×{{this.quantity}}{{/unless}}{{/if}}</td>
            <td class="row-actions">
              {{#if this.derived}}
              <a data-action="keepOccupant" data-tooltip="{{localize 'ACKS-LOCATION.place.keepHint'}}"><i class="fas fa-thumbtack"></i></a>
              {{else}}
                {{#if @root.isGM}}
                <a data-action="toggleOccupantHidden" data-tooltip="{{localize 'ACKS-LOCATION.place.hideHint'}}">
                  <i class="fas {{#if this.hidden}}fa-eye-slash{{else}}fa-eye{{/if}}"></i>
                </a>
                {{/if}}
              <a data-action="removeOccupant" data-tooltip="{{localize 'ACKS-LOCATION.place.removeOccupantHint'}}"><i class="fas fa-xmark"></i></a>
              {{/if}}
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
      {{else}}
      <p class="acks-empty">{{localize "ACKS-LOCATION.place.occupantsEmpty"}}</p>
      {{/if}}
    </details>

    {{!-- ---- Notes ---- --}}
    <details class="section">
      <summary>{{localize "ACKS-LOCATION.place.notes"}}</summary>
      {{#if isGM}}
      {{!-- The sheet's ONLY editable render of system.notes: a second control of
            the same name in this one form is last-write-wins. `toggled` holds
            the change event back until save, so form.submitOnChange writes once
            per save rather than once per keystroke, and the enriched HTML is
            what shows while the editor is closed. `content-sized` returns the
            editor content to flow (core lays it out absolutely, contributing no
            height); `--min-height` keeps the edit affordance reachable when the
            notes are empty. --}}
      <prose-mirror class="acks-extras-place-notes content-sized" name="system.notes" value="{{system.notes}}" toggled
                    data-document-uuid="{{actor.uuid}}" style="--min-height: 6rem;">{{{notesHTML}}}</prose-mirror>
      {{else}}
      <div class="acks-extras-place-notes">{{{notesHTML}}}</div>
      {{/if}}
    </details>
  </section>

  {{!-- ------------------------- Recruitment ------------------------- --}}
  <section class="tab location-tab {{tabs.recruitment.cssClass}}" data-group="primary" data-tab="recruitment">
    <details class="section" open>
      <summary>
        {{localize "ACKS-HENCHMEN.location.postings"}} ({{postings.length}})
        <button type="button" class="inline-add" data-action="createPosting"><i class="fas fa-plus"></i> {{localize "ACKS-HENCHMEN.posting.create"}}</button>
      </summary>
      {{#if postings.length}}
      <table class="postings-table acks-table acks-table--compact acks-table--interactive">
        <thead>
          <tr>
            <th>{{localize "ACKS-HENCHMEN.posting.spec"}}</th>
            <th>{{localize "ACKS-HENCHMEN.posting.employer"}}</th>
            <th>{{localize "ACKS-HENCHMEN.posting.fees"}}</th>
            <th>{{localize "ACKS-HENCHMEN.posting.statusHeader"}}</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {{#each postings}}
          <tr data-posting-id="{{id}}" class="{{#unless isActive}}inactive{{/unless}}{{#if advertVeteran}} advert-veteran{{/if}}">
            <td data-tooltip="{{rollDetail}}">{{specLabel}}{{#if advertVeteran}} <i class="fas fa-bullhorn" data-tooltip="{{localize 'ACKS-HENCHMEN.posting.advertVeteranHint'}}"></i>{{/if}}{{#if isPrivate}} <i class="fas fa-user-lock" data-tooltip="{{localize 'ACKS-HENCHMEN.posting.privateHint'}}"></i>{{/if}}{{#if commissioned}} <i class="fas fa-scroll" data-tooltip="{{localize 'ACKS-HENCHMEN.posting.commissioned'}}"></i>{{/if}}{{#if liedLevel}} <i class="fas fa-mask" data-tooltip="{{localize 'ACKS-HENCHMEN.posting.liedLevel'}} {{liedLevel}}"></i>{{/if}}</td>
            <td>{{employerName}}</td>
            <td>{{feesTotal}} gp</td>
            <td>{{statusLabel}}</td>
            <td class="row-actions">
              {{#if @root.isGM}}
              <a data-action="togglePlayerDetails" data-tooltip="{{localize 'ACKS-HENCHMEN.posting.toggleDetails'}}"><i class="fas {{#if playersSeeDetails}}fa-eye{{else}}fa-eye-slash{{/if}}"></i></a>
              {{/if}}
              {{#if isActive}}{{#if isMine}}
              <a data-action="closePosting" data-tooltip="{{localize 'ACKS-HENCHMEN.posting.close'}}"><i class="fas fa-xmark"></i></a>
              {{/if}}{{/if}}
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
      {{else}}
      <p class="hint">{{localize "ACKS-HENCHMEN.posting.none"}}</p>
      {{/if}}
    </details>

    <details class="section" open>
      <summary>{{localize "ACKS-HENCHMEN.special.header"}} ({{specialHires.length}}{{#if directedRows.length}} + {{directedRows.length}}{{/if}})</summary>
      <p class="hint">{{localize "ACKS-HENCHMEN.special.hint"}}</p>
      {{#if directedRows.length}}
      <h4 class="bucket-header">{{localize "ACKS-HENCHMEN.special.directed"}} ({{directedRows.length}})</h4>
      <table class="candidates-table acks-table acks-table--compact acks-table--interactive">
        <thead>
          <tr>
            <th>{{localize "ACKS-HENCHMEN.candidate.name"}}</th>
            <th>{{localize "ACKS-HENCHMEN.candidate.age"}}</th>
            <th>{{localize "ACKS-HENCHMEN.candidate.culture"}}</th>
            <th>{{localize "ACKS-HENCHMEN.candidate.identity"}}</th>
            <th>{{localize "ACKS-HENCHMEN.candidate.wage"}}</th>
            <th>{{localize "ACKS-HENCHMEN.special.refusals"}}</th>
            <th>{{localize "ACKS-HENCHMEN.candidate.statusHeader"}}</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {{#each directedRows}}
          <tr data-candidate-id="{{id}}" class="status-{{status}}">
            <td data-tooltip="{{appearanceTip}}">{{name}} <i class="fas fa-user-lock" data-tooltip="{{localize 'ACKS-HENCHMEN.posting.privateHint'}}"></i></td>
            <td>{{age}}</td>
            <td>{{cultureLabel}}</td>
            <td>{{identityLine}}</td>
            <td>{{#if wageGp}}{{wageGp}} gp/{{wageUnit}}{{/if}}</td>
            <td>{{refusalCount}}</td>
            <td>{{statusLabel}}</td>
            <td class="row-actions">
              {{#if isAvailable}}
              <a data-action="recruit" data-tooltip="{{localize 'ACKS-HENCHMEN.candidate.recruit'}}"><i class="fas fa-handshake"></i></a>
              {{/if}}
              {{#if @root.isGM}}
              <a data-action="removeCandidate" data-tooltip="{{localize 'ACKS-HENCHMEN.candidate.remove'}}"><i class="fas fa-trash"></i></a>
              {{/if}}
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
      {{/if}}
      {{#if specialHires.length}}
      <h4 class="bucket-header">{{localize "ACKS-HENCHMEN.special.actors"}} ({{specialHires.length}})</h4>
      <table class="candidates-table acks-table acks-table--compact acks-table--interactive">
        <thead>
          <tr>
            <th>{{localize "ACKS-HENCHMEN.candidate.name"}}</th>
            <th>{{localize "ACKS-HENCHMEN.special.origin.header"}}</th>
            <th>{{localize "ACKS-HENCHMEN.special.limit"}}</th>
            <th>{{localize "ACKS-HENCHMEN.special.refusals"}}</th>
            <th>{{localize "ACKS-HENCHMEN.candidate.statusHeader"}}</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {{#each specialHires}}
          <tr data-special-id="{{id}}" class="status-{{status}}">
            <td><img class="special-portrait" src="{{img}}" alt="" /> {{name}}</td>
            <td>{{originLabel}}</td>
            <td>{{limitLabel}}</td>
            <td>{{refusalCount}}</td>
            <td>{{statusLabel}}</td>
            <td class="row-actions">
              {{#if isAvailable}}
              <a data-action="recruitSpecial" data-tooltip="{{localize 'ACKS-HENCHMEN.candidate.recruit'}}"><i class="fas fa-handshake"></i></a>
              {{/if}}
              {{#if @root.isGM}}
              <a data-action="setSpecialLimit" data-tooltip="{{localize 'ACKS-HENCHMEN.special.setLimit'}}"><i class="fas fa-hourglass-half"></i></a>
              <a data-action="removeSpecial" data-tooltip="{{localize 'ACKS-HENCHMEN.candidate.remove'}}"><i class="fas fa-trash"></i></a>
              {{/if}}
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
      {{/if}}
      {{#unless specialHires.length}}{{#unless directedRows.length}}
      <p class="hint">{{localize "ACKS-HENCHMEN.special.empty"}}</p>
      {{/unless}}{{/unless}}
    </details>
  </section>

  {{!-- ------------------------- Henchmen ------------------------- --}}
  <section class="tab location-tab {{tabs.henchmen.cssClass}}" data-group="primary" data-tab="henchmen">
    {{#if henchmenRows.length}}
    <div class="candidate-filter">
      <i class="fas fa-magnifying-glass"></i>
      <input type="text" data-candidate-filter placeholder="{{localize 'ACKS-HENCHMEN.candidate.filter'}}" />
    </div>
    <table class="candidates-table">
      <thead>
        <tr>
          <th data-sortable>{{localize "ACKS-HENCHMEN.candidate.name"}}</th>
          <th data-sortable>{{localize "ACKS-HENCHMEN.candidate.age"}}</th>
          <th data-sortable>{{localize "ACKS-HENCHMEN.candidate.culture"}}</th>
          <th data-sortable>{{localize "ACKS-HENCHMEN.candidate.identity"}}</th>
          <th data-sortable>{{localize "ACKS-HENCHMEN.candidate.wage"}}</th>
          <th data-sortable data-tooltip="{{localize 'ACKS-HENCHMEN.special.refusalsHint'}}">{{localize "ACKS-HENCHMEN.special.refusals"}}</th>
          <th data-sortable>{{localize "ACKS-HENCHMEN.candidate.statusHeader"}}</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {{#each henchmenRows}}
        <tr data-candidate-id="{{id}}" class="status-{{status}}{{#if isHighlighted}} search-hit{{/if}}">
          <td data-tooltip="{{appearanceTip}}">{{#if isHighlighted}}<i class="fas fa-star" data-tooltip="{{localize 'ACKS-HENCHMEN.candidate.searchHit'}}"></i> {{/if}}{{name}}</td>
          <td>{{age}}</td>
          <td>{{cultureLabel}}</td>
          <td>{{identityLine}}</td>
          <td>{{#if wageGp}}{{wageGp}} gp/{{wageUnit}}{{/if}}</td>
          <td>{{refusalCount}}</td>
          <td>{{statusLabel}}</td>
          <td class="row-actions">
            {{#if isAvailable}}
            <a data-action="recruit" data-tooltip="{{localize 'ACKS-HENCHMEN.candidate.recruit'}}"><i class="fas fa-handshake"></i></a>
            {{/if}}
            {{#if @root.isGM}}
            <a data-action="removeCandidate" data-tooltip="{{localize 'ACKS-HENCHMEN.candidate.remove'}}"><i class="fas fa-trash"></i></a>
            {{/if}}
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    {{else}}
    <p class="hint">{{localize "ACKS-HENCHMEN.candidate.none"}}</p>
    {{/if}}
  </section>

  {{!-- ------------------------- Mercenaries ------------------------- --}}
  <section class="tab location-tab {{tabs.mercenaries.cssClass}}" data-group="primary" data-tab="mercenaries">
    <div class="bucket-actions">
      <button type="button" class="acks-btn acks-btn--secondary" data-action="hireGroup" data-tooltip="{{localize 'ACKS-HENCHMEN.group.hireHint'}}">
        <i class="fas fa-flag"></i> {{localize "ACKS-HENCHMEN.group.hireAsGroup"}}
      </button>
    </div>
    {{#if mercenaryRows.length}}
    <table class="candidates-table">
      <thead>
        <tr>
          <th data-sortable>{{localize "ACKS-HENCHMEN.candidate.troopType"}}</th>
          <th data-sortable>{{localize "ACKS-HENCHMEN.candidate.qty"}}</th>
          <th data-sortable>{{localize "ACKS-HENCHMEN.candidate.wage"}}</th>
          <th data-sortable>{{localize "ACKS-HENCHMEN.candidate.statusHeader"}}</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {{#each mercenaryRows}}
        <tr data-candidate-id="{{id}}" class="status-{{status}}">
          <td>{{name}}</td>
          <td>{{quantity}}</td>
          <td>{{#if wageGp}}{{wageGp}} gp/{{wageUnit}}{{/if}}</td>
          <td>{{statusLabel}}</td>
          <td class="row-actions">
            {{#if isAvailable}}
            <a data-action="recruit" data-tooltip="{{localize 'ACKS-HENCHMEN.candidate.recruit'}}"><i class="fas fa-handshake"></i></a>
            {{/if}}
            {{#if @root.isGM}}
            <a data-action="removeCandidate" data-tooltip="{{localize 'ACKS-HENCHMEN.candidate.remove'}}"><i class="fas fa-trash"></i></a>
            {{/if}}
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    {{else}}
    <p class="hint">{{localize "ACKS-HENCHMEN.candidate.none"}}</p>
    {{/if}}
  </section>

  {{!-- ------------------------- Specialists ------------------------- --}}
  <section class="tab location-tab {{tabs.specialists.cssClass}}" data-group="primary" data-tab="specialists">
    {{#if specialistRows.length}}
    <div class="candidate-filter">
      <i class="fas fa-magnifying-glass"></i>
      <input type="text" data-candidate-filter placeholder="{{localize 'ACKS-HENCHMEN.candidate.filter'}}" />
    </div>
    <table class="candidates-table">
      <thead>
        <tr>
          <th data-sortable>{{localize "ACKS-HENCHMEN.candidate.name"}}</th>
          <th data-sortable>{{localize "ACKS-HENCHMEN.candidate.age"}}</th>
          <th data-sortable>{{localize "ACKS-HENCHMEN.candidate.culture"}}</th>
          <th data-sortable>{{localize "ACKS-HENCHMEN.candidate.specialty"}}</th>
          <th data-sortable>{{localize "ACKS-HENCHMEN.candidate.wage"}}</th>
          <th data-sortable data-tooltip="{{localize 'ACKS-HENCHMEN.special.refusalsHint'}}">{{localize "ACKS-HENCHMEN.special.refusals"}}</th>
          <th data-sortable>{{localize "ACKS-HENCHMEN.candidate.statusHeader"}}</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {{#each specialistRows}}
        <tr data-candidate-id="{{id}}" class="status-{{status}}">
          <td data-tooltip="{{appearanceTip}}">{{name}}{{#if isAggregate}} ×{{quantity}}{{/if}}</td>
          <td>{{age}}</td>
          <td>{{cultureLabel}}</td>
          <td>{{identityLine}}</td>
          <td>{{#if wageGp}}{{wageGp}} gp/{{wageUnit}}{{/if}}</td>
          <td>{{refusalCount}}</td>
          <td>{{statusLabel}}</td>
          <td class="row-actions">
            {{#if isAvailable}}
            <a data-action="recruit" data-tooltip="{{localize 'ACKS-HENCHMEN.candidate.recruit'}}"><i class="fas fa-handshake"></i></a>
            {{/if}}
            {{#if @root.isGM}}
            <a data-action="removeCandidate" data-tooltip="{{localize 'ACKS-HENCHMEN.candidate.remove'}}"><i class="fas fa-trash"></i></a>
            {{/if}}
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    {{else}}
    <p class="hint">{{localize "ACKS-HENCHMEN.candidate.none"}}</p>
    {{/if}}
  </section>

  {{#if isGM}}
  {{!-- ------------------------- GM settings ------------------------- --}}

  <section class="tab location-tab {{tabs.storage.cssClass}}" data-group="primary" data-tab="storage">
    <div class="acks-location-storage-head">
      <h3><i class="fas fa-boxes-stacked"></i> {{localize "ACKS-LOCATION.storage.heldHere"}}</h3>
      <div class="acks-location-storage-tools">
        {{#if canDeposit}}
          <button type="button" class="acks-location-btn" data-action="depositHere">
            <i class="fas fa-down-long"></i> {{localize "ACKS-LOCATION.storage.deposit"}}
          </button>
        {{/if}}
        {{#if isGM}}
          <button type="button" class="acks-location-btn" data-action="openManager"
                  data-tooltip="{{localize 'ACKS-LOCATION.manager.menuHint'}}">
            <i class="fas fa-warehouse"></i> {{localize "ACKS-LOCATION.manager.open"}}
          </button>
        {{/if}}
      </div>
    </div>

    {{#if storageEmpty}}
      <p class="acks-location-empty">{{localize "ACKS-LOCATION.storage.emptyHere"}}</p>
    {{/if}}

    {{#each groups as |group|}}
      <div class="acks-location-owner" data-owner-uuid="{{group.ownerUuid}}">
        <div class="acks-location-owner-head">
          <span class="acks-location-owner-name{{#if group.dangling}} acks-location-dangling{{/if}}"
                {{#if group.dangling}}data-tooltip="{{localize 'ACKS-LOCATION.storage.danglingOwner'}}"{{/if}}
                data-action="openOwner">
            {{#if group.dangling}}<i class="fas fa-triangle-exclamation"></i> {{/if}}{{group.name}}
          </span>
          {{#if group.coinGC}}
            <span class="acks-location-coin">{{group.coinGC}} {{localize "ACKS-LOCATION.storage.gp"}}</span>
          {{/if}}
          {{#if group.canTake}}
            <button type="button" class="acks-location-btn acks-location-btn--sm" data-action="retrieveAll">
              <i class="fas fa-up-long"></i> {{localize "ACKS-LOCATION.storage.retrieveAll"}}
            </button>
          {{/if}}
        </div>

        <ul class="acks-location-rows">
          {{#each group.rows as |row|}}
            <li class="acks-location-row" data-item-id="{{row.id}}">
              <img class="acks-location-row-img" src="{{row.img}}" alt="{{row.name}}" />
              <span class="acks-location-row-name">{{row.name}}</span>
              {{#if row.stackable}}
                <span class="acks-location-row-qty">&times;{{row.quantity}}</span>
              {{/if}}
              {{#if group.canTake}}
                {{#if row.stackable}}
                  <input class="acks-location-row-take" type="number" min="1" max="{{row.quantity}}"
                         data-quantity placeholder="{{row.quantity}}"
                         data-tooltip="{{localize 'ACKS-LOCATION.storage.quantityPrompt'}}" />
                {{/if}}
                <button type="button" class="acks-location-btn acks-location-btn--sm" data-action="retrieveRow"
                        data-tooltip="{{localize 'ACKS-LOCATION.storage.retrieve'}}">
                  <i class="fas fa-up-long"></i>
                </button>
              {{/if}}
            </li>
          {{/each}}
        </ul>
      </div>
    {{/each}}
  </section>
  <section class="tab location-tab {{tabs.gmSettings.cssClass}}" data-group="primary" data-tab="gmSettings">

    {{!-- ---- The place itself: true of a chest and of a duchy alike ---- --}}
    <div class="grid-2">
      <div class="form-group">
        <label data-tooltip="{{localize 'ACKS-LOCATION.place.stackHint'}}">{{localize "ACKS-LOCATION.place.stackCount"}}</label>
        <input type="number" name="system.stack.count" value="{{stackCount}}" min="1" step="1" />
      </div>
      <div class="form-group">
        <label data-tooltip="{{localize 'ACKS-LOCATION.place.stackLabelHint'}}">{{localize "ACKS-LOCATION.place.stackLabel"}}</label>
        <input type="text" name="system.stack.label" value="{{system.stack.label}}" />
      </div>
    </div>
    <div class="acks-extras-place-admin">
      {{#if isStacked}}
      <button type="button" class="acks-btn acks-btn--secondary acks-btn--sm" data-action="splitStack" data-tooltip="{{localize 'ACKS-LOCATION.place.splitHint'}}">
        <i class="fas fa-layer-group"></i> {{localize "ACKS-LOCATION.place.split"}}
      </button>
      {{/if}}
      {{#if scene}}
      <button type="button" class="acks-btn acks-btn--secondary acks-btn--sm" data-action="unlinkScene">
        <i class="fas fa-link-slash"></i> {{localize "ACKS-LOCATION.place.unlinkScene"}}
      </button>
      {{else}}
      <span class="hint">{{localize "ACKS-LOCATION.place.sceneDropHint"}}</span>
      {{/if}}
    </div>

    {{!-- ---- The market, if this place has one. Every input below writes
           into `system.market.*`, which is genuinely null on a place without
           one — so the whole block is gated, not merely hidden. ---- --}}
    {{#unless hasMarket}}
    <div class="acks-extras-place-nomarket">
      <p class="hint">{{localize "ACKS-LOCATION.place.noMarketHint"}}</p>
      <button type="button" class="acks-btn acks-btn--primary acks-btn--sm" data-action="addMarket">
        <i class="fas fa-store"></i> {{localize "ACKS-LOCATION.place.addMarket"}}
      </button>
    </div>
    {{else}}
    <div class="grid-2">
      <div class="form-group">
        <label>{{localize "ACKS-HENCHMEN.location.urbanFamilies"}}</label>
        <input type="number" name="system.market.urbanFamilies" value="{{system.market.urbanFamilies}}" min="0" step="1" />
      </div>
      <div class="form-group">
        <label data-tooltip="{{localize 'ACKS-HENCHMEN.location.overrideHint'}}">{{localize "ACKS-HENCHMEN.location.override"}}</label>
        <select name="system.market.marketClassOverride">
          <option value="" {{#unless system.market.marketClassOverride}}selected{{/unless}}>{{localize "ACKS-HENCHMEN.location.noOverride"}}</option>
          <option value="1" {{#if (eq system.market.marketClassOverride 1)}}selected{{/if}}>I</option>
          <option value="2" {{#if (eq system.market.marketClassOverride 2)}}selected{{/if}}>II</option>
          <option value="3" {{#if (eq system.market.marketClassOverride 3)}}selected{{/if}}>III</option>
          <option value="4" {{#if (eq system.market.marketClassOverride 4)}}selected{{/if}}>IV</option>
          <option value="5" {{#if (eq system.market.marketClassOverride 5)}}selected{{/if}}>V</option>
          <option value="6" {{#if (eq system.market.marketClassOverride 6)}}selected{{/if}}>VI</option>
        </select>
      </div>
      <div class="form-group">
        <label data-tooltip="{{localize 'ACKS-HENCHMEN.location.alignmentHint'}}">{{localize "ACKS-HENCHMEN.location.alignment"}}</label>
        <select name="system.market.settlementAlignment">
          <option value="lawful" {{#if (eq system.market.settlementAlignment "lawful")}}selected{{/if}}>{{localize "ACKS-HENCHMEN.alignment.lawful"}}</option>
          <option value="neutral" {{#if (eq system.market.settlementAlignment "neutral")}}selected{{/if}}>{{localize "ACKS-HENCHMEN.alignment.neutral"}}</option>
          <option value="chaotic" {{#if (eq system.market.settlementAlignment "chaotic")}}selected{{/if}}>{{localize "ACKS-HENCHMEN.alignment.chaotic"}}</option>
        </select>
      </div>
      <div class="form-group">
        <label>{{localize "ACKS-HENCHMEN.location.rarityTable"}}</label>
        <select name="system.market.classRarityTableId">
          {{#each rarityVariants}}
          <option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
      </div>
      <div class="form-group">
        <label data-tooltip="{{localize 'ACKS-HENCHMEN.location.desertHint'}}">{{localize "ACKS-HENCHMEN.location.desert"}}</label>
        <input type="checkbox" name="system.market.desertRealm" {{#if system.market.desertRealm}}checked{{/if}} />
      </div>
      <div class="form-group">
        <label data-tooltip="{{localize 'ACKS-HENCHMEN.location.compositeHint'}}">{{localize "ACKS-HENCHMEN.location.composite"}}</label>
        <select name="system.market.compositeVariant">
          <option value="composite" {{#if (eq system.market.compositeVariant "composite")}}selected{{/if}}>{{localize "ACKS-HENCHMEN.troop.compositeBowman"}}</option>
          <option value="longbow" {{#if (eq system.market.compositeVariant "longbow")}}selected{{/if}}>{{localize "ACKS-HENCHMEN.troop.longbowman"}}</option>
        </select>
      </div>
    </div>
    <div class="demographics-block" data-tooltip="{{localize 'ACKS-HENCHMEN.location.mixDropHint'}}">
      <label class="block-label" data-tooltip="{{localize 'ACKS-HENCHMEN.location.demographicsHint'}}">
        {{localize "ACKS-HENCHMEN.location.demographics"}}
        <a class="inline-add" data-action="addDemographic"><i class="fas fa-plus"></i></a>
        <a class="inline-add" data-action="exportDemographics" data-tooltip="{{localize 'ACKS-HENCHMEN.location.mixExport'}}"><i class="fas fa-file-export"></i></a>
      </label>
      {{#each demographics}}
      <div class="demographic-row" data-demographic-index="{{index}}">
        <select name="system.market.demographics.{{index}}.culture">
          {{#each @root.cultureOptions}}
          <option value="{{id}}" {{#if (eq id ../culture)}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
        <input type="number" name="system.market.demographics.{{index}}.weight" value="{{weight}}" min="0" step="1" data-tooltip="{{localize 'ACKS-HENCHMEN.location.weight'}}" />
        <a data-action="removeDemographic"><i class="fas fa-trash"></i></a>
      </div>
      {{else}}
      <p class="hint">{{localize "ACKS-HENCHMEN.location.demographicsEmpty"}}</p>
      {{/each}}
    </div>

    <details class="section">
      <summary>
        {{localize "ACKS-HENCHMEN.location.slander"}} ({{slander.length}})
        <button type="button" class="inline-add" data-action="addSlander"><i class="fas fa-plus"></i></button>
      </summary>
      <p class="hint">{{localize "ACKS-HENCHMEN.location.slanderHint"}}</p>
      {{#each slander}}
      <div class="slander-row" data-slander-index="{{index}}">
        <select name="system.market.slander.{{index}}.subject.scope">
          <option value="all" {{#if (eq subject.scope "all")}}selected{{/if}}>{{localize "ACKS-HENCHMEN.location.slanderScopeAll"}}</option>
          <option value="party" {{#if (eq subject.scope "party")}}selected{{/if}}>{{localize "ACKS-HENCHMEN.location.slanderScopeParty"}}</option>
          <option value="character" {{#if (eq subject.scope "character")}}selected{{/if}}>{{localize "ACKS-HENCHMEN.location.slanderScopeCharacter"}}</option>
        </select>
        <input type="text" name="system.market.slander.{{index}}.subject.uuid" value="{{subject.uuid}}" placeholder="{{localize 'ACKS-HENCHMEN.location.slanderSubjectUuid'}}" />
        <input type="text" name="system.market.slander.{{index}}.npcName" value="{{npcName}}" placeholder="{{localize 'ACKS-HENCHMEN.location.slanderNpc'}}" />
        <input type="text" name="system.market.slander.{{index}}.note" value="{{note}}" placeholder="{{localize 'ACKS-HENCHMEN.location.slanderNote'}}" />
        <a data-action="removeSlander"><i class="fas fa-trash"></i></a>
      </div>
      {{/each}}
    </details>

    <div class="acks-extras-place-admin">
      <button type="button" class="acks-btn acks-btn--danger acks-btn--sm" data-action="removeMarket" data-tooltip="{{localize 'ACKS-LOCATION.place.removeMarketHint'}}">
        <i class="fas fa-store-slash"></i> {{localize "ACKS-LOCATION.place.removeMarket"}}
      </button>
    </div>
    {{/unless}}
  </section>

  {{!-- ------------------------- GM view ------------------------- --}}
  <section class="tab location-tab {{tabs.gmView.cssClass}}" data-group="primary" data-tab="gmView">
    <p class="hint">{{localize "ACKS-HENCHMEN.market.hint"}}</p>
    {{#if marketPools.length}}
    <table class="market-table acks-table acks-table--compact acks-table--interactive">
      <thead>
        <tr>
          <th>{{localize "ACKS-HENCHMEN.market.segment"}}</th>
          <th data-tooltip="{{localize 'ACKS-HENCHMEN.posting.weekHint'}}">{{localize "ACKS-HENCHMEN.posting.week"}}</th>
          <th data-tooltip="{{localize 'ACKS-HENCHMEN.posting.poolHint'}}">{{localize "ACKS-HENCHMEN.posting.pool"}}</th>
          <th>{{localize "ACKS-HENCHMEN.market.arrived"}}</th>
          <th>{{localize "ACKS-HENCHMEN.market.hired"}}</th>
        </tr>
      </thead>
      <tbody>
        {{#each marketPools}}
        <tr>
          <td data-tooltip="{{detail}}">{{label}}</td>
          <td>{{week}}</td>
          <td>{{total}}</td>
          <td>{{arrived}}{{#if pending}} <span class="hint">(+{{pending}})</span>{{/if}}</td>
          <td>{{hired}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    {{else}}
    <p class="hint">{{localize "ACKS-HENCHMEN.market.empty"}}</p>
    {{/if}}

    <details class="section">
      <summary>{{localize "ACKS-HENCHMEN.location.ledger"}} ({{ledgerTotal}} gp)</summary>
      <table class="ledger-table acks-table acks-table--compact">
        <tbody>
          {{#each ledger}}
          <tr><td>{{gp}} gp</td><td>{{postingId}}</td></tr>
          {{/each}}
        </tbody>
      </table>
    </details>

    <details class="section">
      <summary>{{localize "ACKS-HENCHMEN.location.marketLog"}} ({{marketLog.length}})</summary>
      <p class="hint">{{localize "ACKS-HENCHMEN.location.marketLogHint"}}</p>
      <table class="ledger-table acks-table acks-table--compact">
        <tbody>
          {{#each marketLog}}
          <tr><td>{{typeLabel}}</td><td>{{note}}</td><td class="hint">{{when}}</td></tr>
          {{/each}}
        </tbody>
      </table>
    </details>
  </section>
  {{/if}}
</div>
