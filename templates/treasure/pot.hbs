<section class="acks-extras-treasure__root">

  <header class="acks-extras-treasure__bar">
    <div class="acks-extras-treasure__total">
      <span class="acks-extras-caption">{{#if staging}}{{localize "ACKS-TREASURE.bar.potValue"}}{{else}}{{localize "ACKS-TREASURE.bar.haul"}}{{/if}}</span>
      <span class="acks-extras-treasure__figure" data-tooltip-text="{{totalTip}}">{{totalText}}</span>
    </div>
    <span class="acks-extras-treasure__turned" data-tooltip-text="{{foundTip}}">{{foundText}}</span>
    <ul class="acks-extras-treasure__legend" aria-label="{{localize 'ACKS-TREASURE.bar.bands'}}">
      {{#each bands}}
        <li class="acks-extras-treasure__legend-item"><span class="acks-extras-treasure__swatch is-band-{{rank}}" aria-hidden="true"></span>{{name}}</li>
      {{/each}}
    </ul>
    {{#if isGM}}
      <button type="button" class="acks-btn acks-btn--sm acks-btn--secondary" data-action="closePot">{{localize "ACKS-TREASURE.judge.close"}}</button>
    {{/if}}
  </header>

  <div class="acks-extras-treasure__layout{{#if staging}} is-staging{{/if}}{{#if open}} is-open{{/if}}">

    {{#if staging}}
      <aside class="acks-extras-treasure__side">
        {{#if deal}}
          <div class="acks-extras-treasure__field acks-extras-treasure__hoards" role="group" aria-labelledby="{{@root.partId}}-hoards">
            <div class="acks-extras-treasure__hoards-head">
              <span class="acks-extras-caption" id="{{@root.partId}}-hoards">{{localize "ACKS-TREASURE.deal.hoardsTitle"}}</span>
              <span class="acks-extras-treasure__hoards-total" data-tooltip-text="{{deal.hoardsTip}}">{{deal.hoardsText}}</span>
            </div>
            {{#if deal.rows.length}}
              <ul class="acks-extras-treasure__hoards-list">
                {{#each deal.rows}}
                  <li class="acks-extras-treasure__hoard{{#if monster}} is-monster{{/if}}{{#if off}} is-off{{/if}}" data-tooltip-text="{{tip}}">
                    <span class="acks-extras-treasure__hoard-badge" aria-hidden="true">{{badge}}</span>
                    <span class="acks-extras-treasure__hoard-text">
                      <span class="acks-extras-treasure__hoard-title">{{title}}</span>
                      <span class="acks-extras-treasure__hoard-source"{{#if sourceTip}} data-tooltip-text="{{sourceTip}}"{{/if}}>{{source}}</span>
                    </span>
                    <span class="acks-extras-treasure__stepper">
                      <button type="button" class="acks-btn acks-btn--sm acks-btn--secondary" data-action="dealStep" data-list="{{list}}" data-index="{{index}}" data-step="-1" aria-label="{{lessLabel}}" data-tooltip=""{{#if off}} disabled{{/if}}>−</button>
                      <span class="acks-extras-treasure__stepper-n">{{hoardsText}}</span>
                      <button type="button" class="acks-btn acks-btn--sm acks-btn--secondary" data-action="dealStep" data-list="{{list}}" data-index="{{index}}" data-step="1" aria-label="{{moreLabel}}" data-tooltip=""{{#if off}} disabled{{/if}}>+</button>
                    </span>
                    <button type="button" class="acks-btn acks-btn--sm acks-btn--quiet" data-action="dealRemove" data-list="{{list}}" data-index="{{index}}" aria-label="{{removeLabel}}" data-tooltip="">×</button>
                  </li>
                {{/each}}
              </ul>
            {{/if}}
            <div class="acks-extras-treasure__dropzone" data-accept-drop="deal">
              <span>{{localize "ACKS-TREASURE.deal.dropZone"}}</span>
              <span class="acks-extras-treasure__hint">{{localize "ACKS-TREASURE.deal.dropHint"}}</span>
            </div>
            <span class="acks-extras-treasure__add"{{#if deal.addTip}} data-tooltip-text="{{deal.addTip}}"{{/if}}>
              <button type="button" class="acks-btn acks-btn--sm acks-btn--secondary" data-action="dealPicker" aria-expanded="{{deal.picking}}" aria-controls="{{@root.partId}}-picker"{{#unless deal.canAdd}} disabled{{/unless}}>{{localize "ACKS-TREASURE.deal.addType"}}</button>
            </span>
            {{#if deal.picking}}
              <div class="acks-extras-treasure__picker" id="{{@root.partId}}-picker">
                <div class="acks-extras-treasure__picker-grid" role="group" aria-label="{{localize 'ACKS-TREASURE.deal.pickGroup'}}">
                  {{#each deal.types}}
                    <button type="button" class="acks-btn acks-btn--sm acks-btn--secondary{{#if listed}} is-listed{{/if}}" data-action="dealPick" data-letter="{{letter}}" aria-label="{{label}}" data-tooltip-text="{{tip}}">{{letter}}</button>
                  {{/each}}
                </div>
                <button type="button" class="acks-btn acks-btn--sm" data-action="dealPicker">{{localize "ACKS-TREASURE.deal.pickDone"}}</button>
              </div>
            {{/if}}
          </div>
          <fieldset class="acks-extras-treasure__field">
            <legend class="acks-extras-caption">{{localize "ACKS-TREASURE.deal.styleTitle"}}</legend>
            <div class="acks-btn-group">
              {{#each deal.styles}}
                <button type="button" class="acks-btn acks-btn--sm{{#unless pressed}} acks-btn--secondary{{/unless}}" data-action="dealStyle" data-style="{{key}}" aria-pressed="{{pressed}}" data-tooltip-text="{{tip}}">{{label}}</button>
              {{/each}}
            </div>
          </fieldset>
          <div class="acks-extras-treasure__field">
            <label class="acks-extras-caption" for="{{@root.partId}}-arms">{{localize "ACKS-TREASURE.deal.armsTitle"}}</label>
            <div class="acks-extras-treasure__select" data-tooltip-text="{{deal.arms.tip}}">
              <select class="acks-input" id="{{@root.partId}}-arms" data-deal-arms aria-describedby="{{@root.partId}}-arms-hint"{{#if deal.arms.off}} disabled{{/if}}>
                {{#each deal.arms.options}}
                  <option value="{{key}}"{{#if selected}} selected{{/if}}>{{label}}</option>
                {{/each}}
              </select>
            </div>
            <span class="acks-extras-treasure__hint" id="{{@root.partId}}-arms-hint">{{localize "ACKS-TREASURE.deal.armsHint"}}</span>
          </div>
          <div class="acks-extras-treasure__field">
            <button type="button" class="acks-extras-treasure__toggle" data-action="dealSpecial" aria-pressed="{{deal.special}}">
              <span class="acks-extras-treasure__toggle-mark" aria-hidden="true"></span>
              <span class="acks-extras-treasure__toggle-label">{{localize "ACKS-TREASURE.deal.special"}}</span>
            </button>
            <span class="acks-extras-treasure__hint">{{localize "ACKS-TREASURE.deal.specialHint"}}</span>
            <button type="button" class="acks-extras-treasure__toggle" data-action="dealLair" aria-pressed="{{deal.lair}}" data-tooltip-text="{{deal.lairTip}}">
              <span class="acks-extras-treasure__toggle-mark" aria-hidden="true"></span>
              <span class="acks-extras-treasure__toggle-label">{{localize "ACKS-TREASURE.deal.lair"}}</span>
            </button>
            <span class="acks-extras-treasure__hint">{{localize "ACKS-TREASURE.deal.lairHint"}}</span>
          </div>
          <hr class="acks-rule--ornament">
        {{/if}}
        <div class="acks-extras-treasure__field" role="group" aria-labelledby="{{@root.partId}}-mode">
          <span class="acks-extras-caption" id="{{@root.partId}}-mode">{{localize "ACKS-TREASURE.judge.mode"}}</span>
          <div class="acks-btn-group">
            <button type="button" class="acks-btn acks-btn--sm {{#unless modeJudge}}acks-btn--secondary{{/unless}}" data-action="setMode" data-mode="judge" aria-pressed="{{modeJudge}}">{{localize "ACKS-TREASURE.judge.modeJudge"}}</button>
            <button type="button" class="acks-btn acks-btn--sm {{#if modeJudge}}acks-btn--secondary{{/if}}" data-action="setMode" data-mode="table" aria-pressed="{{modeTable}}">{{localize "ACKS-TREASURE.judge.modeTable"}}</button>
          </div>
          <span class="acks-extras-treasure__hint">{{modeHint}}</span>
        </div>
        {{#if deal}}
          <button type="button" class="acks-btn acks-btn--roll" data-action="dealRun" data-tooltip-text="{{deal.dealTip}}">{{deal.runText}}</button>
          {{#if deal.warning}}
            <div class="acks-callout acks-callout--warning acks-extras-treasure__warning" role="alert" data-deal-warning data-tooltip-text="{{deal.warning.tip}}">
              <span><span class="acks-callout-label">{{localize "ACKS-TREASURE.deal.warn.label"}}</span>{{deal.warning.body}}</span>
              <div class="acks-btn-group">
                <button type="button" class="acks-btn acks-btn--sm acks-btn--secondary" data-action="dealCancel">{{localize "ACKS-TREASURE.deal.warn.cancel"}}</button>
                <button type="button" class="acks-btn acks-btn--sm" data-action="dealConfirm">{{localize "ACKS-TREASURE.deal.warn.confirm"}}</button>
              </div>
            </div>
          {{/if}}
        {{/if}}
        <button type="button" class="acks-btn acks-btn--secondary" data-action="addValue">{{localize "ACKS-TREASURE.judge.addValue"}}</button>
        <button type="button" class="acks-btn acks-btn--lg" data-action="openTable">{{localize "ACKS-TREASURE.judge.open"}}</button>
      </aside>
    {{/if}}

    <main class="acks-extras-treasure__main">

      <ol class="acks-extras-treasure__grid" {{#if staging}}data-accept-drop="pot"{{/if}}>
        {{#each cards}}
          {{#if ../isGM}}
            <li class="acks-extras-treasure-card acks-extras-treasure-card--judge acks-extras-treasure-flare is-band-{{band}} is-look-{{look}} {{face.className}}{{#if aura}} is-aura{{/if}}{{#if claimed}} is-claimed{{/if}}{{#if struck}} is-struck{{/if}}{{#unless found}} is-unfound{{/unless}}" data-card-id="{{id}}" data-tooltip-text="{{tip}}"{{#if canTake}} draggable="true" data-drag-uuid="{{dragUuid}}"{{/if}}>
              {{#if face.art.full}}<img class="acks-extras-treasure-art" src="{{face.art.src}}" alt="" aria-hidden="true">{{/if}}
              {{#if face.vignetteTex}}<span class="acks-extras-treasure-layer acks-extras-treasure-vignette" style="background-image: {{face.vignetteTex}}" aria-hidden="true"></span>{{/if}}
              <span class="acks-extras-treasure-layer acks-extras-treasure-frame" aria-hidden="true"></span>
              {{#if face.corners}}<span class="acks-extras-treasure-layer acks-extras-treasure-corners is-face is-{{face.corners}}" aria-hidden="true"><i></i><i></i></span>{{/if}}
              {{#if face.foilTex}}<span class="acks-extras-treasure-layer acks-extras-treasure-foil is-foil-{{face.foil}}" style="background-image: {{face.foilTex}}" aria-hidden="true"></span>{{/if}}
              {{#if face.notched}}<span class="acks-extras-treasure-layer acks-extras-treasure-notch" aria-hidden="true"><i></i><i></i><i></i><i></i></span>{{/if}}
              <div class="acks-extras-treasure-card__tag">
                <span>{{tag}}</span>
                {{#if seed}}<span class="acks-extras-treasure-card__seed"><span class="acks-lozenge-mark acks-lozenge-mark--hollow" aria-hidden="true"></span>{{localize "ACKS-TREASURE.card.seed"}}</span>{{/if}}
                <span class="acks-extras-treasure__swatch is-band-{{band}}" aria-hidden="true"></span>
                <span class="acks-extras-treasure__pips" role="img" aria-label="{{bandName}}" data-tooltip-text="{{bandTip}}">{{bandPips}}</span>
              </div>
              {{#unless face.art.full}}<span class="acks-extras-treasure-artslot" aria-hidden="true">{{#if face.art.slot}}<img src="{{face.art.src}}" alt="">{{else}}<span class="acks-lozenge-mark acks-lozenge-mark--hollow"></span>{{/if}}</span>{{/unless}}
              <div class="acks-extras-treasure-card__body">
                <span class="acks-extras-treasure-card__name">{{name}}</span>
                {{#if struck}}<span class="acks-extras-treasure-card__warn">{{struckText}}</span>{{/if}}
                {{#unless found}}<span class="acks-extras-treasure-card__note">{{localize "ACKS-TREASURE.card.unfound"}}</span>{{/unless}}
                {{#if maskName}}<span class="acks-extras-treasure-card__note">{{localize "ACKS-TREASURE.card.maskedAs" name=maskName}}</span>{{/if}}
                {{#if leaks}}<span class="acks-extras-treasure-card__warn">{{#if leaksPicture}}{{localize "ACKS-TREASURE.card.leaksPicture"}}{{else}}{{localize "ACKS-TREASURE.card.leaks"}}{{/if}}</span>{{/if}}
                {{#if rolledText}}<span class="acks-extras-treasure-card__note">{{rolledText}}</span>{{/if}}
                <span class="acks-extras-treasure-card__note">{{worthText}}</span>
                <span class="acks-extras-treasure-card__note">{{weightText}}</span>
                <span class="acks-extras-treasure-card__note">{{stateText}}</span>
              </div>
              <div class="acks-extras-treasure-card__foot">
                {{#if claimed}}
                  <span class="acks-extras-treasure-card__by">{{localize "ACKS-TREASURE.card.to" name=claimedByName}}</span>
                {{else}}
                  {{#if canFlip}}<button type="button" class="acks-btn acks-btn--sm acks-btn--secondary" data-action="flip" data-card-id="{{id}}" aria-label="{{backLabel}}">{{localize "ACKS-TREASURE.card.turn"}}</button>{{/if}}
                  {{#if canTake}}<button type="button" class="acks-btn acks-btn--sm acks-btn--secondary" data-action="take" data-card-id="{{id}}">{{localize "ACKS-TREASURE.card.take"}}</button>{{/if}}
                  {{#if ../staging}}<button type="button" class="acks-btn acks-btn--sm acks-btn--quiet" data-action="removeCard" data-card-id="{{id}}" aria-label="{{removeLabel}}">{{localize "ACKS-TREASURE.card.remove"}}</button>{{/if}}
                {{/if}}
              </div>
            </li>
          {{else}}
            <li class="acks-extras-treasure__slot acks-extras-treasure-flare is-band-{{band}}" data-card-id="{{id}}">
              {{#if down}}
                <button type="button" class="acks-extras-treasure-back is-band-{{band}} {{back.className}}" data-action="flip" data-card-id="{{id}}" aria-label="{{backLabel}}" data-tooltip-text="{{tip}}">
                  {{#if back.art.full}}<img class="acks-extras-treasure-art" src="{{back.art.src}}" alt="" aria-hidden="true">{{/if}}
                  {{#if back.grimeTex}}<span class="acks-extras-treasure-layer acks-extras-treasure-grime is-grime-{{back.grime}}" style="background-image: {{back.grimeTex}}" aria-hidden="true"></span>{{/if}}
                  <span class="acks-extras-treasure-layer acks-extras-treasure-frame" aria-hidden="true"></span>
                  {{#if back.corners}}<span class="acks-extras-treasure-layer acks-extras-treasure-corners" aria-hidden="true"><i></i><i></i><i></i><i></i></span>{{/if}}
                  {{#if back.breaks}}<span class="acks-extras-treasure-layer acks-extras-treasure-breaks" aria-hidden="true"><i></i><i></i></span>{{/if}}
                  {{#if back.foilTex}}<span class="acks-extras-treasure-layer acks-extras-treasure-foil is-on-back is-foil-{{back.foil}}" style="background-image: {{back.foilTex}}" aria-hidden="true"></span>{{/if}}
                  {{#if back.notched}}<span class="acks-extras-treasure-layer acks-extras-treasure-notch" aria-hidden="true"><i></i><i></i><i></i><i></i></span>{{/if}}
                  {{#unless back.art.full}}<span class="acks-extras-treasure-back__crest{{#if back.art.slot}} has-art{{/if}}" aria-hidden="true">{{#if back.art.slot}}<img class="acks-extras-treasure-back__art" src="{{back.art.src}}" alt="">{{else}}<img class="acks-extras-treasure-back__icon" src="{{backIcon}}" alt="">{{/if}}</span>{{/unless}}
                  <span class="acks-extras-treasure-back__plate">
                    <span class="acks-extras-treasure-back__pool">{{backTag}}</span>
                    <span class="acks-extras-treasure-back__pips" aria-hidden="true">{{bandPips}}</span>
                  </span>
                </button>
              {{else}}
                <div class="acks-extras-treasure-card is-look-{{look}} {{face.className}}{{#if aura}} is-aura{{/if}}{{#if claimed}} is-claimed{{/if}}" data-up="1" data-tooltip-text="{{tip}}"{{#if canTake}} draggable="true" data-drag-uuid="{{dragUuid}}"{{/if}}>
                  {{#if face.art.full}}<img class="acks-extras-treasure-art" src="{{face.art.src}}" alt="" aria-hidden="true">{{/if}}
                  {{#if face.vignetteTex}}<span class="acks-extras-treasure-layer acks-extras-treasure-vignette" style="background-image: {{face.vignetteTex}}" aria-hidden="true"></span>{{/if}}
                  <span class="acks-extras-treasure-layer acks-extras-treasure-frame" aria-hidden="true"></span>
                  {{#if face.corners}}<span class="acks-extras-treasure-layer acks-extras-treasure-corners is-face is-{{face.corners}}" aria-hidden="true"><i></i><i></i></span>{{/if}}
                  {{#if face.foilTex}}<span class="acks-extras-treasure-layer acks-extras-treasure-foil is-foil-{{face.foil}}" style="background-image: {{face.foilTex}}" aria-hidden="true"></span>{{/if}}
                  {{#if face.notched}}<span class="acks-extras-treasure-layer acks-extras-treasure-notch" aria-hidden="true"><i></i><i></i><i></i><i></i></span>{{/if}}
                  <div class="acks-extras-treasure-card__tag">
                    <span>{{tag}}</span>
                    <span class="acks-extras-treasure__swatch is-band-{{band}}" aria-hidden="true"></span>
                    <span class="acks-extras-treasure__pips" role="img" aria-label="{{bandName}}" data-tooltip-text="{{bandTip}}">{{bandPips}}</span>
                  </div>
                  {{#unless face.art.full}}<span class="acks-extras-treasure-artslot" aria-hidden="true">{{#if face.art.slot}}<img src="{{face.art.src}}" alt="">{{else}}<span class="acks-lozenge-mark acks-lozenge-mark--hollow"></span>{{/if}}</span>{{/unless}}
                  <div class="acks-extras-treasure-card__body">
                    <span class="acks-extras-treasure-card__name">{{name}}</span>
                    <span class="acks-extras-treasure-card__note">{{worthText}}</span>
                    <span class="acks-extras-treasure-card__note">{{weightText}}</span>
                    {{#if aura}}<span class="acks-tag acks-tag--ghost">{{localize "ACKS-TREASURE.card.aura"}}</span>{{/if}}
                  </div>
                  <div class="acks-extras-treasure-card__foot">
                    {{#if claimed}}
                      <span class="acks-extras-treasure-card__by">{{localize "ACKS-TREASURE.card.to" name=claimedByName}}</span>
                    {{else if canTake}}
                      <button type="button" class="acks-btn acks-btn--sm acks-btn--secondary" data-action="take" data-card-id="{{id}}">{{localize "ACKS-TREASURE.card.take"}}</button>
                    {{/if}}
                  </div>
                </div>
              {{/if}}
            </li>
          {{/if}}
        {{else}}
          <li class="acks-extras-treasure__empty">{{#if staging}}{{localize "ACKS-TREASURE.judge.emptyPot"}}{{else}}{{localize "ACKS-TREASURE.card.none"}}{{/if}}</li>
        {{/each}}
      </ol>

      {{#if staging}}
        <div class="acks-extras-treasure__buckets">
          {{#each buckets}}
            <section class="acks-extras-treasure__bucket" data-accept-drop="{{key}}" aria-labelledby="{{@root.partId}}-bucket-{{key}}">
              <h3 class="acks-extras-treasure__bucket-title" id="{{@root.partId}}-bucket-{{key}}">{{title}}</h3>
              <span class="acks-extras-treasure__hint">{{hint}}</span>
              <ul class="acks-extras-treasure__bucket-list">
                {{#each rows}}
                  <li class="acks-extras-treasure__bucket-row">
                    <span class="acks-extras-treasure__bucket-name">{{name}}</span>
                    <span class="acks-extras-treasure__bucket-worth">{{worthText}}</span>
                    <button type="button" class="acks-btn acks-btn--sm acks-btn--quiet" data-action="removeCard" data-card-id="{{id}}" aria-label="{{removeLabel}}">{{localize "ACKS-TREASURE.card.remove"}}</button>
                    {{#if takes}}<span class="acks-extras-treasure__bucket-takes" data-tooltip-text="{{takesTip}}">{{takes}}</span>{{/if}}
                  </li>
                {{/each}}
              </ul>
              <span class="acks-extras-treasure__hint">{{drop}}</span>
            </section>
          {{/each}}
        </div>
      {{/if}}

    </main>

    {{#if open}}
      <aside class="acks-extras-treasure__party">
        {{#if party.members.length}}
          <span class="acks-extras-caption" id="{{@root.partId}}-party">{{localize "ACKS-TREASURE.party.title"}}</span>
          <ul class="acks-extras-treasure__members" aria-labelledby="{{@root.partId}}-party">
            {{#each party.members}}
              <li class="acks-extras-treasure__member{{#unless drop}} is-closed{{/unless}}"{{#if drop}} data-member-drop="1" data-actor-uuid="{{uuid}}"{{/if}}>
                <div class="acks-extras-treasure__member-head">
                  <span class="acks-extras-treasure__member-name">{{name}}</span>
                  <span class="acks-extras-treasure__member-speed" data-tooltip-text="{{speedTip}}">{{speedText}}</span>
                </div>
                <div class="acks-extras-treasure__bar-track" aria-hidden="true"><div class="acks-extras-treasure__bar-fill{{#if over}} is-over{{/if}}" style="--load: {{pct}}%"></div></div>
                <span class="acks-extras-treasure__member-load" data-tooltip-text="{{loadTip}}">{{loadText}}</span>
                {{#if note}}<span class="acks-extras-treasure__hint">{{note}}</span>{{/if}}
              </li>
            {{/each}}
          </ul>
          <div class="acks-extras-treasure__grab">
            {{#if party.canGrab}}
              <button type="button" class="acks-btn" data-action="grab">{{localize "ACKS-TREASURE.party.quick"}}</button>
              <span class="acks-extras-treasure__hint">{{localize "ACKS-TREASURE.party.quickHint"}}</span>
            {{/if}}
            <div class="acks-extras-treasure__moves" data-tooltip-text="{{party.movesTip}}">
              <span>{{localize "ACKS-TREASURE.party.moves"}}</span>
              <span>{{party.movesText}}</span>
            </div>
            {{#if party.leftover}}<span class="acks-extras-treasure__leftover" data-tooltip-text="{{party.leftoverTip}}">{{party.leftover}}</span>{{/if}}
          </div>
        {{else}}
          <span class="acks-extras-treasure__hint">{{localize "ACKS-TREASURE.party.none"}}</span>
        {{/if}}
      </aside>
    {{/if}}

    {{#if staging}}
      <aside class="acks-extras-treasure__toggles" aria-labelledby="{{@root.partId}}-toggles">
        <span class="acks-extras-caption" id="{{@root.partId}}-toggles">{{localize "ACKS-TREASURE.toggle.title"}}</span>
        {{#each toggles}}
          <button type="button" class="acks-extras-treasure__toggle" data-action="toggleDeal" data-toggle="{{key}}" aria-pressed="{{pressed}}">
            <span class="acks-extras-treasure__toggle-mark" aria-hidden="true"></span>
            <span class="acks-extras-treasure__toggle-label">{{label}}</span>
          </button>
          <span class="acks-extras-treasure__hint">{{hint}}</span>
        {{/each}}
        <span class="acks-extras-treasure__hint">{{localize "ACKS-TREASURE.toggle.note"}}</span>
      </aside>
    {{/if}}
  </div>
</section>
