<article class="acks-extras-treasure-door" data-pot-uuid="{{uuid}}">
  <header class="acks-porphyry acks-extras-treasure-door__head">
    <span class="acks-extras-treasure-door__title">{{localize "ACKS-TREASURE.door.title"}}</span>
    <span class="acks-extras-treasure-door__name">{{name}}</span>
  </header>
  <div class="acks-extras-treasure-door__body">
    <div class="acks-extras-treasure-door__pips" data-field="pips" aria-hidden="true"></div>
    <div class="acks-extras-treasure-door__row"><span>{{localize "ACKS-TREASURE.door.cards"}}</span><span data-field="turned"></span></div>
    <div class="acks-extras-treasure-door__row"><span>{{localize "ACKS-TREASURE.door.haul"}}</span><span data-field="haul"></span></div>
    <button type="button" class="acks-btn acks-btn--block" data-action="openTable">{{localize "ACKS-TREASURE.door.open"}}</button>
  </div>
</article>
