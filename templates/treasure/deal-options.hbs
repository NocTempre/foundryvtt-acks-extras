{{!--
  The deal's choices, as the pot's rail and any card that asks for the same ones draw them: Table style (and, for a seat that may modify world settings, the Treasure tables button), Arms and armor column, Special treasure, Met in their lair. The context is `deal-logic.mjs` `dealOptionsView`; the controls carry data-action / data-deal-arms and the caller binds them. Ids read `@root.partId`, the per-window seed, so a caller outside a window part puts `partId` in its root context.
--}}
<fieldset class="acks-extras-treasure__field">
  <legend class="acks-extras-caption">{{localize "ACKS-TREASURE.deal.styleTitle"}}</legend>
  <div class="acks-btn-group">
    {{#each styles}}
      <button type="button" class="acks-btn acks-btn--sm{{#unless pressed}} acks-btn--secondary{{/unless}}" data-action="dealStyle" data-style="{{key}}" aria-pressed="{{pressed}}" data-tooltip-text="{{tip}}"{{#if off}} disabled{{/if}}>{{label}}</button>
    {{/each}}
  </div>
  {{#if tablesButton}}
    <button type="button" class="acks-btn acks-btn--sm acks-btn--secondary acks-extras-treasure__tables" data-action="dealTables" data-tooltip-text="{{tablesButton.tip}}">{{tablesButton.label}}</button>
  {{/if}}
</fieldset>
<div class="acks-extras-treasure__field">
  <label class="acks-extras-caption" for="{{@root.partId}}-arms">{{localize "ACKS-TREASURE.deal.armsTitle"}}</label>
  <div class="acks-extras-treasure__select" data-tooltip-text="{{arms.tip}}">
    <select class="acks-input" id="{{@root.partId}}-arms" data-deal-arms aria-describedby="{{@root.partId}}-arms-hint"{{#if arms.off}} disabled{{/if}}>
      {{#each arms.options}}
        <option value="{{key}}"{{#if selected}} selected{{/if}}>{{label}}</option>
      {{/each}}
    </select>
  </div>
  <span class="acks-extras-treasure__hint" id="{{@root.partId}}-arms-hint">{{localize "ACKS-TREASURE.deal.armsHint"}}</span>
</div>
<div class="acks-extras-treasure__field">
  <button type="button" class="acks-extras-treasure__toggle" data-action="dealSpecial" aria-pressed="{{special}}"{{#if locked}} disabled{{/if}}>
    <span class="acks-extras-treasure__toggle-mark" aria-hidden="true"></span>
    <span class="acks-extras-treasure__toggle-label">{{localize "ACKS-TREASURE.deal.special"}}</span>
  </button>
  <span class="acks-extras-treasure__hint">{{localize "ACKS-TREASURE.deal.specialHint"}}</span>
  <button type="button" class="acks-extras-treasure__toggle" data-action="dealLair" aria-pressed="{{lair}}" data-tooltip-text="{{lairTip}}"{{#if locked}} disabled{{/if}}>
    <span class="acks-extras-treasure__toggle-mark" aria-hidden="true"></span>
    <span class="acks-extras-treasure__toggle-label">{{localize "ACKS-TREASURE.deal.lair"}}</span>
  </button>
  <span class="acks-extras-treasure__hint">{{localize "ACKS-TREASURE.deal.lairHint"}}</span>
  {{#if reason}}
    <span class="acks-extras-treasure__hint acks-extras-treasure__reason" role="status" data-tooltip-text="{{reason.tip}}">{{reason.text}}</span>
  {{/if}}
</div>
