        <span>{{localize "ACKS-CLASSES.sheet.atLevel"}}</span><span>{{localize "ACKS-CLASSES.sheet.awardRow.kind"}}</span><span>{{localize "ACKS-CLASSES.sheet.awardRow.what"}}</span><span>{{localize "ACKS-CLASSES.sheet.note"}}</span><span></span>
