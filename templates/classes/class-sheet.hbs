        <button type="button" class="acks-extras-classes-ctl" data-action="rowAdd" data-array="awards" aria-label="{{localize "ACKS-CLASSES.sheet.ctl.add" what=(localize "ACKS-CLASSES.sheet.what.award")}}" data-tooltip="{{localize "ACKS-CLASSES.sheet.ctl.add" what=(localize "ACKS-CLASSES.sheet.what.award")}}"><i class="fa-solid fa-plus" inert></i></button></legend>
