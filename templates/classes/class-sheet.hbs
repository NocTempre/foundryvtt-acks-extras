              <div class="acks-extras-classes-listed" data-award-refs="{{index}}">
                <span class="acks-extras-classes-refname">{{localize "ACKS-CLASSES.sheet.awardRow.listedHint"}}</span>
                {{#each choiceRefs}}
                  <span class="acks-extras-classes-chip">
                    {{#if name}}<a data-action="refOpen" data-ref="{{ref}}" data-tooltip="{{localize "ACKS-CLASSES.sheet.refOpen"}}">{{name}}</a>{{else}}<span class="acks-extras-classes-refname--unresolved" data-tooltip="{{localize "ACKS-CLASSES.sheet.unresolvedRef"}}"><i class="fa-solid fa-triangle-exclamation" inert></i> {{ref}}</span>{{/if}}
