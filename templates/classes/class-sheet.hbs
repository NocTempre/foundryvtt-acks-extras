          <select name="system.awards.{{index}}.kind" aria-label="{{localize "ACKS-CLASSES.sheet.awardRow.kind"}}">
            {{#each kindOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
          <div class="acks-extras-classes-award-body">
          {{#if isChoice}}
            <select name="system.awards.{{index}}.choice.from" aria-label="{{localize "ACKS-CLASSES.sheet.awardRow.from"}}" data-tooltip="{{localize "ACKS-CLASSES.sheet.awardRow.from"}}">
              {{#each fromOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
            </select>
            {{#if (eq choice.from "classInventory")}}
            <select name="system.awards.{{index}}.choice.filter" aria-label="{{localize "ACKS-CLASSES.sheet.awardRow.filter"}}" data-tooltip="{{localize "ACKS-CLASSES.sheet.awardRow.filter"}}">
              {{#each filterOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
            </select>
            {{/if}}
            <input name="system.awards.{{index}}.choice.count" type="number" value="{{choice.count}}" min="1" aria-label="{{localize "ACKS-CLASSES.sheet.count"}}" data-tooltip="{{localize "ACKS-CLASSES.sheet.count"}}" />
            <input name="system.awards.{{index}}.choice.label" type="text" value="{{choice.label}}" placeholder="{{localize "ACKS-CLASSES.sheet.choiceLabel"}}" aria-label="{{localize "ACKS-CLASSES.sheet.choiceLabel"}}" />
