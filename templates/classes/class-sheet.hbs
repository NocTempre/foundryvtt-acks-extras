<div class="acks-extras-classes-root {{#if editable}}acks-extras-classes-editable{{/if}}">
<header class="acks-extras-classes-header">
  <img class="profile-img" src="{{item.img}}" data-edit="img" data-action="editImage" title="{{item.name}}" />
  <div class="acks-extras-classes-headmain">
    <input name="name" type="text" value="{{item.name}}" placeholder="{{localize "ACKS-CLASSES.sheet.name"}}" />
    <div class="acks-extras-classes-source">
      <label data-tooltip="{{localize "ACKS-CLASSES.sheet.keyHint"}}">{{localize "ACKS-CLASSES.sheet.key"}}</label>
      <input name="system.key" type="text" value="{{system.key}}" aria-label="{{localize "ACKS-CLASSES.sheet.key"}}" data-tooltip="{{localize "ACKS-CLASSES.sheet.keyHint"}}" />
      <label>{{localize "ACKS-CLASSES.sheet.cite"}}</label>
      <input name="system.source.cite" type="text" value="{{system.source.cite}}" aria-label="{{localize "ACKS-CLASSES.sheet.cite"}}" />
      <input name="system.source.book" type="hidden" value="{{system.source.book}}" />
      <input name="system.source.ref" type="hidden" value="{{system.source.ref}}" />
    </div>
  </div>
</header>

{{#if isStub}}<p class="notification info">{{localize "ACKS-CLASSES.sheet.stubNotice"}}</p>{{/if}}
{{#if keyMissing}}<p class="notification warning">{{localize "ACKS-CLASSES.sheet.keyMissing"}}</p>{{/if}}

<nav class="acks-extras-classes-tabs">
  {{#each tabs}}
    <button type="button" data-action="classTab" data-tab="{{id}}" class="{{#if active}}active{{/if}}">{{label}}</button>
  {{/each}}
</nav>

{{!-- Every ladder key this class already names, plus the keys apply.mjs reads
      as the damage bonus — offered wherever a field must match a ladder. --}}
<datalist id="{{@root.partId}}-ladder-keys">
  {{#each ladders}}<option value="{{key}}"></option>{{/each}}
  {{#each ladderKeyHints}}<option value="{{this}}"></option>{{/each}}
</datalist>

<div class="acks-extras-classes-body">

  <section class="acks-extras-classes-tabpane" {{#unless show.overview}}hidden{{/unless}}>
    <div class="form-group">
      <label>{{localize "ACKS-CLASSES.sheet.maximumLevel"}}</label>
      <input name="system.maximumLevel" type="number" value="{{system.maximumLevel}}" min="1" step="1" />
      <label>{{localize "ACKS-CLASSES.sheet.hitDie"}}</label>
      <input name="system.hitDie" type="text" value="{{system.hitDie}}" placeholder="1d8" />
    </div>
    <div class="form-group">
      {{!-- A caption over a group, not a label: each box below carries its own,
            and a label bound to the first of them would tick it. --}}
      <span class="acks-extras-caption">{{localize "ACKS-CLASSES.sheet.keyAttributes"}}</span>
      <div class="acks-extras-classes-checks">
        {{#each keyAttributes}}
          <label class="checkbox"><input type="checkbox" name="system.keyAttributes" value="{{value}}" {{#if checked}}checked{{/if}} /> {{label}}</label>
        {{/each}}
      </div>
    </div>
    <fieldset>
      <legend>{{localize "ACKS-CLASSES.sheet.requirements"}}
        <button type="button" class="acks-extras-classes-ctl" data-action="rowAdd" data-array="requirements" aria-label="{{localize "ACKS-CLASSES.sheet.ctl.add" what=(localize "ACKS-CLASSES.sheet.what.requirement")}}" data-tooltip="{{localize "ACKS-CLASSES.sheet.ctl.add" what=(localize "ACKS-CLASSES.sheet.what.requirement")}}"><i class="fa-solid fa-plus" inert></i></button></legend>
      {{#unless requirements.length}}<p class="hint">{{localize "ACKS-CLASSES.sheet.noRequirements"}}</p>{{/unless}}
      {{#each requirements}}
        <div class="acks-extras-classes-row">
          <select name="system.requirements.{{index}}.attr" aria-label="{{localize "ACKS-CLASSES.sheet.keyAttributes"}}">
            {{#each attrOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
          <input name="system.requirements.{{index}}.min" type="number" value="{{min}}" placeholder="{{localize "ACKS-CLASSES.sheet.min"}}" aria-label="{{localize "ACKS-CLASSES.sheet.min"}}" />
          <button type="button" class="acks-extras-classes-ctl" data-action="rowDelete" data-array="requirements" data-index="{{index}}" aria-label="{{localize "ACKS-CLASSES.sheet.ctl.remove" what=(localize "ACKS-CLASSES.sheet.what.requirement")}}" data-tooltip="{{localize "ACKS-CLASSES.sheet.ctl.remove" what=(localize "ACKS-CLASSES.sheet.what.requirement")}}"><i class="fa-solid fa-trash" inert></i></button>
        </div>
      {{/each}}
    </fieldset>
    <div class="form-group">
      <label>{{localize "ACKS-CLASSES.sheet.saveChassis"}}</label>
      <select name="system.saveChassis">
        {{#each saveChassisOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
      </select>
      <label>{{localize "ACKS-CLASSES.sheet.attackChassis"}}</label>
      <select name="system.attackChassis">
        {{#each attackChassisOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
      </select>
    </div>
    <fieldset data-class-training>
      <legend>{{localize "ACKS-CLASSES.sheet.training.legend"}}</legend>
      <p class="hint">{{localize "ACKS-CLASSES.sheet.training.hint"}}</p>
      <div class="form-group">
        <label>{{localize "ACKS-CLASSES.sheet.training.weapons"}}</label>
        <input name="training.weapons" type="text" value="{{training.weapons}}" placeholder="{{localize "ACKS-CLASSES.sheet.training.weaponsHint"}}" data-tooltip="{{localize "ACKS-CLASSES.sheet.training.weaponsHint"}}" />
      </div>
      <div class="form-group">
        <label>{{localize "ACKS-CLASSES.sheet.training.armour"}}</label>
        <select name="training.armour">
          {{#each training.armourOptions}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
        </select>
      </div>
      <div class="form-group">
        <label>{{localize "ACKS-CLASSES.sheet.training.styles"}}</label>
        <input name="training.styles" type="text" value="{{training.styles}}" placeholder="{{localize "ACKS-CLASSES.sheet.training.stylesHint"}}" data-tooltip="{{localize "ACKS-CLASSES.sheet.training.stylesHint"}}" />
      </div>
    </fieldset>
    <div class="form-group">
      <label class="checkbox" data-tooltip="{{localize "ACKS-CLASSES.sheet.factoredHint"}}">
        <input type="checkbox" name="system.factored" {{#if system.factored}}checked{{/if}} />
        {{localize "ACKS-CLASSES.sheet.factored"}}
      </label>
    </div>
    <div class="form-group">
      <label class="checkbox">
        <input type="checkbox" name="system.core" {{#if system.core}}checked{{/if}} />
        {{localize "ACKS-CLASSES.sheet.core"}}
      </label>
    </div>
    <div class="form-group">
      <label data-tooltip="{{localize "ACKS-CLASSES.sheet.sortOrderHint"}}">{{localize "ACKS-CLASSES.sheet.sortOrder"}}</label>
      <input name="system.sortOrder" type="number" value="{{system.sortOrder}}" min="0" step="1" />
      <p class="hint">{{localize "ACKS-CLASSES.sheet.sortOrderHint"}}</p>
    </div>
    <div class="form-group stacked">
      <label>{{localize "ACKS-CLASSES.sheet.description"}}</label>
      <prose-mirror name="system.description" value="{{prose.description.source}}" document-uuid="{{item.uuid}}" compact toggled>{{{prose.description.html}}}</prose-mirror>
    </div>
    <div class="form-group stacked">
      <label>{{localize "ACKS-CLASSES.sheet.codeOfBehavior"}}</label>
      <prose-mirror name="system.codeOfBehavior" value="{{prose.codeOfBehavior.source}}" document-uuid="{{item.uuid}}" compact toggled>{{{prose.codeOfBehavior.html}}}</prose-mirror>
    </div>
  </section>

  <section class="acks-extras-classes-tabpane" {{#unless show.builder}}hidden{{/unless}}>
    <div class="form-group">
      <label class="checkbox">
        <input type="checkbox" name="system.builder.enabled" {{#if builderState.enabled}}checked{{/if}} />
        {{localize "ACKS-CLASSES.builder.enabled"}}
      </label>
      <p class="hint">{{localize "ACKS-CLASSES.builder.enabledHint"}}</p>
    </div>
    {{#unless builderHasTables}}<p class="notification warning">{{localize "ACKS-CLASSES.builder.noTables"}}</p>{{/unless}}

    {{#if builderState.enabled}}
    {{#if builderSummary}}
      <fieldset>
        <legend>{{localize "ACKS-CLASSES.builder.summary"}}</legend>
        <p>
          {{localize "ACKS-CLASSES.builder.points"}}: {{builderSummary.points.spent}}{{#if builderSummary.points.base}} / {{builderSummary.points.base}}{{/if}}
          &nbsp;·&nbsp; {{localize "ACKS-CLASSES.builder.powersLeft"}}: {{builderSummary.powers.left}}
          &nbsp;·&nbsp; {{localize "ACKS-CLASSES.builder.baseXp"}}: {{builderSummary.baseXp}}
          &nbsp;·&nbsp; {{localize "ACKS-CLASSES.sheet.maximumLevel"}}: {{builderSummary.maxLevel}}
        </p>
        {{#if builderIssues.length}}
          <ul class="acks-extras-classes-issues">
            {{#each builderIssues}}<li>{{this}}</li>{{/each}}
          </ul>
        {{/if}}
        <button type="button" data-action="builderDerive" {{#unless builderHasTables}}disabled{{/unless}}>
          <i class="fa-solid fa-gears" inert></i> {{localize "ACKS-CLASSES.builder.derive"}}
        </button>
        <p class="hint">{{localize "ACKS-CLASSES.builder.deriveHint"}}</p>
      </fieldset>
    {{/if}}

    <fieldset>
      <legend>{{localize "ACKS-CLASSES.builder.categories"}}</legend>
      <div class="form-group">
        <label>{{localize "ACKS-CLASSES.builder.hdValue"}}</label>
        <input name="system.builder.hdValue" type="number" value="{{builderState.hdValue}}" min="0" step="1" />
        <label>{{localize "ACKS-CLASSES.builder.fightingValue"}}</label>
        <input name="system.builder.fighting.value" type="number" value="{{builderState.fighting.value}}" min="0" step="1" />
        <input name="system.builder.fighting.sub" type="text" value="{{builderState.fighting.sub}}" maxlength="1" placeholder="a/b" aria-label="{{localize "ACKS-CLASSES.builder.fightingSub"}}" data-tooltip="{{localize "ACKS-CLASSES.builder.fightingSub"}}" class="acks-extras-classes-subinput" />
        <label>{{localize "ACKS-CLASSES.builder.thieveryValue"}}</label>
        <input name="system.builder.thievery.value" type="number" value="{{builderState.thievery.value}}" min="0" step="1" />
      </div>
      <div class="form-group">
        <label data-tooltip="{{localize "ACKS-CLASSES.builder.damageBonusHint"}}">{{localize "ACKS-CLASSES.builder.damageBonus"}}</label>
        <input name="system.builder.fighting.damageBonus" type="text" value="{{builderState.fighting.damageBonus}}" />
        <p class="hint">{{localize "ACKS-CLASSES.builder.damageBonusHint"}}</p>
      </div>
    </fieldset>

    <fieldset>
      <legend>{{localize "ACKS-CLASSES.builder.magicValues"}}
        <button type="button" class="acks-extras-classes-ctl" data-action="rowAdd" data-array="builder.magic" aria-label="{{localize "ACKS-CLASSES.sheet.ctl.add" what=(localize "ACKS-CLASSES.sheet.what.magicValue")}}" data-tooltip="{{localize "ACKS-CLASSES.sheet.ctl.add" what=(localize "ACKS-CLASSES.sheet.what.magicValue")}}"><i class="fa-solid fa-plus" inert></i></button></legend>
      <p class="hint">{{localize "ACKS-CLASSES.builder.magicHint"}}</p>
      {{#each builderMagic}}
        <div class="acks-extras-classes-row">
          <input name="system.builder.magic.{{index}}.type" type="text" value="{{type}}" list="{{@root.partId}}-magic-types" placeholder="{{localize "ACKS-CLASSES.builder.magicType"}}" aria-label="{{localize "ACKS-CLASSES.builder.magicType"}}" />
          <span class="acks-extras-classes-refname">{{typeLabel}}</span>
          <input name="system.builder.magic.{{index}}.label" type="text" value="{{label}}" placeholder="{{localize "ACKS-CLASSES.sheet.label"}}" aria-label="{{localize "ACKS-CLASSES.sheet.label"}}" />
          <input name="system.builder.magic.{{index}}.value" type="number" value="{{value}}" min="0" step="1" aria-label="{{localize "ACKS-CLASSES.builder.value"}}" data-tooltip="{{localize "ACKS-CLASSES.builder.value"}}" />
          <label class="checkbox" data-tooltip="{{localize "ACKS-CLASSES.builder.delayedHint"}}">
            <input type="checkbox" name="system.builder.magic.{{index}}.delayed" {{#if delayed}}checked{{/if}} />
            {{localize "ACKS-CLASSES.builder.delayed"}}
          </label>
          <button type="button" class="acks-extras-classes-ctl" data-action="rowDelete" data-array="builder.magic" data-index="{{index}}" aria-label="{{localize "ACKS-CLASSES.sheet.ctl.remove" what=(localize "ACKS-CLASSES.sheet.what.magicValue")}}" data-tooltip="{{localize "ACKS-CLASSES.sheet.ctl.remove" what=(localize "ACKS-CLASSES.sheet.what.magicValue")}}"><i class="fa-solid fa-trash" inert></i></button>
        </div>
      {{/each}}
      <datalist id="{{@root.partId}}-magic-types">
        {{#each magicTypeKeys}}<option value="{{this}}"></option>{{/each}}
      </datalist>
    </fieldset>

    <fieldset>
      <legend>{{localize "ACKS-CLASSES.builder.race"}}</legend>
      <div class="form-group">
        <label>{{localize "ACKS-CLASSES.builder.raceDoc"}}</label>
        <select name="system.race">
          <option value="" {{#unless system.race}}selected{{/unless}}>—</option>
          {{#each builderRaces}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
        </select>
        <label>{{localize "ACKS-CLASSES.builder.racialValue"}}</label>
        <input name="system.builder.race.value" type="number" value="{{builderState.race.value}}" min="0" step="1" />
      </div>
      {{#if raceUnresolved}}<p class="notification warning">{{localize "ACKS-CLASSES.builder.raceUnresolved"}}</p>{{/if}}
    </fieldset>

    <fieldset>
      <legend>{{localize "ACKS-CLASSES.builder.thieverySkills"}}
        <button type="button" class="acks-extras-classes-ctl" data-action="rowAdd" data-array="builder.thievery.skills" aria-label="{{localize "ACKS-CLASSES.sheet.ctl.add" what=(localize "ACKS-CLASSES.sheet.what.builderSkill")}}" data-tooltip="{{localize "ACKS-CLASSES.sheet.ctl.add" what=(localize "ACKS-CLASSES.sheet.what.builderSkill")}}"><i class="fa-solid fa-plus" inert></i></button></legend>
      <div data-accept-drop data-list="builderSkills">
        <p class="hint">{{localize "ACKS-CLASSES.sheet.dropHere"}}</p>
        {{#each builderSkills}}
          <div class="acks-extras-classes-row">
            {{#if name}}<a class="acks-extras-classes-refname" data-action="refOpen" data-ref="{{ref}}" data-tooltip="{{localize "ACKS-CLASSES.sheet.refOpen"}}">{{name}}</a>
            {{else if ref}}<span class="acks-extras-classes-refname acks-extras-classes-refname--unresolved" data-tooltip="{{localize "ACKS-CLASSES.sheet.unresolvedRef"}}"><i class="fa-solid fa-triangle-exclamation" inert></i> {{ref}}</span>{{/if}}
            <input class="acks-extras-classes-ref" name="system.builder.thievery.skills.{{index}}" type="text" value="{{ref}}" placeholder="{{localize "ACKS-CLASSES.sheet.dropHint"}}" aria-label="{{localize "ACKS-CLASSES.sheet.refField"}}" data-tooltip="{{localize "ACKS-CLASSES.sheet.refField"}}" />
            <button type="button" class="acks-extras-classes-ctl" data-action="rowDelete" data-array="builder.thievery.skills" data-index="{{index}}" aria-label="{{localize "ACKS-CLASSES.sheet.ctl.remove" what=(localize "ACKS-CLASSES.sheet.what.builderSkill")}}" data-tooltip="{{localize "ACKS-CLASSES.sheet.ctl.remove" what=(localize "ACKS-CLASSES.sheet.what.builderSkill")}}"><i class="fa-solid fa-trash" inert></i></button>
          </div>
        {{/each}}
      </div>
    </fieldset>

    <fieldset>
      <legend>{{localize "ACKS-CLASSES.builder.tradeoffs"}}</legend>
      {{#unless builderTradeoffs.length}}<p class="hint">{{localize "ACKS-CLASSES.builder.noTradeoffs"}}</p>{{/unless}}
      <div class="acks-extras-classes-checks">
        {{#each builderTradeoffs}}
          <label class="checkbox"><input type="checkbox" name="system.builder.tradeoffs" value="{{key}}" {{#if checked}}checked{{/if}} /> {{label}}</label>
        {{/each}}
      </div>
      {{#if builderUnknownTradeoffs.length}}
        <p class="hint">{{localize "ACKS-CLASSES.builder.unknownTradeoffs"}}:
          {{#each builderUnknownTradeoffs}}<span class="acks-extras-classes-chip">{{this}}</span>{{/each}}</p>
      {{/if}}
    </fieldset>

    <fieldset data-accept-drop data-list="builderPowers">
      <legend>{{localize "ACKS-CLASSES.builder.powers"}}
        <button type="button" class="acks-extras-classes-ctl" data-action="rowAdd" data-array="builder.powers" aria-label="{{localize "ACKS-CLASSES.sheet.ctl.add" what=(localize "ACKS-CLASSES.sheet.what.builderPower")}}" data-tooltip="{{localize "ACKS-CLASSES.sheet.ctl.add" what=(localize "ACKS-CLASSES.sheet.what.builderPower")}}"><i class="fa-solid fa-plus" inert></i></button></legend>
      <p class="hint">{{localize "ACKS-CLASSES.sheet.dropHere"}}</p>
      {{#each builderPowers}}
        <div class="acks-extras-classes-row">
          {{#if refName}}<a class="acks-extras-classes-refname" data-action="refOpen" data-ref="{{ref}}" data-tooltip="{{localize "ACKS-CLASSES.sheet.refOpen"}}">{{refName}}</a>
          {{else if ref}}<span class="acks-extras-classes-refname acks-extras-classes-refname--unresolved" data-tooltip="{{localize "ACKS-CLASSES.sheet.unresolvedRef"}}"><i class="fa-solid fa-triangle-exclamation" inert></i> {{#if name}}{{name}}{{else}}{{ref}}{{/if}}</span>{{/if}}
          <input class="acks-extras-classes-ref" name="system.builder.powers.{{index}}.ref" type="text" value="{{ref}}" placeholder="{{localize "ACKS-CLASSES.sheet.dropHint"}}" aria-label="{{localize "ACKS-CLASSES.sheet.refField"}}" data-tooltip="{{localize "ACKS-CLASSES.sheet.refField"}}" />
          <input name="system.builder.powers.{{index}}.name" type="hidden" value="{{name}}" />
          <input name="system.builder.powers.{{index}}.cost" type="number" value="{{cost}}" step="0.5" aria-label="{{localize "ACKS-CLASSES.builder.powerCost"}}" data-tooltip="{{localize "ACKS-CLASSES.builder.powerCost"}}" />
          <input name="system.builder.powers.{{index}}.note" type="text" value="{{note}}" placeholder="{{localize "ACKS-CLASSES.sheet.note"}}" aria-label="{{localize "ACKS-CLASSES.sheet.note"}}" />
          <button type="button" class="acks-extras-classes-ctl" data-action="rowDelete" data-array="builder.powers" data-index="{{index}}" aria-label="{{localize "ACKS-CLASSES.sheet.ctl.remove" what=(localize "ACKS-CLASSES.sheet.what.builderPower")}}" data-tooltip="{{localize "ACKS-CLASSES.sheet.ctl.remove" what=(localize "ACKS-CLASSES.sheet.what.builderPower")}}"><i class="fa-solid fa-trash" inert></i></button>
        </div>
      {{/each}}
    </fieldset>

    <div class="form-group">
      <label data-tooltip="{{localize "ACKS-CLASSES.builder.xpAdjustmentHint"}}">{{localize "ACKS-CLASSES.builder.xpAdjustment"}}</label>
      <input name="system.builder.xpAdjustment" type="number" value="{{builderState.xpAdjustment}}" step="1" />
      <label>{{localize "ACKS-CLASSES.sheet.note"}}</label>
      <input name="system.builder.notes" type="text" value="{{builderState.notes}}" />
    </div>
    {{/if}}
  </section>

  <section class="acks-extras-classes-tabpane" {{#unless show.progression}}hidden{{/unless}}>
    <fieldset>
      <legend>{{localize "ACKS-CLASSES.sheet.levels"}}
        <button type="button" class="acks-extras-classes-ctl" data-action="rowAdd" data-array="levels" aria-label="{{localize "ACKS-CLASSES.sheet.ctl.add" what=(localize "ACKS-CLASSES.sheet.what.level")}}" data-tooltip="{{localize "ACKS-CLASSES.sheet.ctl.add" what=(localize "ACKS-CLASSES.sheet.what.level")}}"><i class="fa-solid fa-plus" inert></i></button></legend>
      <table class="acks-extras-classes-table">
        <tr><th>{{localize "ACKS-CLASSES.sheet.level"}}</th><th>{{localize "ACKS-CLASSES.sheet.xp"}}</th><th>{{localize "ACKS-CLASSES.sheet.title"}}</th><th>{{localize "ACKS-CLASSES.sheet.hd"}}</th><th></th></tr>
        {{#each levels}}
          <tr>
            <td><input name="system.levels.{{index}}.level" type="number" value="{{level}}" aria-label="{{localize "ACKS-CLASSES.sheet.level"}}" /></td>
            <td><input name="system.levels.{{index}}.xp" type="number" value="{{xp}}" class="acks-extras-classes-num-wide" aria-label="{{localize "ACKS-CLASSES.sheet.xp"}}" /></td>
            <td><input name="system.levels.{{index}}.title" type="text" value="{{title}}" aria-label="{{localize "ACKS-CLASSES.sheet.title"}}" /></td>
            <td><input name="system.levels.{{index}}.hd" type="text" value="{{hd}}" aria-label="{{localize "ACKS-CLASSES.sheet.hd"}}" /></td>
            <td><button type="button" class="acks-extras-classes-ctl" data-action="rowDelete" data-array="levels" data-index="{{index}}" aria-label="{{localize "ACKS-CLASSES.sheet.ctl.remove" what=(localize "ACKS-CLASSES.sheet.what.level")}}" data-tooltip="{{localize "ACKS-CLASSES.sheet.ctl.remove" what=(localize "ACKS-CLASSES.sheet.what.level")}}"><i class="fa-solid fa-trash" inert></i></button></td>
          </tr>
        {{/each}}
      </table>
    </fieldset>
    <fieldset>
      <legend>{{localize "ACKS-CLASSES.sheet.saves"}}
        <button type="button" class="acks-extras-classes-ctl" data-action="rowAdd" data-array="saves" aria-label="{{localize "ACKS-CLASSES.sheet.ctl.add" what=(localize "ACKS-CLASSES.sheet.what.saveBand")}}" data-tooltip="{{localize "ACKS-CLASSES.sheet.ctl.add" what=(localize "ACKS-CLASSES.sheet.what.saveBand")}}"><i class="fa-solid fa-plus" inert></i></button></legend>
      <table class="acks-extras-classes-table">
        <tr><th>{{localize "ACKS-CLASSES.sheet.minLevel"}}</th><th>{{localize "ACKS-CLASSES.sheet.maxLevel"}}</th><th>{{localize "ACKS-CLASSES.sheet.paralysis"}}</th><th>{{localize "ACKS-CLASSES.sheet.death"}}</th><th>{{localize "ACKS-CLASSES.sheet.blast"}}</th><th>{{localize "ACKS-CLASSES.sheet.implements"}}</th><th>{{localize "ACKS-CLASSES.sheet.spells"}}</th><th></th></tr>
        {{#each saves}}
          <tr>
            <td><input name="system.saves.{{index}}.minLevel" type="number" value="{{minLevel}}" aria-label="{{localize "ACKS-CLASSES.sheet.minLevel"}}" /></td>
            <td><input name="system.saves.{{index}}.maxLevel" type="number" value="{{maxLevel}}" aria-label="{{localize "ACKS-CLASSES.sheet.maxLevel"}}" /></td>
            <td><input name="system.saves.{{index}}.paralysis" type="number" value="{{paralysis}}" aria-label="{{localize "ACKS-CLASSES.sheet.paralysis"}}" /></td>
            <td><input name="system.saves.{{index}}.death" type="number" value="{{death}}" aria-label="{{localize "ACKS-CLASSES.sheet.death"}}" /></td>
            <td><input name="system.saves.{{index}}.blast" type="number" value="{{blast}}" aria-label="{{localize "ACKS-CLASSES.sheet.blast"}}" /></td>
            <td><input name="system.saves.{{index}}.implements" type="number" value="{{implements}}" aria-label="{{localize "ACKS-CLASSES.sheet.implements"}}" /></td>
            <td><input name="system.saves.{{index}}.spells" type="number" value="{{spells}}" aria-label="{{localize "ACKS-CLASSES.sheet.spells"}}" /></td>
            <td><button type="button" class="acks-extras-classes-ctl" data-action="rowDelete" data-array="saves" data-index="{{index}}" aria-label="{{localize "ACKS-CLASSES.sheet.ctl.remove" what=(localize "ACKS-CLASSES.sheet.what.saveBand")}}" data-tooltip="{{localize "ACKS-CLASSES.sheet.ctl.remove" what=(localize "ACKS-CLASSES.sheet.what.saveBand")}}"><i class="fa-solid fa-trash" inert></i></button></td>
          </tr>
        {{/each}}
      </table>
    </fieldset>
    <fieldset>
      <legend>{{localize "ACKS-CLASSES.sheet.attack"}}
        <button type="button" class="acks-extras-classes-ctl" data-action="rowAdd" data-array="attack" aria-label="{{localize "ACKS-CLASSES.sheet.ctl.add" what=(localize "ACKS-CLASSES.sheet.what.attackBand")}}" data-tooltip="{{localize "ACKS-CLASSES.sheet.ctl.add" what=(localize "ACKS-CLASSES.sheet.what.attackBand")}}"><i class="fa-solid fa-plus" inert></i></button></legend>
      <table class="acks-extras-classes-table">
