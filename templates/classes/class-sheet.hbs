            <input name="system.awards.{{index}}.name" type="hidden" value="{{name}}" />
          {{/if}}
          </div>
          <input name="system.awards.{{index}}.note" type="text" value="{{note}}" placeholder="{{localize "ACKS-CLASSES.sheet.note"}}" aria-label="{{localize "ACKS-CLASSES.sheet.note"}}" />
          <button type="button" class="acks-extras-classes-ctl" data-action="rowDelete" data-array="awards" data-index="{{index}}" data-confirm="award" aria-label="{{localize "ACKS-CLASSES.sheet.ctl.remove" what=(localize "ACKS-CLASSES.sheet.what.award")}}" data-tooltip="{{localize "ACKS-CLASSES.sheet.ctl.remove" what=(localize "ACKS-CLASSES.sheet.what.award")}}"><i class="fa-solid fa-trash" inert></i></button>
        </div>
      {{/each}}
