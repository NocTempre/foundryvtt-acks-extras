<div class="acks-equipment-loadout">
  <h3>{{localize "ACKS-EQUIPMENT.loadout.title" name=actorName}}</h3>
  <p>
    {{localize "ACKS-EQUIPMENT.loadout.hands"}}: <strong>{{loadout.handsUsed}}/{{loadout.handBudget}}</strong>
    · {{localize "ACKS-EQUIPMENT.loadout.style"}}: <strong>{{styleLabel}}</strong>
    {{#if loadout.styleProficient}}<span class="ok">({{localize "ACKS-EQUIPMENT.loadout.proficient"}})</span>{{else}}<span class="advisory">({{localize "ACKS-EQUIPMENT.loadout.untrained"}})</span>{{/if}}
  </p>
  <table>
    <thead><tr><th>{{localize "ACKS-EQUIPMENT.loadout.colWeapon"}}</th><th>{{localize "ACKS-EQUIPMENT.loadout.colSize"}}</th><th>{{localize "ACKS-EQUIPMENT.loadout.colHands"}}</th><th>{{localize "ACKS-EQUIPMENT.loadout.colWield"}}</th></tr></thead>
    <tbody>
      {{#each weapons}}
      <tr>
        <td>{{this.name}}</td>
        <td>{{this.size}}</td>
        <td>{{this.hands}}</td>
        <td>{{this.wield}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>
  <p>
    {{localize "ACKS-EQUIPMENT.loadout.armour"}}: <strong>{{armorName}}</strong>
    {{#if loadout.shield}} · {{localize "ACKS-EQUIPMENT.loadout.shield"}}: <strong>{{shieldName}}</strong>{{/if}}
    {{#if loadout.hasHelmet}} · {{localize "ACKS-EQUIPMENT.loadout.helmet"}}{{/if}}
  </p>
  {{#if violations.length}}
  <ul>
    {{#each violations}}
    <li class="{{#if this.advisory}}advisory{{else}}violation{{/if}}">{{this.message}}</li>
    {{/each}}
  </ul>
  {{else}}
  <p class="ok">{{localize "ACKS-EQUIPMENT.loadout.legal"}}</p>
  {{/if}}
</div>
