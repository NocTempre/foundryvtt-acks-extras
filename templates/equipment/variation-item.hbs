<section class="standard-form acks-extras-variation-body">

  <fieldset>
    <legend>{{localize 'ACKS-EQUIPMENT.variations.legendWhat'}}</legend>

    <div class="form-group">
      <label>{{localize 'ACKS-EQUIPMENT.variations.field.key'}}</label>
      <input type="text" name="system.key" value="{{system.key}}"
             data-dtype="String" {{#unless editable}}disabled{{/unless}}/>
      <p class="hint">{{localize 'ACKS-EQUIPMENT.variations.hint.key'}}</p>
    </div>

    <div class="form-group">
      <label>{{localize 'ACKS-EQUIPMENT.variations.field.kind'}}</label>
      <select name="system.kind" {{#unless editable}}disabled{{/unless}}>
        {{#each kindChoices}}
          <option value="{{this.value}}" {{#if (eq this.value ../system.kind)}}selected{{/if}}>{{this.label}}</option>
        {{/each}}
      </select>
    </div>

    <div class="form-group">
      <label>{{localize 'ACKS-EQUIPMENT.variations.field.appliesTo'}}</label>
      <input type="text" name="system.appliesTo" value="{{appliesToText}}"
             data-dtype="String" placeholder="{{baseTypeHint}}" {{#unless editable}}disabled{{/unless}}/>
      <p class="hint">{{localize 'ACKS-EQUIPMENT.variations.hint.appliesTo'}}</p>
    </div>

    <div class="form-group">
      <label>{{localize 'ACKS-EQUIPMENT.variations.field.supersedes'}}</label>
      <input type="text" name="system.supersedes" value="{{supersedesText}}"
             data-dtype="String" {{#unless editable}}disabled{{/unless}}/>
      <p class="hint">{{localize 'ACKS-EQUIPMENT.variations.hint.supersedes'}}</p>
    </div>
  </fieldset>

  <fieldset>
    <legend>{{localize 'ACKS-EQUIPMENT.variations.legendChanges'}}</legend>

    <div class="form-group">
      <label>{{localize 'ACKS-EQUIPMENT.variations.field.bonus'}}</label>
      <input type="number" name="system.deltas.bonus" value="{{system.deltas.bonus}}"
             data-dtype="Number" {{#unless editable}}disabled{{/unless}}/>
    </div>

    <div class="form-group">
      <label>{{localize 'ACKS-EQUIPMENT.variations.field.damage'}}</label>
      <input type="number" name="system.deltas.damage" value="{{system.deltas.damage}}"
             data-dtype="Number" {{#unless editable}}disabled{{/unless}}/>
    </div>

    <div class="form-group">
      <label>{{localize 'ACKS-EQUIPMENT.variations.field.ac'}}</label>
      <input type="number" name="system.deltas.ac" value="{{system.deltas.ac}}"
             data-dtype="Number" {{#unless editable}}disabled{{/unless}}/>
    </div>

    <div class="form-group">
      <label>{{localize 'ACKS-EQUIPMENT.variations.field.weight6'}}</label>
      <input type="number" name="system.deltas.weight6" value="{{system.deltas.weight6}}"
             data-dtype="Number" {{#unless editable}}disabled{{/unless}}/>
      <p class="hint">{{localize 'ACKS-EQUIPMENT.variations.hint.weight6'}}</p>
    </div>
  </fieldset>

  <fieldset>
    <legend>{{localize 'ACKS-EQUIPMENT.variations.legendCost'}}</legend>
    <p class="hint">{{localize 'ACKS-EQUIPMENT.variations.hint.costOrder'}}</p>

    <div class="form-group">
      <label>{{localize 'ACKS-EQUIPMENT.variations.field.costBaseMul'}}</label>
      <input type="number" name="system.cost.baseMul" value="{{system.cost.baseMul}}"
             data-dtype="Number" step="0.01" {{#unless editable}}disabled{{/unless}}/>
    </div>

    <div class="form-group">
      <label>{{localize 'ACKS-EQUIPMENT.variations.field.costAdd'}}</label>
      <input type="number" name="system.cost.add" value="{{system.cost.add}}"
             data-dtype="Number" step="0.01" {{#unless editable}}disabled{{/unless}}/>
    </div>

    <div class="form-group">
      <label>{{localize 'ACKS-EQUIPMENT.variations.field.costMul'}}</label>
      <input type="number" name="system.cost.mul" value="{{system.cost.mul}}"
             data-dtype="Number" step="0.01" {{#unless editable}}disabled{{/unless}}/>
    </div>
  </fieldset>

  <fieldset>
    <legend>{{localize 'ACKS-EQUIPMENT.variations.legendKnown'}}</legend>

    <div class="form-group">
      <label>{{localize 'ACKS-EQUIPMENT.variations.field.hidden'}}</label>
      <input type="checkbox" name="system.hidden" {{checked system.hidden}}
             {{#unless editable}}disabled{{/unless}}/>
      <p class="hint">{{localize 'ACKS-EQUIPMENT.variations.hint.hidden'}}</p>
    </div>

    <div class="form-group">
      <label>{{localize 'ACKS-EQUIPMENT.variations.field.read'}}</label>
      <input type="checkbox" name="system.read" {{checked system.read}}
             {{#unless editable}}disabled{{/unless}}/>
      <p class="hint">{{localize 'ACKS-EQUIPMENT.variations.hint.read'}}</p>
    </div>

    <div class="form-group">
      <label>{{localize 'ACKS-EQUIPMENT.variations.field.language'}}</label>
      <input type="text" name="system.language" value="{{system.language}}"
             data-dtype="String" {{#unless editable}}disabled{{/unless}}/>
      <p class="hint">{{localize 'ACKS-EQUIPMENT.variations.hint.language'}}</p>
    </div>
  </fieldset>

  <div class="form-group stacked">
    <label>{{localize 'ACKS-EQUIPMENT.variations.legendDescription'}}</label>
    {{!-- The sheet's ONLY render of system.description: a second control of the
          same name in one form is last-write-wins, and a prose-mirror has no
          `disabled`, so read-only falls through to the enriched render. --}}
    {{#if editable}}
    <prose-mirror class="acks-extras-variation-description content-sized" name="system.description"
                  value="{{system.description}}" toggled data-document-uuid="{{item.uuid}}"
                  style="--min-height: 4rem;">{{{descriptionHTML}}}</prose-mirror>
    {{else}}
    <div class="acks-extras-variation-description">{{{descriptionHTML}}}</div>
    {{/if}}
  </div>

</section>
