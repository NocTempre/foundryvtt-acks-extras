{{! The party tab's clock strip: the play surface in every mode. One strip, three
    branches on the mode — the delve's turn tracker, the journey's miles and
    clock, the city's block tally. Everyone sees the stats; the buttons and the
    mode picker are the Judge's. Included by path from formation-tab-party.hbs. }}
<section class="clock acks-extras-strip acks-extras-strip-{{strip.mode}}">
  {{#if isGM}}
  <div class="acks-extras-strip-mode">
    <label>{{localize "ACKS-FORMATION.travel.modeSelect"}}
      <select name="travel.mode">
        {{#each strip.modeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
      </select>
    </label>
    {{#if strip.isJourney}}
    <span class="acks-extras-formation-travel-daycount">{{localize "ACKS-FORMATION.travel.dayN" n=strip.dayCount}}</span>
    {{/if}}
  </div>
  {{/if}}

  {{#if strip.isJourney}}
  {{! ---- The journey: miles, the day's budget, the hex, the clock ---- }}
  <div class="stats acks-extras-strip-stats">
    <div class="stat" data-tooltip="{{strip.speed.partsLine}}">
      <span class="stat-label">{{localize "ACKS-FORMATION.strip.milesPerHour"}}</span>
      <span class="value">{{strip.speed.milesPerHour}}</span>
      <span class="sub">{{strip.speed.milesPerDay}} {{localize "ACKS-FORMATION.strip.milesPerDay"}}</span>
    </div>
    <div class="stat {{#if strip.spent}}quiet{{/if}}">
      <span class="stat-label">{{localize "ACKS-FORMATION.strip.walked"}}</span>
      <span class="value">{{strip.walked.miles}} {{localize "ACKS-FORMATION.travel.milesShort"}}</span>
      <span class="sub">{{strip.walked.hours}} h {{localize "ACKS-FORMATION.strip.ofBudget" hours=strip.budget.hours miles=strip.budget.miles}}</span>
    </div>
    <div class="stat">
      <span class="stat-label">{{localize "ACKS-FORMATION.travel.hex"}}</span>
      <span class="value">{{#if strip.hex.label}}{{strip.hex.label}}{{else}}—{{/if}}{{#if isGM}}{{#if travel.lost.active}} <i class="fa-solid fa-compass acks-extras-formation-travel-lost" data-tooltip="{{localize 'ACKS-FORMATION.travel.lostHint'}}"></i>{{/if}}{{/if}}</span>
      <span class="sub">{{localize "ACKS-FORMATION.travel.enteredToday" n=strip.hex.entered}}</span>
    </div>
    <div class="stat">
      <span class="stat-label">{{localize "ACKS-FORMATION.strip.nextThrow"}}</span>
      <span class="value">{{strip.cadence.next}}</span>
      {{#if strip.cadence.missing}}<span class="sub">{{localize "ACKS-FORMATION.strip.unpricedCadence"}}</span>{{/if}}
    </div>
    <div class="stat">
      <span class="stat-label">{{localize "ACKS-FORMATION.strip.clock"}}</span>
      <span class="value">{{#if strip.clock.time}}{{strip.clock.time}}{{else}}—{{/if}}</span>
      <span class="sub">
        <i class="fa-solid {{#if strip.clock.dark}}fa-moon{{else}}fa-sun{{/if}}"></i>
        {{#if strip.clock.hoursToDusk includeZero=true}}{{localize "ACKS-FORMATION.strip.toDusk" hours=strip.clock.hoursToDusk}}{{/if}}
        {{#if strip.clock.hoursToDawn includeZero=true}}{{localize "ACKS-FORMATION.strip.toDawn" hours=strip.clock.hoursToDawn}}{{/if}}
        {{#if strip.clock.overridden}}· {{strip.clock.hourLabel}}{{/if}}
      </span>
    </div>
    <div class="stat {{#if strip.supplies.short}}bad{{/if}}">
      <span class="stat-label">{{localize "ACKS-FORMATION.strip.supplies"}}</span>
      <span class="value">{{#if strip.supplies.known}}{{strip.supplies.foodDays}}{{else}}—{{/if}}</span>
      {{#if strip.supplies.known}}<span class="sub">{{localize "ACKS-FORMATION.strip.foodDays" days=strip.supplies.foodDays}} · {{localize "ACKS-FORMATION.strip.waterDays" days=strip.supplies.waterDays}}</span>{{/if}}
    </div>
  </div>
  {{#if strip.speed.camp}}<p class="hint">{{localize "ACKS-FORMATION.travel.campDay"}}</p>{{/if}}

  {{#if isGM}}
  <div class="buttons">
    <button type="button" data-action="travelEndDay" data-tooltip="{{localize 'ACKS-FORMATION.travel.endDayHint'}}">
      <i class="fa-solid fa-moon"></i> {{localize "ACKS-FORMATION.travel.endDay"}}
    </button>
    <button type="button" data-action="travelEncounterThrow" data-tooltip="{{localize 'ACKS-FORMATION.travel.enc.throwHint'}}">
      <i class="fa-solid fa-signs-post"></i> {{localize "ACKS-FORMATION.travel.enc.throw"}}
    </button>
    <button type="button" data-action="forageDay" data-tooltip="{{localize 'ACKS-FORMATION.forageRun.workHint'}}">
      <i class="fa-solid fa-wheat-awn"></i> {{localize "ACKS-FORMATION.forageRun.work"}}
    </button>
    <button type="button" data-action="searchHour" data-tooltip="{{localize 'ACKS-FORMATION.searchRun.searchHint'}}">
      <i class="fa-solid fa-magnifying-glass"></i> {{localize "ACKS-FORMATION.searchRun.search"}}
    </button>
    <button type="button" data-action="togglePause" class="{{#if strip.paused}}paused{{/if}}"
            data-tooltip="{{localize 'ACKS-FORMATION.app.pauseHint'}}">
      <i class="fa-solid {{#if strip.paused}}fa-play{{else}}fa-pause{{/if}}"></i>
    </button>
    <button type="button" data-action="dealXp" data-tooltip="{{localize 'ACKS-FORMATION.xp.hint'}}">
      <i class="fa-solid fa-star"></i> {{localize "ACKS-FORMATION.xp.deal"}}
    </button>
    <button type="button" data-action="adjustHp" data-tooltip="{{localize 'ACKS-FORMATION.app.adjustHpHint'}}">
      <i class="fa-solid fa-heart-pulse"></i> {{localize "ACKS-FORMATION.app.adjustHp"}}
    </button>
    <button type="button" data-action="consumeRations" data-tooltip="{{localize 'ACKS-FORMATION.app.rationsHint'}}">
      <i class="fa-solid fa-drumstick-bite"></i> {{localize "ACKS-FORMATION.app.rations"}}
    </button>
    <button type="button" data-action="disband" class="danger" data-tooltip="{{localize 'ACKS-FORMATION.app.disbandHint'}}">
      <i class="fa-solid fa-people-arrows"></i> {{localize "ACKS-FORMATION.app.disband"}}
    </button>
  </div>
  <div class="buttons acks-extras-formation-travel-hex">
    <input type="text" name="travel.hexLabel" value="{{strip.hex.label}}"
           aria-label="{{localize 'ACKS-FORMATION.travel.hex'}}"
           placeholder="{{localize 'ACKS-FORMATION.travel.hexPlaceholder'}}">
    <button type="button" data-action="travelEnterHex" data-tooltip="{{localize 'ACKS-FORMATION.travel.enterHexHint'}}">
      <i class="fa-solid fa-arrow-right"></i> {{localize "ACKS-FORMATION.travel.enterHex"}}
    </button>
    <label class="acks-extras-formation-camp-present"
           data-tooltip="{{localize 'ACKS-FORMATION.searchRun.presentHint'}}">
      {{localize "ACKS-FORMATION.searchRun.present"}}
      <select name="camp.present">
        {{#each travel.camp.presentOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
      </select>
    </label>
    <label class="acks-extras-formation-camp-target">
      {{localize "ACKS-FORMATION.searchRun.lookingFor"}}
      <select name="camp.target">
        {{#each travel.camp.targetOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
      </select>
    </label>
  </div>
  {{/if}}

  {{else}}
  {{! ---- The delve and the city: the turn tracker ---- }}
  <div class="stats">
    <div class="stat {{#if strip.delve.hurried}}quiet{{/if}}" data-tooltip="{{localize 'ACKS-FORMATION.app.speedHint'}}">
      <span class="stat-label">{{localize "ACKS-FORMATION.app.speed"}}</span>
      <span class="value">{{#if strip.delve.hurried}}{{strip.delve.effSpeed}}'{{else}}{{strip.delve.speed}}'{{/if}}</span>
      <span class="sub">{{#if strip.delve.hurried}}{{localize "ACKS-FORMATION.app.hurriedBadge"}}{{else}}{{localize "ACKS-FORMATION.app.perTurn"}} · {{strip.delve.combatSpeed}}' {{localize "ACKS-FORMATION.app.perRound"}}{{/if}}</span>
    </div>
    <div class="stat">
      <span class="stat-label">{{localize "ACKS-FORMATION.app.elapsed"}}</span>
      <span class="value">{{strip.delve.turns}}</span>
      <span class="sub">{{localize "ACKS-FORMATION.app.turns"}} ({{strip.delve.elapsed}}) · {{localize "ACKS-FORMATION.app.roundShort"}} {{strip.delve.roundsPartial}}/10</span>
    </div>
    <div class="stat {{#if strip.delve.winded}}bad{{/if}}">
      <span class="stat-label">{{localize "ACKS-FORMATION.app.rest"}}</span>
      <span class="value">{{strip.delve.sinceRest}}/{{strip.delve.restMax}}</span>
      <span class="sub">{{#if strip.delve.winded}}{{localize "ACKS-FORMATION.app.windedBadge"}}{{else}}{{localize "ACKS-FORMATION.app.sinceRest"}}{{/if}}</span>
    </div>
    <div class="stat">
      <span class="stat-label">{{localize "ACKS-FORMATION.app.carry"}}</span>
      <span class="value">{{strip.delve.carryFeet}}'</span>
      <span class="sub">{{localize "ACKS-FORMATION.app.carryHint"}}</span>
    </div>
  </div>
  {{#if strip.supplies.known}}
  <p class="hint acks-extras-strip-supplies {{#if strip.supplies.short}}acks-extras-formation-camp-short{{/if}}">
    {{localize "ACKS-FORMATION.strip.supplies"}}: {{localize "ACKS-FORMATION.strip.foodDays" days=strip.supplies.foodDays}} · {{localize "ACKS-FORMATION.strip.waterDays" days=strip.supplies.waterDays}}
  </p>
  {{/if}}

  {{#if strip.settlement}}
  <div class="acks-extras-strip-city">
    <p class="acks-extras-formation-travel-readout">
      {{#if strip.settlement.blocksUnpriced}}
        <span class="hint">{{localize "ACKS-FORMATION.settlement.blocksUnpriced"}}</span>
      {{else}}
        <strong>{{strip.settlement.rateBlocks}}</strong> {{localize "ACKS-FORMATION.settlement.blocks"}}
        {{#if strip.settlement.straggling}}
          · <span class="acks-extras-formation-settlement-straggle"
                  data-tooltip="{{localize 'ACKS-FORMATION.settlement.stragglingHeadcount' headcount=strip.settlement.headcount}}">{{localize "ACKS-FORMATION.settlement.straggling"}}</span>
        {{/if}}
      {{/if}}
    </p>
    {{#if isGM}}
    <p class="acks-extras-formation-settlement-progress">
      {{localize "ACKS-FORMATION.settlement.progress" blocks=strip.settlement.blocks turns=strip.settlement.turns}}
      {{#if strip.settlement.lost}}
      <span class="acks-extras-formation-settlement-astray">{{localize "ACKS-FORMATION.settlement.astray"}}</span>
      {{/if}}
    </p>
    {{/if}}
    {{#if strip.settlement.clockLine}}
    <p class="hint acks-extras-formation-settlement-clock">{{strip.settlement.clockLine}}</p>
    {{/if}}
    <p class="hint">
      {{#if strip.settlement.cadenceMissing}}
        {{localize "ACKS-FORMATION.settlement.cadenceMissing"}}
      {{else}}
        {{! Already formatted by the view: which layer set the interval and which
            set the target are two questions, and the answer can name two places.
            The card renders the same string from the same reader. }}
        {{#if strip.settlement.cadenceLine}}
          {{strip.settlement.cadenceLine}}
        {{else}}
          {{localize "ACKS-FORMATION.settlement.cadence" turns=strip.settlement.cadence.everyTurns target=strip.settlement.cadence.target}}
        {{/if}}
        {{#if strip.settlement.unpricedIntent}}
          <span class="hint">{{localize "ACKS-FORMATION.settlement.unpricedIntent"}}</span>
        {{/if}}
      {{/if}}
    </p>
  </div>
  {{/if}}

  {{#if isGM}}
  <div class="buttons">
    <button type="button" data-action="dealXp" data-tooltip="{{localize 'ACKS-FORMATION.xp.hint'}}">
      <i class="fa-solid fa-star"></i> {{localize "ACKS-FORMATION.xp.deal"}}
    </button>
    <button type="button" data-action="adjustHp" data-tooltip="{{localize 'ACKS-FORMATION.app.adjustHpHint'}}">
      <i class="fa-solid fa-heart-pulse"></i> {{localize "ACKS-FORMATION.app.adjustHp"}}
    </button>
    <button type="button" data-action="advanceTurn" data-tooltip="{{localize 'ACKS-FORMATION.app.advanceTurnHint'}}">
      <i class="fa-solid fa-hourglass-half"></i> {{localize "ACKS-FORMATION.app.advanceTurn"}}
    </button>
    <button type="button" data-action="advanceRound" data-tooltip="{{localize 'ACKS-FORMATION.app.advanceRoundHint'}}">
      <i class="fa-solid fa-hourglass-start"></i> {{localize "ACKS-FORMATION.app.advanceRound"}}
    </button>
    <button type="button" data-action="restTurn" data-tooltip="{{localize 'ACKS-FORMATION.app.restTurnHint'}}">
      <i class="fa-solid fa-campfire"></i> {{localize "ACKS-FORMATION.app.restTurn"}}
    </button>
    <button type="button" data-action="encounterNow" data-tooltip="{{localize 'ACKS-FORMATION.app.encounterNowHint'}}">
      <i class="fa-solid fa-dice-d6"></i> {{localize "ACKS-FORMATION.app.encounterNow"}}
    </button>
    <button type="button" data-action="consumeRations" data-tooltip="{{localize 'ACKS-FORMATION.app.rationsHint'}}">
      <i class="fa-solid fa-drumstick-bite"></i> {{localize "ACKS-FORMATION.app.rations"}}
    </button>
    <button type="button" data-action="undoTurn" data-tooltip="{{localize 'ACKS-FORMATION.app.undoTurnHint'}}">
      <i class="fa-solid fa-rotate-left"></i>
    </button>
    <button type="button" data-action="togglePause" class="{{#if strip.paused}}paused{{/if}}"
            data-tooltip="{{localize 'ACKS-FORMATION.app.pauseHint'}}">
      <i class="fa-solid {{#if strip.paused}}fa-play{{else}}fa-pause{{/if}}"></i>
    </button>
    <button type="button" data-action="togglePace" class="{{#if strip.delve.hurried}}paused{{/if}}"
            data-tooltip="{{localize 'ACKS-FORMATION.app.paceHint'}}">
      <i class="fa-solid {{#if strip.delve.hurried}}fa-person-running{{else}}fa-person-walking{{/if}}"></i>
    </button>
    {{#if strip.settlement.poiTargets}}
    <button type="button" data-action="settlementTravelTo"
            data-tooltip="{{localize 'ACKS-FORMATION.settlement.poi.travelHint'}}">
      <i class="fa-solid fa-person-walking-arrow-right"></i> {{localize "ACKS-FORMATION.settlement.poi.travel"}}
    </button>
    {{/if}}
    <button type="button" data-action="disband" class="danger" data-tooltip="{{localize 'ACKS-FORMATION.app.disbandHint'}}">
      <i class="fa-solid fa-people-arrows"></i> {{localize "ACKS-FORMATION.app.disband"}}
    </button>
  </div>
  {{/if}}
  {{/if}}

  {{#if isGM}}
  <div class="buttons saves-row">
    <span class="save-label">{{localize "ACKS-FORMATION.app.partySave"}}</span>
    {{#each saves}}
    <button type="button" data-action="partySave" data-save="{{this.key}}" data-tooltip="{{this.tooltip}}">
      {{this.label}}
    </button>
    {{/each}}
    <label class="magical-toggle" data-tooltip="{{localize 'ACKS-FORMATION.app.magicalHint'}}">
      <input type="checkbox" class="save-magical" checked />
      {{localize "ACKS-FORMATION.app.magical"}}
    </label>
  </div>
  <div class="buttons saves-row">
    <span class="save-label">{{localize "ACKS-FORMATION.rolls.rowLabel"}}</span>
    {{#each checks}}
    <button type="button" data-action="partyCheck" data-check="{{this.key}}" data-tooltip="{{this.hint}}">
      <i class="fa-solid {{this.icon}}"></i> {{this.label}}
    </button>
    {{/each}}
  </div>
  {{/if}}
</section>
