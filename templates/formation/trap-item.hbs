<section class="standard-form acks-extras-trap-body">

  <fieldset>
    <legend>{{localize 'ACKS-FORMATION.traps.legendWhat'}}</legend>

    <div class="form-group">
      <label>{{localize 'ACKS-FORMATION.traps.field.trigger'}}</label>
      <input type="text" name="system.trigger" value="{{system.trigger}}"
             data-dtype="String" {{#unless editable}}disabled{{/unless}}/>
      <p class="hint">{{localize 'ACKS-FORMATION.traps.hint.trigger'}}</p>
    </div>

    <div class="form-group">
      <label>{{localize 'ACKS-FORMATION.traps.field.triggerOn'}}</label>
      <input type="number" name="system.triggerOn" value="{{system.triggerOn}}"
             placeholder="{{triggerOnPlaceholder}}" data-dtype="Number" min="0"
             {{#if triggerMax}}max="{{triggerMax}}"{{/if}} {{#unless editable}}disabled{{/unless}}/>
      <p class="hint">{{localize 'ACKS-FORMATION.traps.hint.triggerOn'}}</p>
      {{!-- The band in force, as a figure: the typed one, else the imported one. --}}
      <p class="hint acks-extras-trap-band" data-tooltip-text="{{triggerBand.tip}}">
        {{localize 'ACKS-FORMATION.traps.bandInForce'}}
        <span class="acks-extras-trap-figure">{{triggerBand.text}}</span>
      </p>
    </div>

    <div class="form-group">
      <label>{{localize 'ACKS-FORMATION.traps.field.crude'}}</label>
      <input type="checkbox" name="system.crude" {{checked system.crude}}
             data-dtype="Boolean" {{#unless editable}}disabled{{/unless}}/>
      <p class="hint">{{localize 'ACKS-FORMATION.traps.hint.crude'}}</p>
    </div>
  </fieldset>

  <fieldset>
    <legend>{{localize 'ACKS-FORMATION.traps.legendLevel'}}</legend>

    <div class="form-group">
      <label>{{localize 'ACKS-FORMATION.traps.field.level'}}</label>
      <input type="number" name="system.level" value="{{system.level}}"
             data-dtype="Number" min="1" max="{{levelMax}}" {{#unless editable}}disabled{{/unless}}/>
      <p class="hint">{{localize 'ACKS-FORMATION.traps.hint.level'}}</p>
    </div>

    {{!-- Which levels this trap actually states something for. An imported trap
          fills all six; a hand-made one usually fills the one being played. --}}
    {{!-- Each step says its state in words for assistive technology and in a
          tooltip; the line under the strip says it in text for everyone. --}}
    <ol class="acks-extras-trap-strip" aria-label="{{localize 'ACKS-FORMATION.traps.strip.label'}}">
      {{#each levelStrip}}
        <li class="{{#if current}}is-current{{/if}} {{#if stated}}is-stated{{else}}is-blank{{/if}}"
            {{#if current}}aria-current="step"{{/if}} data-tooltip-text="{{label}}">
          <span aria-hidden="true">{{level}}</span>
          <span class="acks-extras-trap-sr">{{label}}</span>
        </li>
      {{/each}}
    </ol>
    <p class="hint acks-extras-trap-strip-state" data-tooltip="ACKS-FORMATION.traps.strip.summaryTip">{{levelSummary}}</p>
    <p class="hint">{{localize 'ACKS-FORMATION.traps.hint.levelStrip'}}</p>

    {{!-- The book's own sentence for this level, kept whole beside the typed
          fields the import could read out of it. --}}
    <div class="form-group stacked">
      <label>{{localize 'ACKS-FORMATION.traps.field.tierText'}}</label>
      <textarea name="{{tierPath}}.text" rows="2"
                {{#unless editable}}disabled{{/unless}}>{{tier.text}}</textarea>
      <p class="hint">{{localize 'ACKS-FORMATION.traps.hint.tierText'}}</p>
    </div>
  </fieldset>

  <fieldset>
    <legend>{{localize 'ACKS-FORMATION.traps.legendResolve'}}</legend>

    <div class="form-group">
      <label>{{localize 'ACKS-FORMATION.traps.field.resolution'}}</label>
      <select name="{{tierPath}}.resolution" data-dtype="String"
              {{#unless editable}}disabled{{/unless}}>
        {{selectOptions resolutionChoices valueAttr="value" labelAttr="label" selected=tier.resolution}}
      </select>
    </div>

    {{#if isSave}}
      <div class="form-group">
        <label>{{localize 'ACKS-FORMATION.traps.field.saveKey'}}</label>
        <select name="{{tierPath}}.saveKey" data-dtype="String"
                {{#unless editable}}disabled{{/unless}}>
          {{selectOptions saveChoices valueAttr="value" labelAttr="label" selected=tier.saveKey}}
        </select>
      </div>
      <div class="form-group">
        <label>{{localize 'ACKS-FORMATION.traps.field.onSuccess'}}</label>
        <select name="{{tierPath}}.onSuccess" data-dtype="String"
                {{#unless editable}}disabled{{/unless}}>
          {{selectOptions onSuccessChoices valueAttr="value" labelAttr="label" selected=tier.onSuccess}}
        </select>
        <p class="hint">{{localize 'ACKS-FORMATION.traps.hint.onSuccess'}}</p>
      </div>
    {{/if}}

    {{#if isAttack}}
      <div class="form-group">
        <label>{{localize 'ACKS-FORMATION.traps.field.attackThrow'}}</label>
        <input type="number" name="{{tierPath}}.attackThrow" value="{{tier.attackThrow}}"
               data-dtype="Number" min="0" max="30" {{#unless editable}}disabled{{/unless}}/>
        <p class="hint">{{localize 'ACKS-FORMATION.traps.hint.attackThrow'}}</p>
      </div>
    {{/if}}
  </fieldset>

  <fieldset>
    <legend>{{localize 'ACKS-FORMATION.traps.legendEffect'}}</legend>

    <div class="form-group">
      <label>{{localize 'ACKS-FORMATION.traps.field.damageFormula'}}</label>
      <input type="text" name="{{tierPath}}.damageFormula" value="{{tier.damageFormula}}"
             data-dtype="String" {{#unless editable}}disabled{{/unless}}/>
      <p class="hint">{{localize 'ACKS-FORMATION.traps.hint.damageFormula'}}</p>
    </div>

    <div class="form-group">
      <label>{{localize 'ACKS-FORMATION.traps.field.pitDepthFeet'}}</label>
      <input type="number" name="{{tierPath}}.pitDepthFeet" value="{{tier.pitDepthFeet}}"
             data-dtype="Number" min="0" max="500" {{#unless editable}}disabled{{/unless}}/>
      <p class="hint">{{localize 'ACKS-FORMATION.traps.hint.pitDepthFeet'}}</p>
    </div>

    {{#if tier.pitDepthFeet}}
      <div class="form-group">
        <label>{{localize 'ACKS-FORMATION.traps.field.spiked'}}</label>
        <input type="checkbox" name="{{tierPath}}.spiked" {{checked tier.spiked}}
               data-dtype="Boolean" {{#unless editable}}disabled{{/unless}}/>
        <p class="hint">{{localize 'ACKS-FORMATION.traps.hint.spiked'}}</p>
      </div>
    {{/if}}

    {{!-- Stays with a pit depth whatever is imported: the figure is blank where
          no dice are known, and the tooltip carries the page. --}}
    {{#if pitLine}}
      <p class="hint acks-extras-trap-derived" data-tooltip-text="{{pitLine.tip}}">
        {{localize 'ACKS-FORMATION.traps.derivedDamage'}}
        <span class="acks-extras-trap-figure">{{pitLine.formula}}</span>
      </p>
    {{/if}}
  </fieldset>

  <fieldset>
    <legend>{{localize 'ACKS-FORMATION.traps.legendWho'}}</legend>

    <div class="form-group">
      <label>{{localize 'ACKS-FORMATION.traps.field.scope'}}</label>
      <select name="system.scope" data-dtype="String"
              {{#unless editable}}disabled{{/unless}}>
        {{selectOptions scopeChoices valueAttr="value" labelAttr="label" selected=system.scope}}
      </select>
    </div>

    {{#if isArea}}
      <div class="form-group">
        <label>{{localize 'ACKS-FORMATION.traps.field.radiusFeet'}}</label>
        <input type="number" name="{{tierPath}}.radiusFeet" value="{{tier.radiusFeet}}"
               data-dtype="Number" min="0" max="200" {{#unless editable}}disabled{{/unless}}/>
        <p class="hint">{{localize 'ACKS-FORMATION.traps.hint.radiusFeet'}}</p>
      </div>
    {{/if}}

    <div class="form-group">
      <label>{{localize 'ACKS-FORMATION.traps.field.rider'}}</label>
      <input type="text" name="{{tierPath}}.rider" value="{{tier.rider}}"
             data-dtype="String" {{#unless editable}}disabled{{/unless}}/>
      <p class="hint">{{localize 'ACKS-FORMATION.traps.hint.rider'}}</p>
    </div>
  </fieldset>

  <div class="form-group stacked">
    <label>{{localize 'ACKS-FORMATION.traps.field.description'}}</label>
    {{!-- The sheet's ONLY render of system.description: a second control of the
          same name in one form is last-write-wins, and a prose-mirror has no
          `disabled`, so read-only falls through to the enriched render. --}}
    {{#if editable}}
    <prose-mirror class="acks-extras-trap-description content-sized" name="system.description"
                  value="{{system.description}}" toggled data-document-uuid="{{item.uuid}}">{{{descriptionHTML}}}</prose-mirror>
    {{else}}
    <div class="acks-extras-trap-description">{{{descriptionHTML}}}</div>
    {{/if}}
  </div>

</section>
