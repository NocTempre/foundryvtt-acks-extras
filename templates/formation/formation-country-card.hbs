{{!-- One reading of the country under the party (a `buildCountryView` card):
      its swatch, its name and the value read; on a card built for the Judge
      (`judge`), the source that answered it, the chip that source earns with
      the clear that retires the word behind it, and the brush for a hex the
      map has not painted on the card's layer. --}}
<div class="acks-extras-country-card" data-key="{{key}}">
  <span class="acks-extras-country-swatch{{#unless swatch}} is-empty{{/unless}}"{{#if swatch}} style="--acks-extras-country-swatch: {{swatch}}"{{/if}} inert></span>
  <div class="acks-extras-country-text">
    <span class="acks-extras-country-label">{{label}}</span>
    <span class="acks-extras-country-value">{{valueLabel}}</span>
    {{#if judge}}
    <span class="acks-extras-country-source" data-provenance="{{provenance}}">{{provenanceLabel}}</span>
    {{/if}}
  </div>
  {{#if judge}}
  <div class="acks-extras-country-chips">
    {{#if (eq chip "override")}}
    <span class="acks-extras-country-chip is-override"
          data-tooltip="{{localize 'ACKS-FORMATION.country.chip.overrideHint' map=mapLabel}}">
      {{localize "ACKS-FORMATION.country.chip.override"}}
      <button type="button" class="acks-extras-country-clear" data-action="clearOverride" data-key="{{key}}"
              aria-label="{{localize 'ACKS-FORMATION.country.chip.clear'}}"
              data-tooltip="{{localize 'ACKS-FORMATION.country.chip.clear'}}"><i class="fa-solid fa-xmark" inert></i></button>
    </span>
    {{else if (eq chip "declared")}}
    <span class="acks-extras-country-chip is-declared"
          data-tooltip="{{localize 'ACKS-FORMATION.country.chip.declared'}}">
      <i class="fa-solid fa-pen-nib" inert></i>
      <button type="button" class="acks-extras-country-clear" data-action="{{clearAction}}" data-key="{{key}}"
              aria-label="{{localize 'ACKS-FORMATION.country.chip.clearDeclared'}}"
              data-tooltip="{{localize 'ACKS-FORMATION.country.chip.clearDeclared'}}"><i class="fa-solid fa-xmark" inert></i></button>
    </span>
    {{/if}}
    {{#if paintable}}
    <button type="button" class="acks-extras-country-chip is-paint" data-action="paintThisHex"
            data-layer="{{paintLayer}}" data-brush="{{paintBrush}}"
            data-tooltip="{{localize 'ACKS-FORMATION.country.paintHint'}}">
      <i class="fa-solid fa-paintbrush" inert></i> {{localize "ACKS-FORMATION.country.paint"}}
    </button>
    {{/if}}
  </div>
  {{/if}}
</div>
