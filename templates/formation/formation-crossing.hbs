{{!-- The crossing: the party's way over one obstacle or gap, a member at a time.
      The Judge always has the begin row; every seat has the member rows while a
      crossing is open, the Judge the setup fields too. A figure nobody imported
      is blank and its tooltip is the page reference alone. A swim crossing has its own setup
      and rows (the Rescuer select is a staging pick bound by `bindCrossingRescuer`). A label wraps its
      control, so no control needs an id of its own. --}}
{{#if crossing}}
<section class="acks-extras-crossing">
  <h3>{{localize "ACKS-FORMATION.crossing.title"}}</h3>

  {{#unless crossing.open}}
  <div class="acks-extras-crossing-begin">
    <label class="acks-extras-crossing-field">
      <span>{{localize "ACKS-FORMATION.crossing.kindLabel"}}</span>
      <select data-pick="crossing-kind">
        {{#each crossing.kinds}}
        <option value="{{this.value}}">{{this.label}}</option>
        {{/each}}
      </select>
    </label>
    <button type="button" data-action="crossingBegin" aria-label="{{localize 'ACKS-FORMATION.crossing.beginHint'}}" data-tooltip="">
      <i class="fa-solid fa-route" inert></i> {{localize "ACKS-FORMATION.crossing.begin"}}
    </button>
  </div>
  {{else}}

  <div class="acks-extras-crossing-head">
    <strong class="acks-extras-crossing-kind">{{crossing.kindLabel}}</strong>
    {{#if crossing.isGM}}
    <span class="acks-extras-crossing-head-actions">
      {{#if crossing.canThrowAll}}
      <button type="button" data-action="crossingThrowAll" aria-label="{{localize 'ACKS-FORMATION.crossing.throwAllHint'}}" data-tooltip="">
        <i class="fa-solid fa-dice-d20" inert></i> {{localize "ACKS-FORMATION.crossing.throwAll"}}
      </button>
      {{/if}}
      <button type="button" data-action="crossingEnd" aria-label="{{localize 'ACKS-FORMATION.crossing.endHint'}}" data-tooltip="">
        <i class="fa-solid fa-flag-checkered" inert></i> {{localize "ACKS-FORMATION.crossing.end"}}
      </button>
    </span>
    {{/if}}
  </div>

  {{#if crossing.isGM}}
  <div class="acks-extras-crossing-setup">
    {{#if crossing.swim}}
    <fieldset class="acks-extras-crossing-water">
      <legend>{{localize "ACKS-FORMATION.crossing.swim.conditions"}}</legend>
      {{#each crossing.swim.conditions}}
      <label class="acks-extras-crossing-check" data-tooltip-text="{{this.tip}}">
        <input type="checkbox" name="crossing.{{this.field}}"{{#if this.checked}} checked{{/if}}>
        <span>{{this.label}}</span>
      </label>
      {{/each}}
    </fieldset>
    <label class="acks-extras-crossing-field" data-tooltip-text="{{crossing.swim.penaltyTip}}">
      <span>{{localize "ACKS-FORMATION.crossing.swim.penalty"}}</span>
      <select name="crossing.penaltyPick">
        {{#each crossing.swim.penaltyOptions}}
        <option value="{{this.value}}"{{#if this.selected}} selected{{/if}}>{{this.label}}</option>
        {{/each}}
      </select>
    </label>
    <label class="acks-extras-crossing-field" data-tooltip-text="{{crossing.swim.penaltyTip}}">
      <span>{{localize "ACKS-FORMATION.crossing.swim.largerField"}}</span>
      <input type="number" name="crossing.penaltyLarger" value="{{crossing.swim.larger.value}}" min="0" step="any"{{#unless crossing.swim.larger.enabled}} disabled{{/unless}}>
    </label>
    <label class="acks-extras-crossing-field" data-tooltip-text="{{crossing.swim.refs.swimming}}">
      <span>{{localize "ACKS-FORMATION.crossing.swim.movement"}}</span>
      <select name="crossing.movement">
        {{#each crossing.swim.movement}}
        <option value="{{this.value}}"{{#if this.selected}} selected{{/if}}>{{this.label}}</option>
        {{/each}}
      </select>
    </label>
    <label class="acks-extras-crossing-field" data-tooltip="{{localize 'ACKS-FORMATION.crossing.tip.judgeSet'}}">
      <span>{{localize "ACKS-FORMATION.crossing.judgeMod"}}</span>
      <input type="number" name="crossing.judgeMod" value="{{crossing.swim.judgeMod}}" step="1">
    </label>
    {{else if crossing.squeeze}}
    <fieldset class="acks-extras-crossing-water" data-tooltip-text="{{crossing.squeeze.shapeTip}}">
      <legend>{{localize "ACKS-FORMATION.crossing.squeeze.shape.label"}}</legend>
      {{#each crossing.squeeze.shapes}}
      <label class="acks-extras-crossing-check">
        <input type="radio" name="crossing.shape" value="{{this.value}}"{{#if this.checked}} checked{{/if}}>
        <span>{{this.label}}</span>
      </label>
      {{/each}}
    </fieldset>
    <label class="acks-extras-crossing-field" data-tooltip-text="{{crossing.squeeze.lengthTip}}">
      <span>{{localize "ACKS-FORMATION.crossing.length"}}</span>
      <input type="number" name="crossing.length" value="{{crossing.squeeze.length}}" min="0" step="any">
    </label>
    <label class="acks-extras-crossing-field" data-tooltip="{{localize 'ACKS-FORMATION.crossing.tip.judgeSet'}}">
      <span>{{localize "ACKS-FORMATION.crossing.judgeMod"}}</span>
      <input type="number" name="crossing.judgeMod" value="{{crossing.squeeze.judgeMod}}" step="1">
    </label>
    {{else if crossing.jump}}
    <label class="acks-extras-crossing-field" data-tooltip-text="{{crossing.refs.jumping}}">
      <span>{{localize "ACKS-FORMATION.crossing.gap"}}</span>
      <input type="number" name="crossing.gap" value="{{crossing.setup.gap}}" min="0" step="any">
    </label>
    <label class="acks-extras-crossing-check" data-tooltip-text="{{crossing.refs.jumping}}">
      <input type="checkbox" name="crossing.runUp"{{#if crossing.setup.runUp}} checked{{/if}}>
      <span>{{localize "ACKS-FORMATION.crossing.runUp"}}</span>
    </label>
    <label class="acks-extras-crossing-check" data-tooltip-text="{{crossing.refs.jumping}}">
      <input type="checkbox" name="crossing.precarious"{{#if crossing.setup.precarious}} checked{{/if}}>
      <span>{{localize "ACKS-FORMATION.crossing.precarious"}}</span>
    </label>
    <label class="acks-extras-crossing-check" data-tooltip-text="{{crossing.refs.jumping}}">
      <input type="checkbox" name="crossing.charging"{{#if crossing.setup.charging}} checked{{/if}}>
      <span>{{localize "ACKS-FORMATION.crossing.charging"}}</span>
    </label>
    <label class="acks-extras-crossing-field" data-tooltip-text="{{crossing.refs.jumping}}">
      <span>{{localize "ACKS-FORMATION.crossing.depth"}}</span>
      <input type="number" name="crossing.depth" value="{{crossing.setup.depth}}" min="0" step="any">
    </label>
    <label class="acks-extras-crossing-check" data-tooltip-text="{{crossing.refs.spelunking}}">
      <input type="checkbox" name="crossing.ropeFixed"{{#if crossing.setup.ropeFixed}} checked{{/if}}>
      <span>{{localize "ACKS-FORMATION.crossing.ropeFixed"}}</span>
    </label>
    {{else}}
    <label class="acks-extras-crossing-field" data-tooltip-text="{{crossing.refs.spelunking}}">
      <span>{{localize "ACKS-FORMATION.crossing.length"}}</span>
      <input type="number" name="crossing.length" value="{{crossing.setup.length}}" min="0" step="any">
    </label>
    <label class="acks-extras-crossing-field" data-tooltip-text="{{crossing.refs.spelunking}}">
      <span>{{localize "ACKS-FORMATION.crossing.depth"}}</span>
      <input type="number" name="crossing.depth" value="{{crossing.setup.depth}}" min="0" step="any">
    </label>
    <label class="acks-extras-crossing-check" data-tooltip-text="{{crossing.refs.spelunking}}">
      <input type="checkbox" name="crossing.ropeFixed"{{#if crossing.setup.ropeFixed}} checked{{/if}}>
      <span>{{localize "ACKS-FORMATION.crossing.ropeFixed"}}</span>
    </label>
    <label class="acks-extras-crossing-field" data-tooltip="{{localize 'ACKS-FORMATION.crossing.tip.judgeSet'}}">
      <span>{{localize "ACKS-FORMATION.crossing.judgeMod"}}</span>
      <input type="number" name="crossing.judgeMod" value="{{crossing.setup.judgeMod}}" step="1">
    </label>
    {{/if}}
  </div>
  {{/if}}

  {{#if crossing.swim}}
  {{#unless crossing.isGM}}
  <div class="acks-extras-crossing-inforce" data-tooltip-text="{{crossing.swim.penaltyTip}}">{{crossing.swim.inForce}}</div>
  {{/unless}}
  {{#if crossing.swim.roundLabel}}
  <div class="acks-extras-crossing-round">
    <span data-tooltip="{{localize 'ACKS-FORMATION.crossing.swim.tip.round'}}">{{crossing.swim.roundLabel}}</span>
    <span>{{localize "ACKS-FORMATION.crossing.swim.prompting"}}</span>
  </div>
  {{/if}}
  {{/if}}

  {{#if crossing.rows.length}}
  <ul class="acks-extras-crossing-rows">
    {{#if crossing.swim}}
    {{#each crossing.rows}}
    <li class="acks-extras-crossing-row" data-state="{{this.state}}" data-press-home="{{this.actorId}}" tabindex="-1">
      <span class="acks-extras-crossing-name">{{this.name}}{{#if this.yours}} <span class="acks-extras-crossing-yours">{{localize "ACKS-FORMATION.crossing.swim.yours"}}</span>{{/if}}{{#if this.holdsLabel}} <span class="acks-extras-crossing-badge" data-tooltip-text="{{this.badgeTip}}">{{this.holdsLabel}}</span>{{/if}}</span>
      {{#if this.can}}
      <button type="button" data-action="crossingThrow" data-actor-id="{{this.actorId}}"
              aria-label="{{localize 'ACKS-FORMATION.crossing.throwFor' name=this.name}}" data-tooltip="">
        <i class="fa-solid fa-dice-d20" inert></i> {{#if this.warn}}{{localize "ACKS-FORMATION.crossing.throwAnyway"}}{{else}}{{localize "ACKS-FORMATION.crossing.throw"}}{{/if}}
      </button>
      {{/if}}
      <span class="acks-extras-crossing-cells">
      {{#if this.noThrow}}
      <span class="acks-extras-crossing-nothrow" data-tooltip-text="{{this.targetTip}}">{{this.noThrow}}</span>
      {{else}}{{#unless this.sinking}}
      <span class="acks-nums acks-extras-crossing-figure" data-tooltip-text="{{this.targetTip}}">{{this.target}}</span>
      {{/unless}}{{/if}}
      <span class="acks-extras-crossing-state{{#if this.sinking}} is-drowning{{/if}}" data-tooltip-text="{{this.stateTip}}">{{this.stateLabel}}</span>
      {{#if this.pace.tip}}<span class="acks-nums acks-extras-crossing-pace" data-tooltip-text="{{this.pace.tip}}">{{this.pace.text}}</span>{{/if}}
      {{#if this.drown}}
      <span class="acks-nums acks-extras-crossing-breath" data-tooltip-text="{{this.drown.breath.tip}}">{{this.drown.breath.text}}</span>
      <span class="acks-nums acks-extras-crossing-sinks" data-tooltip-text="{{this.drown.sinks.tip}}">{{this.drown.sinks.text}}</span>
      {{/if}}
      {{#each this.implied}}
      <span class="acks-extras-crossing-held" data-status="{{this.statusId}}" data-tooltip-text="{{this.tip}}">{{this.label}}</span>
      {{/each}}
      {{#if this.last}}
      <span class="acks-nums acks-extras-crossing-last" data-tooltip-text="{{this.last.tip}}">{{this.last.text}}</span>
      {{/if}}
      {{#if this.said}}<span class="acks-extras-crossing-block{{#if this.warn}} is-warn{{/if}}">{{this.said}}</span>{{/if}}
      {{#if this.rescue}}
      <span class="acks-extras-crossing-rescue">
        {{#if this.rescue.canSet}}
        <label class="acks-extras-crossing-field" data-tooltip-text="{{this.rescue.tip}}">
          <span>{{localize "ACKS-FORMATION.crossing.swim.rescuer"}}</span>
          <select data-pick="crossing-rescuer-{{this.actorId}}" data-rescue-for="{{this.actorId}}">
            {{#each this.rescue.options}}
            <option value="{{this.value}}"{{#if this.selected}} selected{{/if}}>{{this.label}}</option>
            {{/each}}
          </select>
        </label>
        {{else if this.rescue.current}}
        <span class="acks-extras-crossing-block" data-tooltip-text="{{this.rescue.tip}}">{{localize "ACKS-FORMATION.crossing.swim.rescuerNamed" name=this.rescue.current}}</span>
        {{/if}}
        {{#if this.canHaul}}
        <button type="button" data-action="crossingHaul" data-actor-id="{{this.actorId}}"
                aria-label="{{localize 'ACKS-FORMATION.crossing.swim.haulFor' name=this.name}}" data-tooltip="">
          <i class="fa-solid fa-life-ring" inert></i> {{localize "ACKS-FORMATION.crossing.swim.haul"}}
        </button>
        {{/if}}
      </span>
      {{/if}}
      </span>
    </li>
    {{/each}}
    {{else if crossing.squeeze}}
    {{#each crossing.rows}}
    <li class="acks-extras-crossing-row" data-state="{{this.state}}" data-press-home="{{this.actorId}}" tabindex="-1">
      <span class="acks-extras-crossing-name">{{this.name}}{{#if this.yours}} <span class="acks-extras-crossing-yours">{{localize "ACKS-FORMATION.crossing.swim.yours"}}</span>{{/if}}{{#if this.holdsLabel}} <span class="acks-extras-crossing-badge" data-tooltip-text="{{this.badgeTip}}">{{this.holdsLabel}}</span>{{/if}}</span>
      {{#if this.can}}
      <button type="button" data-action="crossingThrow" data-actor-id="{{this.actorId}}"
              aria-label="{{localize 'ACKS-FORMATION.crossing.throwFor' name=this.name}}" data-tooltip="">
        <i class="fa-solid fa-dice-d20" inert></i> {{#if this.warn}}{{localize "ACKS-FORMATION.crossing.throwAnyway"}}{{else}}{{localize "ACKS-FORMATION.crossing.throw"}}{{/if}}
      </button>
      {{/if}}
      <span class="acks-extras-crossing-cells">
      {{#if this.target}}
      <span class="acks-nums acks-extras-crossing-figure" data-tooltip-text="{{this.targetTip}}">{{this.target}}</span>
      {{/if}}
      <span class="acks-extras-crossing-state{{#if this.stuck}} is-drowning{{/if}}" data-tooltip-text="{{this.stateTip}}">{{this.stateLabel}}</span>
      {{#each this.implied}}
      <span class="acks-extras-crossing-held" data-status="{{this.statusId}}" data-tooltip-text="{{this.tip}}">{{this.label}}</span>
      {{/each}}
      {{#if this.covered}}
      <span class="acks-nums acks-extras-crossing-covered" data-tooltip-text="{{this.coveredTip}}">{{this.covered}}</span>
      {{/if}}
      {{#if this.last}}
      <span class="acks-nums acks-extras-crossing-last" data-tooltip-text="{{this.last.tip}}">{{this.last.text}}</span>
      {{/if}}
      {{#if this.said}}<span class="acks-extras-crossing-block{{#if this.warn}} is-warn{{/if}}">{{this.said}}</span>{{/if}}
      {{#if this.escape}}
      <span class="acks-extras-crossing-rescue acks-extras-crossing-escape">
        <span class="acks-nums" data-tooltip-text="{{this.escape.tip}}">{{this.escape.text}}{{#if this.escape.penalty}} · {{this.escape.penalty}}{{/if}}</span>
        {{#with this.escape.wiggle}}
        {{#if this.can}}
        <button type="button" data-action="crossingEscape" data-step="{{this.step}}" data-actor-id="{{this.actorId}}"
                aria-label="{{this.aria}}" data-tooltip-text="{{this.tip}}">
          <i class="fa-solid fa-arrow-left" inert></i> {{this.label}}
        </button>
        {{else}}
        <span class="acks-extras-crossing-block" data-tooltip-text="{{this.tip}}">{{this.label}}</span>
        {{/if}}
        {{/with}}
        {{#with this.escape.push}}
        {{#if this.can}}
        <button type="button" data-action="crossingEscape" data-step="{{this.step}}" data-actor-id="{{this.actorId}}"
                aria-label="{{this.aria}}" data-tooltip-text="{{this.tip}}">
          <i class="fa-solid fa-arrow-right" inert></i> {{this.label}}
        </button>
        {{else}}
        <span class="acks-extras-crossing-block" data-tooltip-text="{{this.tip}}">{{this.label}}</span>
        {{/if}}
        {{/with}}
        {{#if this.escape.said}}<span class="acks-extras-crossing-block{{#if this.warn}} is-warn{{/if}}">{{this.escape.said}}</span>{{/if}}
      </span>
      {{/if}}
      </span>
    </li>
    {{/each}}
    {{else if crossing.jump}}
    {{#each crossing.rows}}
    <li class="acks-extras-crossing-row" data-verdict="{{this.verdict}}" data-state="{{this.state}}" data-press-home="{{this.actorId}}" tabindex="-1">
      <span class="acks-extras-crossing-name">{{this.name}}{{#if this.holdsAcrobatics}} <span class="acks-extras-crossing-badge">{{localize "ACKS-FORMATION.crossing.holdsAcrobatics"}}</span>{{/if}}</span>
      {{#if this.attempt.can}}
      <button type="button" data-action="crossingAttempt" data-actor-id="{{this.actorId}}"
              aria-label="{{this.attempt.aria}}" data-tooltip="">
        <i class="fa-solid fa-person-running" inert></i> {{this.attempt.label}}
      </button>
      {{/if}}
      {{#if this.climb.can}}
      <button type="button" data-action="crossingClimbUp" data-actor-id="{{this.actorId}}"
              aria-label="{{this.climb.aria}}" data-tooltip="">
        <i class="fa-solid fa-hand" inert></i> {{this.climb.label}}
      </button>
      {{/if}}
      <span class="acks-extras-crossing-cells">
      <span class="acks-nums acks-extras-crossing-figure" data-tooltip-text="{{this.verdictTip}}">{{this.range}}</span>
      <span class="acks-extras-crossing-verdict" data-tooltip-text="{{this.verdictTip}}">{{this.verdictLabel}}</span>
      {{#if this.said}}<span class="acks-extras-crossing-block{{#if this.warn}} is-warn{{/if}}">{{this.said}}</span>{{/if}}
      {{#if this.stateLabel}}<span class="acks-extras-crossing-state">{{this.stateLabel}}</span>{{/if}}
      {{#if this.result}}
      <span class="acks-extras-crossing-result">
        <span class="acks-nums acks-extras-crossing-rolled" data-tooltip-text="{{this.result.rolledTip}}">{{this.result.rolled}} — {{this.result.clearsLabel}}</span>
        {{#if this.result.save}}
        <span class="acks-nums acks-extras-crossing-save{{#if this.result.save.passed}} is-passed{{else}} is-failed{{/if}}" data-tooltip-text="{{this.result.save.tip}}">{{this.result.save.text}} — {{this.result.save.label}}</span>
        {{/if}}
        {{#if this.result.pending}}<span class="acks-extras-crossing-block">{{localize "ACKS-FORMATION.crossing.result.pending"}}</span>{{/if}}
        {{#if this.result.footing}}
        <span class="acks-nums acks-extras-crossing-footing" data-tooltip-text="{{this.result.footing.tip}}">{{this.result.footing.text}} → {{this.result.footing.footing}}: {{this.result.footing.outcome}}</span>
        {{#if this.result.footing.fall}}
        <span class="acks-nums acks-extras-crossing-fall" data-tooltip-text="{{this.result.footing.fall.tip}}">{{this.result.footing.fall.text}}</span>
        {{/if}}
        {{/if}}
      </span>
      {{/if}}
      {{#if this.climb}}
      <span class="acks-nums acks-extras-crossing-figure" data-tooltip-text="{{this.climb.targetTip}}">{{this.climb.target}}</span>
      {{#if this.climb.said}}<span class="acks-extras-crossing-block{{#if this.climb.warn}} is-warn{{/if}}">{{this.climb.said}}</span>{{/if}}
      {{/if}}
      {{#if this.landing}}
      <span class="acks-extras-crossing-landing" data-landing="{{this.actorId}}">
        <span class="acks-extras-crossing-verdict" data-tooltip-text="{{this.landing.tip}}">{{this.landing.label}}</span>
        {{#if this.landing.canRoll}}
        <button type="button" data-action="crossingLand" data-actor-id="{{this.actorId}}"
                aria-label="{{this.landing.rollAria}}" data-tooltip="">
          <i class="fa-solid fa-dice-d20" inert></i> {{this.landing.rollLabel}}
        </button>
        {{/if}}
        {{#if this.landing.canReport}}
        <label class="acks-extras-crossing-field" data-tooltip-text="{{this.landing.ref}}">
          <span>{{localize "ACKS-FORMATION.crossing.landing.footing"}}</span>
          <select data-pick="crossing-footing">
            {{#each this.landing.footings}}
            <option value="{{this.value}}">{{this.label}}</option>
            {{/each}}
          </select>
        </label>
        <button type="button" data-action="crossingLandingFailed" data-actor-id="{{this.actorId}}"
                aria-label="{{this.landing.failedAria}}" data-tooltip="">
          <i class="fa-solid fa-person-falling" inert></i> {{localize "ACKS-FORMATION.crossing.landing.failed"}}
        </button>
        {{/if}}
      </span>
      {{/if}}
      </span>
    </li>
    {{/each}}
    {{else}}
    {{#each crossing.rows}}
    <li class="acks-extras-crossing-row" data-state="{{this.state}}" data-press-home="{{this.actorId}}" tabindex="-1">
      <span class="acks-extras-crossing-name">{{this.name}}{{#if this.holds}} <span class="acks-extras-crossing-badge">{{this.holdsLabel}}</span>{{/if}}</span>
      {{#if this.can}}
      <button type="button" data-action="crossingThrow" data-actor-id="{{this.actorId}}"
              aria-label="{{localize 'ACKS-FORMATION.crossing.throwFor' name=this.name}}" data-tooltip="">
        <i class="fa-solid fa-dice-d20" inert></i> {{#if this.warn}}{{localize "ACKS-FORMATION.crossing.throwAnyway"}}{{else}}{{localize "ACKS-FORMATION.crossing.throw"}}{{/if}}
      </button>
      {{/if}}
      <span class="acks-extras-crossing-cells">
      {{#if this.pace}}
      <label class="acks-extras-crossing-field" data-tooltip-text="{{this.pace.tip}}">
        <span>{{this.pace.label}}</span>
        <select data-pick="crossing-pace-{{this.actorId}}" data-pace-for="{{this.actorId}}"{{#if this.pace.disabled}} disabled{{/if}}>
          {{#each this.pace.options}}
          <option value="{{this.value}}"{{#if this.selected}} selected{{/if}}>{{this.label}}</option>
          {{/each}}
        </select>
      </label>
      {{/if}}
      <span class="acks-nums acks-extras-crossing-figure" data-tooltip-text="{{this.targetTip}}">{{this.target}}</span>
      <span class="acks-extras-crossing-permitted" data-tooltip-text="{{this.permittedTip}}">{{this.permitted}}</span>
      <span class="acks-nums acks-extras-crossing-covered" data-tooltip-text="{{this.coveredTip}}">{{this.covered}}</span>
      {{#each this.held}}
      <span class="acks-extras-crossing-held" data-status="{{this.statusId}}" data-tooltip-text="{{this.tip}}">{{this.label}}</span>
      {{/each}}
      <span class="acks-extras-crossing-state">{{this.stateLabel}}</span>
      {{#if this.last}}
      <span class="acks-nums acks-extras-crossing-last"><span data-tooltip-text="{{this.last.tip}}">{{this.last.total}}</span>{{#if this.last.outcome}} · <span data-tooltip-text="{{this.last.outcomeTip}}">{{this.last.outcome}}</span>{{/if}}</span>
      {{/if}}
      {{#if this.fall}}
      <span class="acks-nums acks-extras-crossing-fall" data-tooltip-text="{{this.fall.tip}}">{{this.fall.text}}</span>
      {{/if}}
      {{#if this.said}}<span class="acks-extras-crossing-block{{#if this.warn}} is-warn{{/if}}">{{this.said}}</span>{{/if}}
      </span>
    </li>
    {{/each}}
    {{/if}}
  </ul>
  {{/if}}
  {{/unless}}
</section>
{{/if}}
