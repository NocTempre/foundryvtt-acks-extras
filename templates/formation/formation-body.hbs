<div class="acks-formation-body">

  {{#if formation}}

  {{#if isGM}}
  <div class="name-row">
    {{#if partyImg}}
    <img class="party-img" src="{{partyImg}}" data-action="editPartyImage"
         data-tooltip="{{localize 'ACKS-FORMATION.app.editImageHint'}}" alt="" />
    {{/if}}
    <input type="text" name="name" value="{{formation.name}}" />
  </div>
  <div class="table-row" data-tooltip="{{localize 'ACKS-FORMATION.app.tableHint'}}">
    <label><i class="fa-solid fa-table-list"></i> {{localize "ACKS-FORMATION.app.table"}}</label>
    <select name="tableId">
      <option value="">{{localize "ACKS-FORMATION.app.tableNone"}}</option>
      {{#each tables}}
      <option value="{{this.id}}" {{#if this.active}}selected{{/if}}>{{this.name}}</option>
      {{/each}}
    </select>
  </div>
  {{/if}}

  <section class="clock">
    <div class="stats">
      <div class="stat {{#if hurried}}quiet{{/if}}" data-tooltip="{{localize 'ACKS-FORMATION.app.speedHint'}}">
        <label>{{localize "ACKS-FORMATION.app.speed"}}</label>
        <span class="value">{{#if hurried}}{{effSpeed}}'{{else}}{{speed}}'{{/if}}</span>
        <span class="sub">{{#if hurried}}{{localize "ACKS-FORMATION.app.hurriedBadge"}}{{else}}{{localize "ACKS-FORMATION.app.perTurn"}} · {{combatSpeed}}' {{localize "ACKS-FORMATION.app.perRound"}}{{/if}}</span>
      </div>
      <div class="stat">
        <label>{{localize "ACKS-FORMATION.app.elapsed"}}</label>
        <span class="value">{{clock.turnsTotal}}</span>
        <span class="sub">{{localize "ACKS-FORMATION.app.turns"}} ({{elapsed}}) · {{localize "ACKS-FORMATION.app.roundShort"}} {{#if clock.roundsPartial}}{{clock.roundsPartial}}{{else}}0{{/if}}/10</span>
      </div>
      <div class="stat {{#if clock.winded}}bad{{/if}}">
        <label>{{localize "ACKS-FORMATION.app.rest"}}</label>
        <span class="value">{{clock.turnsSinceRest}}/{{restMax}}</span>
        <span class="sub">{{#if clock.winded}}{{localize "ACKS-FORMATION.app.windedBadge"}}{{else}}{{localize "ACKS-FORMATION.app.sinceRest"}}{{/if}}</span>
      </div>
      <div class="stat">
        <label>{{localize "ACKS-FORMATION.app.carry"}}</label>
        <span class="value">{{clock.carryFeet}}'</span>
        <span class="sub">{{localize "ACKS-FORMATION.app.carryHint"}}</span>
      </div>
    </div>

    {{#if isGM}}
    <div class="buttons">
      {{#if canControl}}
      <button type="button" data-action="dealXp" data-tooltip="{{localize 'ACKS-FORMATION.xp.hint'}}">
        <i class="fa-solid fa-star"></i> {{localize "ACKS-FORMATION.xp.deal"}}
      </button>
      {{/if}}
      <button type="button" data-action="advanceTurn" data-tooltip="{{localize 'ACKS-FORMATION.app.advanceTurnHint'}}">
        <i class="fa-solid fa-hourglass-half"></i> {{localize "ACKS-FORMATION.app.advanceTurn"}}
      </button>
      <button type="button" data-action="advanceRound" data-tooltip="{{localize 'ACKS-FORMATION.app.advanceRoundHint'}}">
        <i class="fa-solid fa-hourglass-start"></i> {{localize "ACKS-FORMATION.app.advanceRound"}}
      </button>
      <button type="button" data-action="restTurn" data-tooltip="{{localize 'ACKS-FORMATION.app.restTurnHint'}}">
        <i class="fa-solid fa-campfire"></i> {{localize "ACKS-FORMATION.app.restTurn"}}
      </button>
      <button type="button" data-action="encounterNow" data-tooltip="{{localize 'ACKS-FORMATION.app.encounterNowHint'}}">
        <i class="fa-solid fa-dice-d6"></i> {{localize "ACKS-FORMATION.app.encounterNow"}}
      </button>
      <button type="button" data-action="consumeRations" data-tooltip="{{localize 'ACKS-FORMATION.app.rationsHint'}}">
        <i class="fa-solid fa-drumstick-bite"></i> {{localize "ACKS-FORMATION.app.rations"}}
      </button>
      <button type="button" data-action="undoTurn" data-tooltip="{{localize 'ACKS-FORMATION.app.undoTurnHint'}}">
        <i class="fa-solid fa-rotate-left"></i>
      </button>
      <button type="button" data-action="togglePause" class="{{#if clock.paused}}paused{{/if}}"
              data-tooltip="{{localize 'ACKS-FORMATION.app.pauseHint'}}">
        <i class="fa-solid {{#if clock.paused}}fa-play{{else}}fa-pause{{/if}}"></i>
      </button>
      <button type="button" data-action="togglePace" class="{{#if hurried}}paused{{/if}}"
              data-tooltip="{{localize 'ACKS-FORMATION.app.paceHint'}}">
        <i class="fa-solid {{#if hurried}}fa-person-running{{else}}fa-person-walking{{/if}}"></i>
      </button>
      <button type="button" data-action="disband" class="danger" data-tooltip="{{localize 'ACKS-FORMATION.app.disbandHint'}}">
        <i class="fa-solid fa-people-arrows"></i> {{localize "ACKS-FORMATION.app.disband"}}
      </button>
    </div>
    <div class="buttons saves-row">
      <span class="save-label">{{localize "ACKS-FORMATION.app.partySave"}}</span>
      {{#each saves}}
      <button type="button" data-action="partySave" data-save="{{this.key}}" data-tooltip="{{this.tooltip}}">
        {{this.label}}
      </button>
      {{/each}}
      <label class="magical-toggle" data-tooltip="{{localize 'ACKS-FORMATION.app.magicalHint'}}">
        <input type="checkbox" class="save-magical" checked />
        {{localize "ACKS-FORMATION.app.magical"}}
      </label>
    </div>
    <div class="buttons saves-row">
      <span class="save-label">{{localize "ACKS-FORMATION.rolls.rowLabel"}}</span>
      {{#each checks}}
      <button type="button" data-action="partyCheck" data-check="{{this.key}}" data-tooltip="{{this.hint}}">
        <i class="fa-solid {{this.icon}}"></i> {{this.label}}
      </button>
      {{/each}}
    </div>
    {{/if}}
  </section>


  {{#if ownedMembers.length}}
  <section class="player-actions">
    <h3>{{localize "ACKS-FORMATION.request.section"}}</h3>
    <div class="add-light">
      <select class="player-light-type">
        {{#each playerLightTypes}}
        <option value="{{this.key}}">{{this.label}}</option>
        {{/each}}
      </select>
      <select class="player-light-bearer">
        {{#each ownedMembers}}
        <option value="{{this.id}}">{{this.name}}</option>
        {{/each}}
      </select>
      <button type="button" data-action="playerLight" data-tooltip="{{localize 'ACKS-FORMATION.request.lightHint'}}">
        <i class="fa-solid fa-fire"></i> {{localize "ACKS-FORMATION.app.lightIt"}}
      </button>
    </div>
    {{#if playerSpells.length}}
    <div class="add-light add-spell">
      <select class="player-spell">
        {{#each playerSpells}}
        <option value="{{this.key}}">{{this.label}}</option>
        {{/each}}
      </select>
      <input type="number" class="player-spell-turns" min="1" placeholder="{{localize 'ACKS-FORMATION.app.spellTurns'}}" />
      <button type="button" data-action="playerSpell" data-tooltip="{{localize 'ACKS-FORMATION.request.spellHint'}}">
        <i class="fa-solid fa-wand-sparkles"></i> {{localize "ACKS-FORMATION.app.trackSpell"}}
      </button>
    </div>
    {{/if}}
    <div class="buttons">
      <button type="button" data-action="playerRest" data-tooltip="{{localize 'ACKS-FORMATION.request.restHint'}}">
        <i class="fa-solid fa-campfire"></i> {{localize "ACKS-FORMATION.app.restTurn"}}
      </button>
      {{#each checks}}
      <button type="button" data-action="playerCheck" data-check="{{this.key}}" data-tooltip="{{this.hint}}">
        <i class="fa-solid {{this.icon}}"></i> {{this.label}}
      </button>
      {{/each}}
      {{#if canTrapbreak}}
      <button type="button" data-action="openTrapbreak" data-tooltip="{{localize 'ACKS-FORMATION.traps.breakHint'}}">
        <i class="fa-solid fa-screwdriver-wrench"></i> {{localize "ACKS-FORMATION.traps.breakTitle"}}
      </button>
      {{/if}}
    </div>
    <p class="hint">{{localize "ACKS-FORMATION.request.hint"}}</p>
  </section>
  {{/if}}

  {{#if warnings.length}}
  <section class="warnings acks-callout acks-callout--warning">
    {{#each warnings}}
      <p><i class="fa-solid fa-triangle-exclamation"></i> {{this}}</p>
    {{/each}}
  </section>
  {{/if}}

  <section class="members">
    <h3>
      {{localize "ACKS-FORMATION.app.marchingOrder"}}
      {{#if isGM}}
      <span class="march-controls">
        <label class="frontage-field" data-tooltip="{{localize 'ACKS-FORMATION.app.frontageHint'}}">
          {{localize "ACKS-FORMATION.app.frontage"}}
          <input type="number" name="frontage" value="{{frontage}}" min="1" step="1"
                 {{#if frontageMax}}max="{{frontageMax}}"{{/if}}
                 style="width: 4em; height: 22px;" />
        </label>
        <button type="button" data-action="autoArrange" data-tooltip="{{localize 'ACKS-FORMATION.app.autoArrangeHint'}}">
          <i class="fa-solid fa-arrow-down-wide-short"></i> {{localize "ACKS-FORMATION.app.autoArrange"}}
        </button>
        <button type="button" data-action="saveMarchingOrder" data-tooltip="{{localize 'ACKS-FORMATION.marching.saveHint'}}">
          <i class="fa-solid fa-floppy-disk"></i>
        </button>
        <button type="button" data-action="loadMarchingOrder" data-tooltip="{{localize 'ACKS-FORMATION.marching.loadHint'}}">
          <i class="fa-solid fa-people-line"></i>
        </button>
        <button type="button" data-action="addBlank" data-tooltip="{{localize 'ACKS-FORMATION.app.addBlankHint'}}">
          <i class="fa-solid fa-border-none"></i>
        </button>
        <button type="button" data-action="openTrapbreak" data-tooltip="{{localize 'ACKS-FORMATION.traps.breakHint'}}">
          <i class="fa-solid fa-screwdriver-wrench"></i>
        </button>
        <button type="button" data-action="openSkillAudit" data-tooltip="{{localize 'ACKS-FORMATION.audit.openHint'}}">
          <i class="fa-solid fa-list-check"></i>
        </button>
      </span>
      {{/if}}
    </h3>
    {{#if members.length}}
    <ol style="--frontage: {{frontage}}">
      {{#each members}}
      {{#if this.rankStart}}
      <li class="rank-divider">{{localize "ACKS-FORMATION.app.rank"}} {{this.rank}}</li>
      {{/if}}
      {{#if this.blank}}
      <li data-cell-index="{{this.cellIndex}}" class="member blank-cell">
        <span class="hint">{{localize "ACKS-FORMATION.app.blankSlot"}}</span>
        {{#if @root.isGM}}
        <div class="member-controls {{#if this.showHoriz}}grid-controls{{/if}}">
          <button type="button" data-action="memberUp" {{#unless this.canUp}}disabled{{/unless}}><i class="fa-solid fa-chevron-up"></i></button>
          {{#if this.showHoriz}}
          <button type="button" data-action="memberLeft" {{#unless this.canLeft}}disabled{{/unless}}><i class="fa-solid fa-chevron-left"></i></button>
          <button type="button" data-action="memberRight" {{#unless this.canRight}}disabled{{/unless}}><i class="fa-solid fa-chevron-right"></i></button>
          {{/if}}
          <button type="button" data-action="memberDown" {{#unless this.canDown}}disabled{{/unless}}><i class="fa-solid fa-chevron-down"></i></button>
          <button type="button" data-action="removeBlank" class="danger"><i class="fa-solid fa-xmark"></i></button>
        </div>
        {{/if}}
      </li>
      {{else}}
      <li data-actor-id="{{this.actorId}}" data-cell-index="{{this.cellIndex}}" class="member {{#if this.slowest}}slowest{{/if}}{{#if this.casualty}} casualty{{/if}}{{#if this.left}} left-behind{{/if}}">
        {{#if this.canLeave}}
        <span class="acks-extras-formation-casualty"
              data-tooltip="{{#if this.left}}{{localize 'ACKS-FORMATION.app.leftBehindHint'}}{{else}}{{localize 'ACKS-FORMATION.app.casualtyHint'}}{{/if}}">
          <i class="fa-solid {{#if this.dead}}fa-skull{{else}}fa-heart-crack{{/if}}"></i>
          {{#if this.canControl}}
          <a data-action="toggleLeftBehind">{{#if this.left}}{{localize "ACKS-FORMATION.app.goBackFor"}}{{else}}{{localize "ACKS-FORMATION.app.leaveBehind"}}{{/if}}</a>
          {{/if}}
        </span>
        {{/if}}
        <span class="rank">{{this.index}}</span>
        <img src="{{this.img}}" data-action="openSheet" alt="{{this.name}}" />
        <div class="info">
          <span class="name">{{this.name}} {{#if this.down}}<i class="fa-solid fa-skull down-badge" data-tooltip="{{localize 'ACKS-FORMATION.app.downBadge'}}"></i>{{/if}}{{#if this.blind}}<i class="fa-solid fa-eye-slash down-badge" data-tooltip="{{localize 'ACKS-FORMATION.app.blindBadge'}}"></i>{{/if}} {{#if this.detached}}<i class="fa-solid fa-person-hiking" data-tooltip="{{localize 'ACKS-FORMATION.app.detachedBadge'}}"></i>{{else if this.deployed}}<i class="fa-solid fa-swords" data-tooltip="{{localize 'ACKS-FORMATION.app.deployedBadge'}}"></i>{{else}}{{#unless this.stashed}}<i class="fa-solid fa-location-dot" data-tooltip="{{localize 'ACKS-FORMATION.app.noStashedToken'}}"></i>{{/unless}}{{/if}}</span>
          <span class="details">{{this.speed}}'/{{localize "ACKS-FORMATION.app.turn"}} · {{localize "ACKS-FORMATION.app.enc"}} {{this.enc}}/{{this.encMax}}{{#if this.darkSight}} · <span class="dark-sight" data-tooltip="{{localize 'ACKS-FORMATION.app.darkSightHint'}}"><i class="fa-solid fa-low-vision"></i> {{this.darkSight}}'</span>{{/if}}</span>
          <span class="roles">
            {{#each this.roles}}
            <button type="button" class="role-chip {{#if this.active}}active{{/if}}" data-action="toggleRole"
                    data-role="{{this.key}}" data-tooltip="{{this.hint}}" {{#unless ../canControl}}disabled{{/unless}}>
              {{this.label}}
            </button>
            {{/each}}
          </span>
          {{#if this.mount}}
          <span class="acks-extras-formation-mount">
            <i class="fa-solid fa-horse" data-tooltip="{{localize 'ACKS-FORMATION.app.ridingBadge'}}"></i>
            {{> "modules/acks-extras/templates/lib/station-chip.hbs" this.mount}}
          </span>
          {{/if}}
        </div>
        {{#if this.canControl}}
        <div class="member-controls {{#if this.showHoriz}}grid-controls{{/if}}">
          <button type="button" data-action="memberUp" {{#unless this.canUp}}disabled{{/unless}}><i class="fa-solid fa-chevron-up"></i></button>
          {{#if this.showHoriz}}
          <button type="button" data-action="memberLeft" {{#unless this.canLeft}}disabled{{/unless}}><i class="fa-solid fa-chevron-left"></i></button>
          <button type="button" data-action="memberRight" {{#unless this.canRight}}disabled{{/unless}}><i class="fa-solid fa-chevron-right"></i></button>
          {{/if}}
          <button type="button" data-action="memberDown" {{#unless this.canDown}}disabled{{/unless}}><i class="fa-solid fa-chevron-down"></i></button>
          <button type="button" data-action="toggleDetach" class="{{#if this.detached}}active{{/if}}"
                  {{#unless this.canDetach}}disabled{{/unless}}
                  data-tooltip="{{#if this.detached}}{{localize 'ACKS-FORMATION.app.recallHint'}}{{else}}{{localize 'ACKS-FORMATION.app.detachHint'}}{{/if}}">
            <i class="fa-solid {{#if this.detached}}fa-people-arrows{{else}}fa-person-walking-arrow-right{{/if}}"></i>
          </button>
          {{#if @root.isGM}}
          <button type="button" data-action="removeMember" class="danger" data-tooltip="{{localize 'ACKS-FORMATION.app.removeMemberHint'}}">
            <i class="fa-solid fa-user-minus"></i>
          </button>
          {{/if}}
        </div>
        {{/if}}
      </li>
      {{/if}}
      {{/each}}
    </ol>
    {{else}}
    <p class="hint">{{localize "ACKS-FORMATION.app.emptyMembers"}}</p>
    {{/if}}
  </section>

  {{! The train: every carrier under a member — mounts, wagons, the horse in
      the traces. Carriers are not members; this is where they show. }}
  {{#if train.length}}
  <section class="acks-extras-formation-train">
    <h3>{{localize "ACKS-FORMATION.app.train"}}</h3>
    {{#each train}}
    <div class="acks-extras-formation-train-row{{#if setsPace}} is-pace-setter{{/if}}">
      <img src="{{img}}" alt="">
      <a class="acks-extras-formation-train-name" data-action="stationChipOpen" data-uuid="{{uuid}}">{{name}}</a>
      {{#if setsPace}}<i class="fa-solid fa-gauge-simple-high"
        data-tooltip="{{localize 'ACKS-FORMATION.app.trainSetsPace'}}"></i>{{/if}}
      <span class="acks-extras-formation-train-details">{{pace}}{{#if summary}} · {{summary}}{{/if}}</span>
    </div>
    {{/each}}
  </section>
  {{/if}}

  {{! The journey: pickers, the day board and the readout for the GM; the
      derived march, the hex trace and the log for everyone at the table. }}
  {{#if travel.isSettlement}}
  <section class="acks-extras-formation-travel acks-extras-formation-settlement">
    <h3>{{localize "ACKS-FORMATION.settlement.legend"}}
      {{#if isGM}}
      <button type="button" class="acks-extras-formation-travel-mode" data-action="settlementMode"
              data-tooltip="{{localize 'ACKS-FORMATION.settlement.leaveHint'}}">
        <i class="fa-solid fa-dungeon"></i> {{localize "ACKS-FORMATION.settlement.leave"}}
      </button>
      {{/if}}
    </h3>

    {{#if isGM}}
    <div class="acks-extras-formation-travel-pickers">
      <label>{{localize "ACKS-FORMATION.settlement.paceLabel"}}
        <select name="travel.settlement.pace">
          {{#each travel.settlement.paceOptions}}
            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
      </label>
      <label>{{localize "ACKS-FORMATION.settlement.whereLabel"}}
        <select name="travel.settlement.where">
          {{#each travel.settlement.whereOptions}}
            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
      </label>
      <label>{{localize "ACKS-FORMATION.settlement.routeLabel"}}
        <select name="travel.settlement.route">
          {{#each travel.settlement.routeOptions}}
            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
      </label>
      <label class="acks-extras-formation-settlement-night">
        <input type="checkbox" name="travel.settlement.night"
               {{#if travel.settlement.night}}checked{{/if}}>
        {{localize "ACKS-FORMATION.settlement.night"}}
      </label>
    </div>
    {{/if}}

    <p class="acks-extras-formation-travel-readout">
      {{#if travel.settlement.blocksUnpriced}}
        <span class="hint">{{localize "ACKS-FORMATION.settlement.blocksUnpriced"}}</span>
      {{else}}
        <strong>{{travel.settlement.blocks}}</strong> {{localize "ACKS-FORMATION.settlement.blocks"}}
        {{#if travel.settlement.straggling}}
          · <span class="acks-extras-formation-settlement-straggle">{{localize "ACKS-FORMATION.settlement.straggling"}}</span>
        {{/if}}
      {{/if}}
    </p>

    {{#if isGM}}
    <p class="acks-extras-formation-settlement-progress">
      {{localize "ACKS-FORMATION.settlement.progress" blocks=travel.settlement.blocks turns=travel.settlement.turns}}
      {{#if travel.settlement.lost}}
      <span class="acks-extras-formation-settlement-astray">{{localize "ACKS-FORMATION.settlement.astray"}}</span>
      {{/if}}
      <button type="button" data-action="settlementTurn"
              data-tooltip="{{localize 'ACKS-FORMATION.settlement.takeTurnHint'}}">
        <i class="fa-solid fa-shoe-prints"></i> {{localize "ACKS-FORMATION.settlement.takeTurn"}}
      </button>
    </p>
    <p class="acks-extras-formation-settlement-nav">
      {{#if travel.settlement.throws}}
        {{#if travel.settlement.navUnpriced}}
          <span class="hint">{{localize "ACKS-FORMATION.settlement.navUnpriced"}}</span>
        {{else}}
          {{localize "ACKS-FORMATION.settlement.navThrow" target=travel.settlement.navTarget modifier=travel.settlement.navModifier}}
        {{/if}}
      {{else}}
        <span class="hint">{{travel.settlement.noThrowReason}}</span>
      {{/if}}
    </p>
    <p class="hint">
      {{#if travel.settlement.cadenceMissing}}
        {{localize "ACKS-FORMATION.settlement.cadenceMissing"}}
      {{else}}
        {{localize "ACKS-FORMATION.settlement.cadence" turns=travel.settlement.cadence.everyTurns target=travel.settlement.cadence.target}}
      {{/if}}
    </p>
    {{/if}}
  </section>
  {{/if}}

  {{#if travel.isJourney}}
  <section class="acks-extras-formation-travel">
    <h3>{{localize "ACKS-FORMATION.travel.legend"}}
      <span class="acks-extras-formation-travel-daycount">{{localize "ACKS-FORMATION.travel.dayN" n=travel.dayCount}}</span>
      {{#if isGM}}
      <button type="button" class="acks-extras-formation-travel-mode" data-action="travelMode"
              data-tooltip="{{localize 'ACKS-FORMATION.travel.endJourneyHint'}}">
        <i class="fa-solid fa-dungeon"></i> {{localize "ACKS-FORMATION.travel.endJourney"}}
      </button>
      {{/if}}
    </h3>

    {{#if isGM}}
    <div class="acks-extras-formation-travel-pickers">
      <label>{{localize "ACKS-FORMATION.travel.ground"}}
        <select name="travel.ground">
          {{#each travel.grounds}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
        </select>
      </label>
      <label>{{localize "ACKS-FORMATION.travel.roadLabel"}}
        <select name="travel.road">
          {{#each travel.roads}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
        </select>
      </label>
      <label data-tooltip="{{localize 'ACKS-FORMATION.travel.followingHint'}}">
        {{localize "ACKS-FORMATION.travel.followingLabel"}}
        <select name="travel.following">
          {{#each travel.followingOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
        </select>
      </label>
      <label>{{localize "ACKS-FORMATION.travel.territoryLabel"}}
        <select name="travel.territory">
          {{#each travel.territories}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
        </select>
      </label>
      <label data-tooltip="{{localize 'ACKS-FORMATION.travel.enc.terrainHint'}}">{{localize "ACKS-FORMATION.travel.enc.terrainLabel"}}
        <select name="travel.encounterTerrain">
          {{#each travel.encounterTerrains}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
        </select>
      </label>
      <label data-tooltip="{{localize 'ACKS-FORMATION.travel.movement.hint'}}">{{localize "ACKS-FORMATION.travel.movement.label"}}
        <select name="travel.movement.mode">
          {{#each travel.movementModes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
        </select>
      </label>
      {{#if travel.flying}}
      <label data-tooltip="{{localize 'ACKS-FORMATION.travel.movement.aloftHint'}}">{{localize "ACKS-FORMATION.travel.movement.aloft"}}
        <input type="number" min="0" step="1" name="travel.movement.hoursAloft" value="{{travel.movement.hoursAloft}}">
      </label>
      <label data-tooltip="{{localize 'ACKS-FORMATION.travel.movement.dayHint'}}">{{localize "ACKS-FORMATION.travel.movement.day"}}
        <input type="number" min="0" step="1" name="travel.movement.dayHours" value="{{travel.movement.dayHours}}">
      </label>
      <label data-tooltip="{{localize 'ACKS-FORMATION.travel.movement.loadHint'}}">{{localize "ACKS-FORMATION.travel.movement.load"}}
        <select name="travel.movement.load">
          {{#each travel.flightLoads}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
        </select>
      </label>
      {{/if}}
    </div>

    <div class="acks-extras-formation-travel-weather">
      <div class="acks-extras-formation-travel-weather-gen">
        <label>{{localize "ACKS-FORMATION.travel.weather.climate"}}
          <select name="travel.weather.climate">
            <option value="" {{#if travel.weather.climateUnset}}selected{{/if}}>{{localize "ACKS-FORMATION.travel.weather.unset"}}</option>
            {{#each travel.weather.climateGroups}}
            <optgroup label="{{label}}">
              {{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
            </optgroup>
            {{/each}}
          </select>
        </label>
        <label>{{localize "ACKS-FORMATION.travel.weather.season"}}
          <select name="travel.weather.season">
            {{#each travel.weather.seasons}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
        </label>
        <label class="checkbox" data-tooltip="{{localize 'ACKS-FORMATION.travel.weather.autoHint'}}">
          <input type="checkbox" name="travel.weather.auto" {{checked travel.weather.auto}}>
          {{localize "ACKS-FORMATION.travel.weather.auto"}}
        </label>
        <label class="checkbox" data-tooltip="{{localize 'ACKS-FORMATION.travel.weather.frontsHint'}}">
          <input type="checkbox" name="travel.weather.fronts" {{checked travel.weather.fronts}}>
          {{localize "ACKS-FORMATION.travel.weather.fronts"}}
        </label>
        <button type="button" data-action="travelWeatherRoll" {{#unless travel.weather.ready}}disabled{{/unless}}
                data-tooltip="{{localize 'ACKS-FORMATION.travel.weather.generateHint'}}">
          <i class="fa-solid fa-cloud-sun-rain"></i> {{localize "ACKS-FORMATION.travel.weather.generate"}}
        </button>
      </div>
      {{#unless travel.weather.ready}}
      <p class="hint acks-extras-formation-travel-weather-missing">{{localize "ACKS-FORMATION.travel.weather.missing"}}</p>
      {{/unless}}
      <div class="acks-extras-formation-travel-weather-bands">
        <label>{{localize "ACKS-FORMATION.travel.weather.temperature"}}
          <select name="travel.weather.temperature">
            {{#each travel.weather.temperatures}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
        </label>
        <label>{{localize "ACKS-FORMATION.travel.weather.precipitation"}}
          <select name="travel.weather.precipitation">
            {{#each travel.weather.precipitations}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
        </label>
        <label>{{localize "ACKS-FORMATION.travel.weather.wind"}}
          <select name="travel.weather.wind">
            {{#each travel.weather.winds}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
        </label>
        <label>{{localize "ACKS-FORMATION.travel.weather.footingMud"}}
          <select name="travel.weather.footingMud">
            {{#each travel.weather.footingMud}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
        </label>
        <label class="checkbox">
          <input type="checkbox" name="travel.weather.footingSnow" {{checked travel.weather.footingSnow}}>
          {{localize "ACKS-FORMATION.travel.weather.footingSnow"}}
        </label>
      </div>
    </div>
    {{/if}}

    {{#if travel.weather.night}}
    <p class="acks-extras-formation-travel-weather-night hint">{{localize "ACKS-FORMATION.travel.weather.night"}}: {{travel.weather.night}}</p>
    {{/if}}
    {{#if travel.weather.chips.length}}
    <div class="acks-extras-formation-travel-weather-chips">
      {{#each travel.weather.chips}}<span class="acks-extras-formation-travel-weather-chip" data-cond="{{key}}">{{label}}</span>{{/each}}
    </div>
    {{/if}}
    {{#each travel.wheels}}
    <p class="acks-extras-formation-travel-wheels"><i class="fa-solid fa-triangle-exclamation"></i> {{name}} — {{reason}}</p>
    {{/each}}

    {{#if isGM}}
    <div class="acks-extras-formation-travel-day">
      <label>{{localize "ACKS-FORMATION.travel.dayBoard"}}
        <select name="travel.day.kind">
          {{#each travel.dayKinds}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
        </select>
      </label>
      {{#each travel.slots}}
      <select name="travel.day.slot.{{index}}" {{#if @root.travel.forced}}disabled{{/if}}
              data-tooltip="{{localize 'ACKS-FORMATION.travel.slotHint'}}">
        <option value="" {{#if empty}}selected{{/if}}>—</option>
        {{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
      </select>
      {{/each}}
      <button type="button" data-action="travelEndDay" data-tooltip="{{localize 'ACKS-FORMATION.travel.endDayHint'}}">
        <i class="fa-solid fa-moon"></i> {{localize "ACKS-FORMATION.travel.endDay"}}
      </button>
    </div>
    {{/if}}

    <p class="acks-extras-formation-travel-readout">
      {{#if travel.readout.camp}}
        {{localize "ACKS-FORMATION.travel.campDay"}}
      {{else}}
        <strong>{{travel.readout.milesPerDay}}</strong> {{localize "ACKS-FORMATION.travel.milesPerDay"}}
        · {{travel.readout.hexesPerDay}} {{localize "ACKS-FORMATION.travel.hexesPerDay"}}
        <span class="hint">({{travel.readout.feet}}'/{{localize "ACKS-FORMATION.app.turn"}}{{#each travel.readout.parts}} · {{label}}{{#if factor}} ×{{factor}}{{/if}}{{/each}})</span>
      {{/if}}
    
        {{#if travel.winding}}
        <span class="acks-extras-formation-travel-winding"
              data-tooltip="{{localize 'ACKS-FORMATION.travel.windingHint'}}">
          · {{localize "ACKS-FORMATION.travel.winding" hexes=travel.winding}}
        </span>
        {{/if}}</p>

    {{#if travel.camp}}
    <div class="acks-extras-formation-camp">
      <h4>{{localize "ACKS-FORMATION.camp.legend"}}</h4>

      <p class="acks-extras-formation-camp-supply">
        {{localize "ACKS-FORMATION.camp.food"}}:
        <strong class="{{#if travel.camp.short}}acks-extras-formation-camp-short{{/if}}">{{travel.camp.forecast.foodDays}}</strong>
        &middot; {{localize "ACKS-FORMATION.camp.water"}}:
        <strong class="{{#if travel.camp.short}}acks-extras-formation-camp-short{{/if}}">{{travel.camp.forecast.waterDays}}</strong>
        <span class="hint">{{localize "ACKS-FORMATION.camp.days" mouths=travel.camp.mouths}}</span>
        {{#if travel.camp.thirstyWeather}}
        <span class="acks-extras-formation-camp-short"
              data-tooltip="{{localize 'ACKS-FORMATION.camp.thirstyHint'}}">{{localize "ACKS-FORMATION.camp.thirsty"}}</span>
        {{/if}}
      </p>

      {{#if isGM}}
      <p class="acks-extras-formation-camp-exposure">
        <label>
          {{localize "ACKS-FORMATION.camp.exposureHours"}}
          <input type="number" min="0" max="24" step="1"
                 name="travel.exposure.hours" value="{{travel.camp.exposure.hours}}"
                 {{#unless travel.camp.exposure.bites}}disabled{{/unless}}
                 data-tooltip="{{localize 'ACKS-FORMATION.camp.exposureHoursHint'}}">
        </label>
        <label>
          <input type="checkbox" name="travel.exposure.atHeatSource"
                 {{#if travel.camp.exposure.atHeatSource}}checked{{/if}}>
          {{localize "ACKS-FORMATION.camp.atHeatSource"}}
        </label>
        <label>
          <input type="checkbox" name="travel.exposure.wet"
                 {{#if travel.camp.exposure.wet}}checked{{/if}}>
          {{localize "ACKS-FORMATION.camp.wet"}}
        </label>
        {{#unless travel.camp.exposure.bites}}
        <span class="hint">{{localize "ACKS-FORMATION.camp.exposureMild"}}</span>
        {{/unless}}
      </p>
      {{/if}}

      {{#if travel.camp.anySuffering}}
      <ul class="acks-extras-formation-camp-suffering">
        {{#each travel.camp.suffering}}
        <li><strong>{{name}}</strong>
          {{#if nourishment}}<span>{{nourishment}}</span>{{/if}}
          {{#if hydration}}<span>{{hydration}}</span>{{/if}}
          {{#if exposure}}<span>{{exposure}}</span>{{/if}}
          {{#if conLost}}<span class="acks-extras-formation-camp-short">&minus;{{conLost}} CON</span>{{/if}}
        </li>
        {{/each}}
      </ul>
      {{/if}}

      {{#if isGM}}
      {{#each travel.camp.forage}}
      <p class="acks-extras-formation-camp-throw">
        {{label}}:
        {{#if unpriced}}<span class="hint">{{localize "ACKS-FORMATION.camp.unpriced"}}</span>
        {{else if automatic}}<span>{{localize "ACKS-FORMATION.camp.automatic"}}</span>
        {{else}}<span>{{localize "ACKS-FORMATION.camp.throw" target=target modifier=bonus}}</span>{{/if}}
      </p>
      {{/each}}
      {{#if travel.camp.hunt}}
      <p class="acks-extras-formation-camp-throw">
        {{localize "ACKS-FORMATION.travel.activity.hunt"}}:
        {{#if travel.camp.hunt.ok}}<span>{{localize "ACKS-FORMATION.camp.throw" target=travel.camp.hunt.target modifier=travel.camp.hunt.bonus}}</span>
        {{else}}<span class="hint">{{localize "ACKS-FORMATION.camp.unpriced"}}</span>{{/if}}
      </p>
      {{/if}}
      <button type="button" data-action="forageDay"
              data-tooltip="{{localize 'ACKS-FORMATION.forageRun.workHint'}}">
        <i class="fa-solid fa-wheat-awn"></i> {{localize "ACKS-FORMATION.forageRun.work"}}
      </button>
      {{#if travel.camp.search}}
      <p class="acks-extras-formation-camp-throw">
        <label class="acks-extras-formation-camp-present"
               data-tooltip="{{localize 'ACKS-FORMATION.searchRun.presentHint'}}">
          <input type="checkbox" name="camp.present">
          {{localize "ACKS-FORMATION.searchRun.present"}}
        </label>
        <button type="button" data-action="searchHour"
                data-tooltip="{{localize 'ACKS-FORMATION.searchRun.searchHint'}}">
          <i class="fa-solid fa-magnifying-glass"></i> {{localize "ACKS-FORMATION.searchRun.search"}}
        </button>
      </p>
      <p class="acks-extras-formation-camp-throw">
        {{localize "ACKS-FORMATION.travel.activity.search"}}:
        {{#if travel.camp.search.ok}}<span>{{localize "ACKS-FORMATION.camp.searchThrow" target=travel.camp.search.target held=travel.camp.searchesHeld}}</span>
        {{else}}<span class="hint">{{localize "ACKS-FORMATION.camp.unpriced"}}</span>{{/if}}
      </p>
      {{/if}}
      {{/if}}
    </div>
    {{/if}}

    {{#if isGM}}
    <div class="acks-extras-formation-lost">
      <h4>{{localize "ACKS-FORMATION.lost.legend"}}</h4>
      {{#if travel.lost.active}}
        <p class="acks-extras-formation-lost-astray">
          {{localize "ACKS-FORMATION.lost.astraySince" day=travel.lost.days hexes=travel.lost.fakedHexes}}
        </p>
        {{#if travel.lost.judgeNote}}<p class="hint">{{travel.lost.judgeNote}}</p>{{/if}}
        <div class="acks-extras-formation-lost-actions">
          <button type="button" data-action="lostDiscover"
                  data-tooltip="{{localize 'ACKS-FORMATION.lost.discoverHint'}}">
            <i class="fa-solid fa-eye"></i> {{localize "ACKS-FORMATION.lost.discover"}}
          </button>
          <button type="button" data-action="lostReanchor"
                  data-tooltip="{{localize 'ACKS-FORMATION.lost.reanchorHint'}}">
            <i class="fa-solid fa-map-pin"></i> {{localize "ACKS-FORMATION.lost.reanchor"}}
          </button>
        </div>
      {{else}}
        <button type="button" data-action="lostBegin" {{#unless travel.lost.hasHex}}disabled{{/unless}}
                data-tooltip="{{localize 'ACKS-FORMATION.lost.beginHint'}}">
          <i class="fa-solid fa-compass-drafting"></i> {{localize "ACKS-FORMATION.lost.begin"}}
        </button>
      {{/if}}
    </div>
    {{/if}}

    <div class="acks-extras-formation-travel-hex">
      <span class="acks-extras-formation-travel-hexlabel">{{localize "ACKS-FORMATION.travel.hex"}}:
        <strong>{{#if travel.hex}}{{travel.hex}}{{else}}—{{/if}}</strong>
        {{#if isGM}}{{#if travel.lost.active}}<i class="fa-solid fa-compass acks-extras-formation-travel-lost"
          data-tooltip="{{localize 'ACKS-FORMATION.travel.lostHint'}}"></i>{{/if}}{{/if}}
      </span>
      {{#if isGM}}
      <input type="text" name="travel.hexLabel" value="{{travel.hex}}"
             placeholder="{{localize 'ACKS-FORMATION.travel.hexPlaceholder'}}">
      <button type="button" data-action="travelEnterHex" data-tooltip="{{localize 'ACKS-FORMATION.travel.enterHexHint'}}">
        <i class="fa-solid fa-arrow-right"></i> {{localize "ACKS-FORMATION.travel.enterHex"}}
      </button>
      <button type="button" data-action="travelEncounterThrow" data-tooltip="{{localize 'ACKS-FORMATION.travel.enc.throwHint'}}">
        <i class="fa-solid fa-signs-post"></i> {{localize "ACKS-FORMATION.travel.enc.throw"}}
      </button>
      <span class="hint">{{localize "ACKS-FORMATION.travel.enteredToday" n=travel.hexesEntered}}</span>
      {{/if}}
    </div>

    {{#if isGM}}
    <div class="acks-extras-formation-travel-lostrow">
      <label class="checkbox">
        <input type="checkbox" name="travel.lostActive" {{checked travel.lost.active}}>
        {{localize "ACKS-FORMATION.travel.lost"}}
      </label>
      <input type="text" name="travel.lostNote" value="{{travel.lost.judgeNote}}"
             placeholder="{{localize 'ACKS-FORMATION.travel.lostNotePlaceholder'}}">
    </div>
    {{/if}}

    {{#if travel.log.length}}
    <ol class="acks-extras-formation-travel-log">
      {{#each travel.log}}
      <li>
        <span class="acks-extras-formation-travel-logday">{{localize "ACKS-FORMATION.travel.dayN" n=day}}</span>
        {{#if hex}}<span>{{hex}}</span>{{/if}}
        <span>{{kindLabel}}</span>
        {{#if miles}}<span>{{miles}} {{localize "ACKS-FORMATION.travel.milesShort"}}</span>{{/if}}
        {{#if @root.isGM}}{{#if lost}}<i class="fa-solid fa-compass acks-extras-formation-travel-lost"></i>{{/if}}{{/if}}
      </li>
      {{/each}}
    </ol>
    {{/if}}
  </section>
  {{else if isGM}}
  <section class="acks-extras-formation-travel">
    <button type="button" data-action="travelMode" data-tooltip="{{localize 'ACKS-FORMATION.travel.beginJourneyHint'}}">
      <i class="fa-solid fa-route"></i> {{localize "ACKS-FORMATION.travel.beginJourney"}}
    </button>
    <button type="button" data-action="settlementMode" data-tooltip="{{localize 'ACKS-FORMATION.settlement.enterHint'}}">
      <i class="fa-solid fa-city"></i> {{localize "ACKS-FORMATION.settlement.enter"}}
    </button>
  </section>
  {{/if}}

  <section class="lights">
    <h3>{{localize "ACKS-FORMATION.app.lights"}}</h3>
    {{#each lights}}
    <div class="light {{#unless this.lit}}unlit{{/unless}}" data-light-id="{{this.id}}">
      <i class="{{#if this.lit}}fa-solid fa-fire-flame-curved lit{{else}}fa-regular fa-fire-flame-curved{{/if}}"></i>
      <span class="label">{{this.label}} — {{this.bearer}}</span>
      <span class="remaining">{{this.remaining}} {{localize "ACKS-FORMATION.app.turnsLeft"}}{{#if this.shielded}} · {{localize "ACKS-FORMATION.app.shieldedBadge"}}{{/if}}</span>
      {{#if this.canControl}}
      {{#if this.shieldable}}
      <button type="button" data-action="toggleShield" class="{{#if this.shielded}}paused{{/if}}" data-tooltip="{{localize 'ACKS-FORMATION.app.shieldHint'}}">
        <i class="fa-solid {{#if this.shielded}}fa-door-closed{{else}}fa-door-open{{/if}}"></i>
      </button>
      {{/if}}
      <button type="button" data-action="toggleLight" data-tooltip="{{localize 'ACKS-FORMATION.app.toggleLightHint'}}">
        <i class="fa-solid {{#if this.lit}}fa-moon{{else}}fa-lightbulb{{/if}}"></i>
      </button>
      {{/if}}
      {{#if @root.isGM}}
      <button type="button" data-action="removeLight" class="danger"><i class="fa-solid fa-xmark"></i></button>
      {{/if}}
    </div>
    {{/each}}
    {{#if isGM}}
    <div class="add-light">
      <select name="lightType">
        {{#each lightTypes}}
        <option value="{{this.key}}">{{this.label}} ({{this.turns}} {{localize "ACKS-FORMATION.app.turns"}})</option>
        {{/each}}
      </select>
      <select name="lightBearer">
        {{#each bearerOptions}}
        <option value="{{this.id}}">{{this.name}}</option>
        {{/each}}
      </select>
      <button type="button" data-action="addLight"><i class="fa-solid fa-fire"></i> {{localize "ACKS-FORMATION.app.lightIt"}}</button>
    </div>
    {{/if}}
  </section>

  <section class="spells">
    <h3>{{localize "ACKS-FORMATION.app.spells"}}</h3>
    {{#each spells}}
    <div class="light" data-spell-id="{{this.id}}">
      <i class="fa-solid fa-wand-sparkles lit"></i>
      <span class="label">{{this.name}} — {{this.caster}}</span>
      <span class="remaining">{{this.remaining}} {{localize "ACKS-FORMATION.app.turnsLeft"}}</span>
      {{#if @root.isGM}}
      <button type="button" data-action="spellMinus" data-tooltip="{{localize 'ACKS-FORMATION.app.spellMinusHint'}}"><i class="fa-solid fa-minus"></i></button>
      <button type="button" data-action="spellPlus" data-tooltip="{{localize 'ACKS-FORMATION.app.spellPlusHint'}}"><i class="fa-solid fa-plus"></i></button>
      <button type="button" data-action="removeSpell" class="danger"><i class="fa-solid fa-xmark"></i></button>
      {{/if}}
    </div>
    {{/each}}
    {{#if isGM}}
    <div class="add-light add-spell">
      <select name="spellPick" data-tooltip="{{localize 'ACKS-FORMATION.app.spellPickHint'}}">
        <option value="">{{localize "ACKS-FORMATION.app.spellManual"}}</option>
        {{#each spellOptions}}
        <option value="{{this.key}}">{{this.label}}</option>
        {{/each}}
      </select>
      <input type="text" name="spellName" placeholder="{{localize 'ACKS-FORMATION.app.spellName'}}" />
      <input type="number" name="spellTurns" min="1" placeholder="{{localize 'ACKS-FORMATION.app.spellTurns'}}" />
      <select name="spellCaster">
        {{#each bearerOptions}}
        <option value="{{this.id}}">{{this.name}}</option>
        {{/each}}
      </select>
      <button type="button" data-action="addSpell" data-tooltip="{{localize 'ACKS-FORMATION.app.trackSpellHint'}}">
        <i class="fa-solid fa-wand-sparkles"></i> {{localize "ACKS-FORMATION.app.trackSpell"}}
      </button>
    </div>
    {{/if}}
  </section>

  <section class="maps">
    <h3>{{localize "ACKS-FORMATION.map.section"}}</h3>
    {{#if mapping.session}}
    <p class="session">
      <i class="fa-solid fa-map"></i> {{localize "ACKS-FORMATION.map.sessionLabel"}} <strong>{{mapping.itemName}}</strong>
      {{#if isGM}}{{#unless mapping.proficient}}<i class="fa-solid fa-pen-nib distorted" data-tooltip="{{localize 'ACKS-FORMATION.map.distortedHint'}}"></i>{{/unless}}{{/if}}
      {{#unless mapping.viewing}}<span class="warn">({{localize "ACKS-FORMATION.map.notViewing"}})</span>{{/unless}}
    </p>
    {{else}}
    <p class="hint">{{localize "ACKS-FORMATION.map.noSession"}}</p>
    {{/if}}
    {{#if isGM}}
    <div class="buttons">
      <button type="button" data-action="newMap" {{#unless mapping.canStart}}disabled{{/unless}}
              data-tooltip="{{localize 'ACKS-FORMATION.map.newMapHint'}}">
        <i class="fa-solid fa-map"></i> {{localize "ACKS-FORMATION.map.newMap"}}
      </button>
      {{#if mapping.session}}
      <button type="button" data-action="archiveMap" data-tooltip="{{localize 'ACKS-FORMATION.map.archiveHint'}}">
        <i class="fa-solid fa-floppy-disk"></i> {{localize "ACKS-FORMATION.map.archive"}}
      </button>
      <button type="button" data-action="closeMap" data-tooltip="{{localize 'ACKS-FORMATION.map.closeHint'}}">
        <i class="fa-solid fa-box-archive"></i> {{localize "ACKS-FORMATION.map.close"}}
      </button>
      {{/if}}
      <button type="button" data-action="saveFogMap" data-tooltip="{{localize 'ACKS-FORMATION.map.saveFogHint'}}">
        <i class="fa-solid fa-camera"></i> {{localize "ACKS-FORMATION.map.saveFog"}}
      </button>
    </div>
    {{/if}}
    {{#each mapItems}}
    <div class="light map-item" data-item-uuid="{{this.uuid}}">
      <i class="{{#if this.active}}fa-solid fa-map lit{{else}}fa-regular fa-map{{/if}}"></i>
      <span class="label clickable" data-action="openMapItem" data-tooltip="{{localize 'ACKS-FORMATION.map.openHint'}}">
        {{this.name}} — {{this.holder}} <em>({{this.sceneName}})</em>
        {{#if this.distorted}}<i class="fa-solid fa-pen-nib distorted" data-tooltip="{{localize 'ACKS-FORMATION.map.distortedHint'}}"></i>{{/if}}
        {{#if this.anchored}}<i class="fa-solid fa-anchor" data-tooltip="{{localize 'ACKS-FORMATION.map.anchoredHint'}}"></i>{{/if}}
      </span>
      <button type="button" data-action="anchorMap" {{#unless this.canAnchor}}disabled{{/unless}}
              data-tooltip="{{#if this.canAnchor}}{{localize 'ACKS-FORMATION.map.anchorHint'}}{{else}}{{this.anchorReason}}{{/if}}">
        <i class="fa-solid fa-anchor"></i> {{localize "ACKS-FORMATION.map.anchor"}}
      </button>
    </div>
    {{/each}}
  </section>

  {{else}}
  <p class="hint empty-state">{{localize "ACKS-FORMATION.app.emptyState"}}</p>
  {{/if}}
</div>
