<div class="acks-extras-encounter-card">
  <header class="acks-extras-encounter-card-header">
    <i class="fa-solid fa-signs-post"></i>
    <strong>{{localize "ACKS-FORMATION.travel.enc.title"}}</strong>
    <span class="acks-extras-encounter-card-cadence">{{activity}}{{#if night}} · {{localize "ACKS-FORMATION.travel.enc.night"}}{{/if}}</span>
    {{#if hexLabel}}<span class="hint">{{hexLabel}}</span>{{/if}}
  </header>

  {{#if zone}}
  <p class="hint">{{localize "ACKS-FORMATION.travel.enc.zoneLine" names=zone}}</p>
  {{/if}}

  {{#if missingTerritory}}
  <p class="acks-extras-encounter-card-book">{{localize "ACKS-FORMATION.travel.enc.importHint"}}</p>
  {{else}}
  {{#if rolls.length}}
  <ol class="acks-extras-encounter-card-rolls">
    {{#each rolls}}
    <li>{{column}} — <strong>{{roll}}</strong> → {{outcome}}</li>
    {{/each}}
  </ol>
  {{/if}}

  {{#if zoneThrow}}
  <p>{{localize "ACKS-FORMATION.travel.enc.zoneThrow"}} <span class="hint">d6</span> — <strong>{{zoneThrow.roll}}</strong> → {{zoneThrow.target}}+</p>
  {{/if}}

  {{#if downgraded}}
  <p class="hint">{{localize "ACKS-FORMATION.travel.enc.downgraded" kind=downgraded}}</p>
  {{/if}}

  {{#if isNone}}
  <p class="acks-extras-encounter-card-none">{{localize "ACKS-FORMATION.travel.enc.quiet"}}</p>
  {{else}}

  {{#if noTerrain}}
  <p class="acks-extras-encounter-card-book">{{localize "ACKS-FORMATION.travel.enc.pickTerrain"}}</p>
  {{else}}
  <p class="hint">{{localize "ACKS-FORMATION.travel.enc.terrainUsed"}}: {{terrain}}</p>
  {{/if}}

  {{#if rarity}}
  <p>{{localize "ACKS-FORMATION.travel.enc.rarityLine"}}: <strong>{{rarity.roll}}</strong> → {{rarity.label}}</p>
  {{/if}}

  {{#if creature}}
  <p class="acks-extras-encounter-card-creature">
    <strong>{{creature.roll}}</strong> →
    {{#if creature.link}}{{creature.link}}{{else}}<strong>{{creature.name}}</strong>{{/if}}
  </p>
  {{/if}}

  {{#if zoneDraw}}
  <p class="acks-extras-encounter-card-creature">{{localize "ACKS-FORMATION.travel.enc.zoneDrawLine" table=zoneDraw.table}}{{#if zoneDraw.total}} — <strong>{{zoneDraw.total}}</strong>{{/if}}</p>
  <ul class="acks-extras-enc-lines">
    {{#each zoneDraw.rows}}
    <li class="acks-extras-enc-line">{{#if link}}{{link}}{{else}}<strong>{{text}}</strong>{{/if}}</li>
    {{/each}}
  </ul>
  {{/if}}
  {{#if zoneMissing}}
  <p class="acks-extras-encounter-card-book">{{localize "ACKS-FORMATION.travel.enc.zoneTableGone" zone=zoneMissing}}</p>
  {{/if}}

  {{#if terrainLines.length}}
  <ul class="acks-extras-enc-lines">
    {{#each terrainLines}}
    <li class="acks-extras-enc-line acks-extras-enc-depth-{{depth}} acks-extras-enc-{{kind}}">
      {{text}}{{#if die}} <span class="hint">d{{die}}</span>{{/if}}{{#if roll}} — <strong>{{roll}}</strong>{{/if}}{{#if name}}{{#if roll}} →{{else}}:{{/if}} {{#if link}}{{link}}{{else}}<strong>{{name}}</strong>{{/if}}{{/if}}
      {{#if trap}}<br><span class="acks-extras-enc-trap">{{localize "ACKS-FORMATION.travel.enc.draw.trap"}}: <strong>{{trap}}</strong></span>{{/if}}
    </li>
    {{/each}}
  </ul>
  <p class="hint">{{localize "ACKS-FORMATION.travel.enc.resolveBook"}}</p>
  {{/if}}
  {{#if marked}}
  <p class="hint">{{localize "ACKS-FORMATION.travel.enc.marked"}}</p>
  {{/if}}

  {{#each missing}}
  <p class="acks-extras-encounter-card-book">{{localize "ACKS-FORMATION.travel.enc.missingTable" table=this}}</p>
  {{/each}}
  {{#if noRow}}
  <p class="acks-extras-encounter-card-book">{{localize "ACKS-FORMATION.travel.enc.noRow"}}</p>
  {{/if}}

  {{#if distance}}
  <p>{{localize "ACKS-FORMATION.travel.enc.distanceLine"}}: <strong>{{distance.feet}}'</strong>
    <span class="hint">({{distance.dice}} × {{distance.mult}})</span></p>
  {{/if}}
  {{#each when}}
  <p class="acks-extras-encounter-card-when">{{this}}</p>
  {{/each}}
  {{#if visible}}
  <p class="hint">{{localize "ACKS-FORMATION.travel.enc.visibleLine" feet=visible size=partySize}}</p>
  {{/if}}
  {{#if effects.length}}
  <p>{{#each effects}}<span class="acks-extras-encounter-card-mod">{{label}}{{#if value}} {{value}}{{/if}}</span> {{/each}}</p>
  {{/if}}

  {{#if evasion}}
  <p>{{localize "ACKS-FORMATION.travel.enc.evasionLine" target=evasion size=partySize}}
    {{#each evasionMods}}<span class="acks-extras-encounter-card-mod">{{label}} {{value}}</span>{{/each}}
  </p>
  {{/if}}

  <p class="hint">{{localize "ACKS-FORMATION.travel.enc.handoff"}}</p>
  {{/if}}
  {{/if}}
</div>
