{{!-- A list of favors or duties: a label and a note per row.
      Context: {array, title, rows, lock, canEdit}. --}}
<div class="acks-extras-domain-sheet__block">
  <h3 class="acks-extras-domain-sheet__block-title">{{localize title}} ({{rows.length}})</h3>
  {{#if rows.length}}
  <table class="acks-table acks-extras-domain-table">
    <tbody>
      {{#each rows}}
      <tr>
        <td><input type="text" name="system.{{../array}}.{{index}}.label" value="{{label}}" {{@root.lock}}
                   aria-label="{{localize 'ACKS-DOMAINS.field.label'}}" /></td>
        <td><input type="text" name="system.{{../array}}.{{index}}.note" value="{{note}}" {{@root.lock}}
                   aria-label="{{localize 'ACKS-DOMAINS.field.note'}}" placeholder="{{localize 'ACKS-DOMAINS.field.note'}}" /></td>
        <td class="row-actions">
          {{#if @root.canEdit}}<button type="button" class="acks-btn acks-btn--quiet acks-btn--icon" data-action="rowDelete" data-array="{{../array}}" data-index="{{index}}" aria-label="{{localize 'ACKS-DOMAINS.sheet.removeRowTitle'}}"><i class="fa-solid fa-xmark" inert></i></button>{{/if}}
        </td>
      </tr>
      {{/each}}
    </tbody>
  </table>
  {{/if}}
  {{#if canEdit}}
  <div class="acks-extras-domain-sheet__actions">
    <button type="button" class="acks-btn acks-btn--secondary acks-btn--sm" data-action="rowAdd" data-array="{{array}}">
      <i class="fa-solid fa-plus" inert></i> {{localize "ACKS-DOMAINS.sheet.addRow"}}
    </button>
  </div>
  {{/if}}
</div>
