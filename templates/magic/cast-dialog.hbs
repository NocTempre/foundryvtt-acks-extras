<div class="acks-extras-cast-dialog">
  {{#if hasModes}}
  <div class="form-group">
    <label>
      <span>{{localize "ACKS-MAGIC.cast.dialog.modeLabel"}}</span>
      <select name="mode" data-cast-mode>
        {{#each modes}}<option value="{{key}}"{{#if selected}} selected{{/if}}>{{label}}</option>{{/each}}
      </select>
    </label>
  </div>
  {{/if}}

  {{#if declaring}}<p class="hint">{{declaring}}</p>{{/if}}

  {{#each groups}}
  <fieldset class="acks-extras-cast-group" data-cast-for="{{mode}}">
    <legend>{{legend}}</legend>
    <label>
      <span>{{label}}</span>
      <select data-pick="{{id}}" data-pick-mode="{{mode}}">
        {{#each options}}<option value="{{key}}">{{label}}</option>{{/each}}
      </select>
    </label>
  </fieldset>
  {{/each}}

  {{#each weapon.modes}}
  <div class="form-group" data-cast-for="{{this}}">
    <label>
      <span>{{localize "ACKS-MAGIC.cast.dialog.weapon"}}</span>
      <select data-weapon>
        {{#each ../weapon.options}}<option value="{{id}}">{{label}}</option>{{/each}}
      </select>
    </label>
  </div>
  {{/each}}

  {{#if level.show}}
  <div class="form-group">
    <label>
      <span>{{localize "ACKS-MAGIC.cast.dialog.level"}}</span>
      <input type="number" name="casterLevel" min="1" step="1" value="" data-tooltip-text="{{level.tip}}">
    </label>
    <p class="hint">{{localize "ACKS-MAGIC.cast.dialog.levelHint"}}</p>
  </div>
  {{else if level.value}}
  <p class="hint" data-tooltip-text="{{level.tip}}">{{level.line}}</p>
  {{/if}}

  {{#if saves}}
  <div class="form-group">
    <label>
      <span>{{localize "ACKS-MAGIC.cast.dialog.situational"}}</span>
      <input type="number" name="situational" step="1" placeholder="0" data-tooltip-text="{{situationalTip}}">
    </label>
  </div>
  {{/if}}

  <div class="form-group">
    <label>
      <span>{{localize "ACKS-MAGIC.cast.dialog.visibility"}}</span>
      <select name="visibility">
        {{#each visibility}}<option value="{{key}}"{{#if selected}} selected{{/if}}>{{label}}</option>{{/each}}
      </select>
    </label>
  </div>

  {{#if capacity.line}}<p class="hint" data-tooltip-text="{{capacity.tip}}">{{capacity.line}}</p>{{/if}}

  <section class="acks-extras-cast-targets">
    <h4>{{localize "ACKS-MAGIC.cast.dialog.targets"}}</h4>
    {{#if targets.length}}
    <ul>{{#each targets}}<li>{{name}}</li>{{/each}}</ul>
    {{else}}
    <p class="hint">{{localize "ACKS-MAGIC.cast.dialog.noTargets"}}</p>
    {{/if}}
  </section>

  {{#each splits}}
  <fieldset class="acks-extras-cast-split" data-cast-for="{{mode}}" data-alloc-row="{{key}}" data-alloc-count="{{count}}"{{#if pick}} data-alloc-pick="{{pick}}" data-alloc-option="{{option}}"{{/if}} data-tooltip-text="{{tip}}">
    <legend>{{label}}</legend>
    <p class="hint">{{rowLabel}}</p>
    {{#each inputs}}
    <div class="form-group">
      <label>
        <span>{{name}}</span>
        <input type="number" min="0" step="1" value="{{value}}" data-alloc-index="{{index}}">
      </label>
    </div>
    {{/each}}
    <p class="hint" data-alloc-over data-alloc-severity="{{severity}}" hidden>{{over}}</p>
  </fieldset>
  {{/each}}

  {{#if rangeNote}}<p class="hint">{{rangeNote}}</p>{{/if}}

  {{#each verdicts}}
  <ul class="acks-extras-cast-verdicts notes" data-cast-for="{{mode}}">
    {{#each items}}<li data-severity="{{severity}}"{{#if tip}} data-tooltip-text="{{tip}}"{{/if}}>{{text}}</li>{{/each}}
  </ul>
  {{/each}}
</div>
