{{!-- The Blood sacrifice window's scrolling body (`apps/sacrifice-window.mjs`, `scripts/magic/sacrifice.mjs`
      `panelModel`): the caster and the victims' portraits, the victims bucket (lib's partial, each victim's checks
      inside its own row by `sacrifice-victim.hbs`), the site and the class power, and the yield. A control is read
      back by its data-* hooks; every checkbox sits inside its own label, so no id is written. --}}
<section class="acks-extras-sacrifice-body">
  <header class="acks-extras-sacrifice-head">
    {{#if caster.img}}<img class="acks-extras-sacrifice-portrait" src="{{caster.img}}" alt="" inert>{{/if}}
    <h2 class="acks-extras-sacrifice-who">{{caster.name}}</h2>
    {{#if bucket.rows.length}}
    <span class="acks-extras-sacrifice-to" role="img" aria-label="{{localize 'ACKS-MAGIC.sacrifice.victims'}}: {{bucket.rows.length}}">
      <i class="fa-solid fa-arrow-right" inert></i>
      {{#each bucket.rows}}<img class="acks-extras-sacrifice-portrait is-small{{#if off}} is-off{{/if}}" src="{{img}}" alt="" inert>{{/each}}
    </span>
    {{/if}}
  </header>

  {{> "modules/acks-extras/templates/lib/bucket.hbs" bucket}}

  <section class="acks-extras-sacrifice-band">
    <label class="acks-extras-sacrifice-check" data-tooltip-text="{{site.tip}}"><input type="checkbox" name="site"{{#if site.checked}} checked{{/if}}{{#if site.disabled}} disabled{{/if}}> <span>{{site.label}}</span></label>
    {{#if power.shown}}
    <label class="acks-extras-sacrifice-check" data-tooltip-text="{{power.tip}}"><input type="checkbox" name="power"{{#if power.checked}} checked{{/if}}{{#if power.disabled}} disabled{{/if}}> <span>{{power.label}}</span></label>
    {{/if}}
    <dl class="acks-extras-sacrifice-yield">
      <dt data-tooltip-text="{{yield.now.tip}}">{{yield.now.label}}</dt>
      <dd class="acks-nums" data-tooltip-text="{{yield.now.tip}}">{{yield.now.text}}</dd>
      <dt data-tooltip-text="{{yield.bonus.tip}}">{{yield.bonus.label}}</dt>
      <dd class="acks-nums" data-tooltip-text="{{yield.bonus.tip}}">{{yield.bonus.text}}</dd>
    </dl>
  </section>
</section>
