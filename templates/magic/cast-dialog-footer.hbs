{{!-- The cast dialog's pinned footer: where the cast is seen, what stands in its
      way, the note a declaration carries, and the two answers. A separate part so it stays put while the body
      scrolls. --}}
<footer class="acks-extras-cast-foot">
  {{#with footer as |f|}}
  {{#if f.verdicts.length}}
  <ul class="acks-extras-cast-verdicts">
    {{#each f.verdicts}}<li data-severity="{{severity}}" class="is-{{severity}}"{{#if tip}} data-tooltip-text="{{tip}}"{{/if}}><i class="fa-solid {{#if (eq severity 'block')}}fa-ban{{else}}fa-triangle-exclamation{{/if}}" inert></i>{{text}}</li>{{/each}}
  </ul>
  {{/if}}
  <div class="acks-extras-cast-foot__bar">
    {{#if f.declaring}}<p class="acks-extras-cast-hint acks-extras-cast-foot__note">{{f.declaring}}</p>{{/if}}
    {{#unless f.ritual}}
    {{#if f.capacity.line}}<span class="acks-extras-cast-hint" data-tooltip-text="{{f.capacity.tip}}">{{f.capacity.line}}</span>{{/if}}
    <label class="acks-extras-cast-vis">
      <span>{{localize "ACKS-MAGIC.cast.dialog.visibility"}}</span>
      <select name="visibility">
        {{#each f.visibility}}<option value="{{key}}"{{#if selected}} selected{{/if}}>{{label}}</option>{{/each}}
      </select>
    </label>
    {{/unless}}
    <button type="button" data-action="cancel"><i class="fa-solid fa-xmark" inert></i>{{localize "ACKS-MAGIC.cast.dialog.cancel"}}</button>
    <button type="button" class="acks-extras-cast-go" data-action="cast"{{#if f.blocked}} disabled{{/if}}><i class="fa-solid fa-wand-sparkles" inert></i>{{f.cast}}</button>
  </div>
  {{/with}}
</footer>
