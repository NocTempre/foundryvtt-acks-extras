<section class="tab {{tab.cssClass}}" data-group="primary" data-tab="animal">
  <div class="content flexcol acksm-content">

    <fieldset>
      <legend>{{localize "ACKS-MONSTERS.section.animalRole"}}
        {{#if animal.imported}}<span class="acksm-cat-tag">{{localize "ACKS-MONSTERS.animal.imported"}}</span>{{/if}}
      </legend>

      <div class="flexrow">
        <div class="form-group">
          <label>{{localize "ACKS-MONSTERS.field.animalTraining"}}</label>
          <div class="form-fields">
            <select name="system.animal.training">
              {{selectOptions animal.trainingChoices selected=animal.training localize=true}}
            </select>
          </div>
        </div>
        <div class="form-group">
          <label>{{localize "ACKS-MONSTERS.field.animalMountable"}}</label>
          <div class="form-fields">
            <label class="acksm-cb">
              <input type="checkbox" name="system.animal.mountable" {{#if animal.mountable}}checked{{/if}}/>
              {{localize "ACKS-MONSTERS.animal.mountableLabel"}}
            </label>
          </div>
        </div>
      </div>

      <p class="hint">{{localize "ACKS-MONSTERS.animal.roleHint"}}</p>
      <p class="hint">{{localize "ACKS-MONSTERS.animal.loadHint"}}</p>
    </fieldset>

  </div>
</section>
