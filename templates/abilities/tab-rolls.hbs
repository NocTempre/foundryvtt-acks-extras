{{!
  The ability's throws, as a list you can add to, delete from and open. Each row
  IS the roll button; the pencil opens the throw's own window, where everything
  about it — including its level table — is edited.
}}
<section class="tab acks-abilities-rolls {{tabs.rolls.cssClass}}" data-tab="rolls" data-group="primary">

  {{#if extras.unaudited}}
    <p class="notification info acks-abilities-notice" data-tooltip="{{localize 'ACKS-ABILITIES.warn.unauditedTip'}}">
      <i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i>
      {{localize "ACKS-ABILITIES.warn.unaudited"}}
    </p>
  {{/if}}

  {{#if rollRows.length}}
    <p class="hint">{{localize "ACKS-ABILITIES.roll.hint"}}</p>
    <ol class="acks-abilities-roll-list">
      {{#each rollRows}}
        <li class="acks-abilities-roll">
          <div class="acks-abilities-roll-head">
            <button type="button" class="acks-abilities-roll-go" data-action="rollOne" data-roll-key="{{this.key}}"
                    data-tooltip="{{localize 'ACKS-ABILITIES.roll.go'}}">
              <i class="fa-solid fa-dice-d20"></i>
              <span class="acks-abilities-roll-label">{{this.label}}</span>
              <span class="acks-abilities-roll-value">{{this.display}}</span>
            </button>
            {{#if @root.editable}}
              {{!-- The printed order is the stored order: these move a throw
                    through it. Ends are omitted rather than disabled. --}}
              {{#unless @first}}
              <a class="acks-abilities-mini" data-action="moveRollUp" data-roll-key="{{this.key}}"
                 data-tooltip="{{localize 'ACKS-ABILITIES.roll.moveUp'}}"><i class="fa-solid fa-arrow-up"></i></a>
              {{/unless}}
              {{#unless @last}}
              <a class="acks-abilities-mini" data-action="moveRollDown" data-roll-key="{{this.key}}"
                 data-tooltip="{{localize 'ACKS-ABILITIES.roll.moveDown'}}"><i class="fa-solid fa-arrow-down"></i></a>
              {{/unless}}
              <a class="acks-abilities-mini" data-action="editRoll" data-roll-key="{{this.key}}"
                 data-tooltip="{{localize 'ACKS-ABILITIES.roll.edit'}}"><i class="fa-solid fa-pen-to-square"></i></a>
              <a class="acks-abilities-mini" data-action="deleteRoll" data-roll-key="{{this.key}}"
                 data-tooltip="{{localize 'ACKS-ABILITIES.roll.delete'}}"><i class="fa-solid fa-trash"></i></a>
            {{/if}}
          </div>
          {{#if this.note}}<p class="hint acks-abilities-roll-note">{{this.note}}</p>{{/if}}
          {{#if this.readAt}}<p class="hint acks-abilities-roll-cond">{{this.readAt}}</p>{{/if}}
          {{#if this.condition}}<p class="hint acks-abilities-roll-cond">{{this.condition}}</p>{{/if}}
          {{#if this.ladder}}
            <div class="acks-abilities-ladder-wrap">
              <table class="acks-abilities-ladder">
                <tr><th>{{this.ladder.scaleLabel}}</th>{{#each this.ladder.steps}}<td>{{this}}</td>{{/each}}</tr>
                <tr><th>{{localize "ACKS-ABILITIES.mech.throw"}}</th>{{#each this.ladder.values}}<td>{{this}}</td>{{/each}}</tr>
              </table>
            </div>
          {{/if}}
        </li>
      {{/each}}
    </ol>
  {{else}}
    <p class="hint">{{localize "ACKS-ABILITIES.roll.none"}}</p>
  {{/if}}

  {{#if editable}}
    <footer class="acks-abilities-roll-add">
      <button type="button" data-action="addRoll">
        <i class="fa-solid fa-plus"></i> {{localize "ACKS-ABILITIES.roll.add"}}
      </button>
      <p class="hint">{{localize "ACKS-ABILITIES.roll.addHint"}}</p>
    </footer>
  {{/if}}

</section>
