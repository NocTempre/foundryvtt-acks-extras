{{!-- Followers: the roster chip, the wage line, and the Follower Cards. --}}
{{#with panels.followers as |fw|}}
<div class="acks-extras-frame__stack">
  <div class="acks-extras-frame__rule">
    <span class="acks-extras-frame__rule-title">{{localize "ACKS-CHARACTER.followers.title"}}</span>
    {{#if fw.editable}}{{#unless fw.isRetainer}}
    <button type="button" class="acks-extras-frame__chip" data-action="roster" data-tooltip="{{localize 'ACKS-HENCHMEN.roster.open'}}"><i class="fa-solid fa-people-group" inert></i>{{localize "ACKS-CHARACTER.followers.roster"}}</button>
    {{/unless}}{{/if}}
    {{#if fw.payroll}}
    <span class="acks-extras-frame__rule-note acks-nums">{{#if fw.due}}{{localize "ACKS-CHARACTER.followers.wages" gp=fw.due}}{{else if fw.nextDueDays}}{{localize "ACKS-CHARACTER.followers.monthlyNext" gp=fw.wages days=fw.nextDueDays}}{{else}}{{localize "ACKS-CHARACTER.followers.monthly" gp=fw.wages}}{{/if}}</span>
    {{#if fw.due}}{{#if fw.editable}}<button type="button" class="acks-extras-frame__chip" data-action="payWages"><i class="fa-solid fa-coins" inert></i>{{localize "ACKS-CHARACTER.followers.pay"}}</button>{{/if}}{{/if}}
    {{/if}}
  </div>
  {{#each fw.groups as |g|}}
  <div class="acks-extras-frame__group">
    <div class="acks-extras-frame__subhead"><span>{{g.title}}</span></div>
    <div class="acks-extras-frame__cards">
      {{#each g.cards as |card|}}
      {{!-- The card carries its own controls (Show, Dismiss, the two throws),
            resolved by this wrapper's actor id. --}}
      <div class="acks-extras-frame__card" data-actor-id="{{card.id}}">
        {{#if card.html}}{{{card.html}}}{{else}}<div class="acks-extras-frame__row"><img class="acks-extras-frame__gear-img" src="{{card.img}}" alt="" inert><span class="acks-extras-frame__row-name">{{card.name}}</span></div>{{/if}}
      </div>
      {{/each}}
    </div>
  </div>
  {{/each}}
  {{#unless fw.count}}<div class="acks-empty"><span class="acks-empty-title">{{localize "ACKS-CHARACTER.followers.title"}}</span><span class="acks-empty-hint">{{fw.emptyHint}}</span></div>{{/unless}}
</div>
{{/with}}
