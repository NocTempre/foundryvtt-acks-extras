{{!-- The art row: the left rail, the portrait, the right rail, the prose
      column and the sheet-tools rail. Folded, only the rails and the portrait
      remain. Context: cells {left, right} of cell.hbs objects; art {img, alt,
      overline, prose, proseSource, proseField, editing, tags}; sheetTools
      [{key, icon, title}]; editable; folded; actor.uuid. --}}
<div class="acks-extras-frame__rail acks-extras-frame__rail--left">
  {{#each cells.left}}{{> "modules/acks-extras/templates/lib/frame/cell.hbs" this}}{{/each}}
</div>

<div class="acks-extras-frame__art">
  {{#if editable}}
  <img class="acks-extras-frame__img" src="{{art.img}}" alt="{{art.alt}}" data-action="editImage" data-edit="img" data-tooltip="{{art.changeTitle}}">
  {{else}}
  <img class="acks-extras-frame__img" src="{{art.img}}" alt="{{art.alt}}">
  {{/if}}
</div>

<div class="acks-extras-frame__rail acks-extras-frame__rail--right">
  {{#each cells.right}}{{> "modules/acks-extras/templates/lib/frame/cell.hbs" this}}{{/each}}
</div>

{{#unless folded}}
<div class="acks-extras-frame__prose">
  <div class="acks-extras-frame__prose-body">
    <div class="acks-extras-frame__overline">{{art.overline}}</div>
    {{#if art.editing}}
    <prose-mirror class="acks-extras-frame__editor" name="{{art.proseField}}" value="{{art.proseSource}}" toggled
                  data-document-uuid="{{actor.uuid}}">{{{art.prose}}}</prose-mirror>
    {{else}}
    <div class="acks-extras-frame__description acks-prose">{{{art.prose}}}</div>
    {{/if}}
    {{#if art.tags.length}}
    <div class="acks-tag-group">
      {{#each art.tags}}<span class="acks-tag">{{this}}</span>{{/each}}
    </div>
    {{/if}}
  </div>
  {{#if editable}}
  <div class="acks-extras-frame__rail acks-extras-frame__rail--tools">
    {{#each sheetTools}}
    <button type="button" class="acks-extras-frame__cell is-icon" data-action="{{key}}" data-tooltip="{{title}}">
      <i class="{{icon}}" inert></i><span class="acks-sr-only">{{title}}</span>
    </button>
    {{/each}}
  </div>
  {{/if}}
</div>
{{/unless}}
