{{!
  One effect row of one list. The kind is chosen first; the fields under it
  are the ones that kind reads, and a change re-renders the window with the
  new kind's fields. Fields apply as they are made, except the rungs of an
  invocation-level ladder: they are drafted inline and written by the pinned
  footer's Save row (`rung-footer.hbs`).
}}
<div class="acks-extras-effect-editor-body">

  <div class="form-group">
    <label>{{localize "ACKS-LIB.effectEditor.type"}}</label>
    <div class="form-fields">
      <select name="type">{{selectOptions types selected=row.type}}</select>
    </div>
    <p class="hint">{{localize "ACKS-LIB.effectEditor.typeHint"}}</p>
  </div>

  {{#each fields as |f|}}
    {{#if (eq f.kind "set")}}
      <fieldset class="acks-extras-effect-set"{{#if f.tip}} data-tooltip-text="{{f.tip}}"{{/if}}>
        <legend>{{f.label}}</legend>
        <div class="acks-extras-effect-picks">
          {{#each f.options as |o|}}
            <label class="acks-extras-effect-pick">
              <input type="checkbox" name="{{f.name}}.{{o.key}}" {{checked o.checked}}>
              <span>{{o.label}}</span>
            </label>
          {{/each}}
        </div>
      </fieldset>
    {{else if (eq f.kind "levelValue")}}
      <fieldset class="acks-extras-effect-value">
        <legend>{{f.label}}</legend>
        <div class="form-group">
          {{!-- label-ok: the button group beside it is a role=group that names itself by aria-label --}}
          <label>{{localize "ACKS-LIB.effectEditor.value.kind"}}</label>
          <div class="form-fields">
            {{> "modules/acks-extras/templates/lib/figure-kind.hbs" f.kindGroup}}
          </div>
        </div>
        {{#if f.isInvocation}}
          {{> "modules/acks-extras/templates/lib/rung-ladder.hbs" f.ladder}}
        {{else if f.isFlat}}
          <div class="form-group">
            <label>{{localize "ACKS-LIB.effectEditor.value.flat"}}</label>
            <div class="form-fields">
              <input type="number" step="any" name="{{f.name}}.flat" value="{{f.value.flat}}" placeholder="—">
            </div>
          </div>
        {{else if f.isPerLevel}}
          <div class="form-group">
            <label>{{localize "ACKS-LIB.effectEditor.value.base"}}</label>
            <div class="form-fields">
              <input type="number" step="any" name="{{f.name}}.base" value="{{f.value.base}}" placeholder="—">
            </div>
          </div>
          <div class="form-group">
            <label>{{localize "ACKS-LIB.effectEditor.value.per"}}</label>
            <div class="form-fields">
              <input type="number" step="any" name="{{f.name}}.per" value="{{f.value.per}}" placeholder="—">
            </div>
          </div>
          <div class="form-group">
            <label>{{localize "ACKS-LIB.effectEditor.value.round"}}</label>
            <div class="form-fields">
              <select name="{{f.name}}.round">{{selectOptions f.rounds selected=f.value.round blank=@root.none}}</select>
            </div>
          </div>
        {{else}}
          <p class="hint">{{localize "ACKS-LIB.effectEditor.value.ladder"}}</p>
        {{/if}}
      </fieldset>
    {{else if (eq f.kind "creatures")}}
      {{!-- The creature list of a spell's summon row. Its boxes carry no name: the form never submits them, the list writes them. --}}
      <fieldset class="acks-extras-summon-list" data-acks-extras-summon-list>
        <legend>{{f.label}}</legend>
        <ul class="acks-extras-summon-lines">
          {{#each f.lines as |line|}}
            <li class="acks-extras-summon-line">
              <div class="acks-extras-summon-who">
                <span class="acks-extras-summon-name{{#if line.blank}} is-blank{{/if}}">{{line.label}}</span>
                {{#if line.source}}<span class="acks-extras-summon-from">{{line.source}}</span>{{/if}}
                {{#if line.note}}<span class="acks-extras-summon-from">{{line.note}}</span>{{/if}}
              </div>
              <div class="acks-extras-summon-ends">
                <input type="number" step="1" min="0" class="acks-extras-summon-amount" data-summon-amount data-index="{{line.index}}" value="{{line.amount}}" placeholder="—" aria-label="{{line.amountAria}}"{{#if line.tip}} data-tooltip-text="{{line.tip}}"{{/if}}>
                {{#if line.removable}}
                  <button type="button" class="acks-extras-summon-remove" data-action="summonRemove" data-index="{{line.index}}" aria-label="{{line.removeAria}}" data-tooltip><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
                {{/if}}
              </div>
            </li>
          {{/each}}
        </ul>
        <p class="hint">{{localize "ACKS-LIB.effectEditor.creaturesDrop"}}</p>
        <div class="acks-extras-summon-add">
          <input type="text" class="acks-extras-summon-uuid" data-summon-add placeholder="{{localize 'ACKS-LIB.effectEditor.addRef'}}" aria-label="{{localize 'ACKS-LIB.effectEditor.addRef'}}">
          <button type="button" data-action="summonAdd">{{localize "ACKS-LIB.effectEditor.add"}}</button>
        </div>
      </fieldset>
    {{else if (eq f.kind "reach")}}
      {{!-- The reach group. A disabled fieldset submits nothing, so a seat the store does not let write changes nothing. The figure and the unit are read from the import and typed nowhere. --}}
      <fieldset class="acks-extras-effect-reach"{{#if f.disabled}} disabled{{/if}}>
        <legend>{{f.label}}</legend>
        {{#if f.use}}
          <div class="form-group" data-tooltip-text="{{f.use.tip}}">
            <label>{{f.use.label}}</label>
            <div class="form-fields">
              {{!-- No name: the item's use is the item's, written on change by the window, never by the row's form. --}}
              <select data-acks-extras-item-use aria-label="{{f.use.label}}"{{#if f.use.disabled}} disabled{{/if}}>{{selectOptions f.use.choices selected=f.use.value}}</select>
            </div>
          </div>
        {{/if}}
        {{#if f.once}}
          <div class="form-group" data-tooltip-text="{{f.once.tip}}">
            <label>{{f.once.label}}</label>
            <div class="form-fields">
              {{!-- No name: the item's once mark is the item's, written on change by the window, never by the row's form. --}}
              <input type="checkbox" data-acks-extras-item-uses aria-label="{{f.once.label}}" {{checked f.once.checked}}>
            </div>
          </div>
        {{/if}}
        <div class="form-group">
          <label>{{f.mode.label}}</label>
          <div class="form-fields">
            <select name="reach.mode" aria-label="{{f.mode.label}}">{{selectOptions f.mode.choices selected=f.mode.value}}</select>
          </div>
        </div>
        <div class="form-group"{{#if f.figure.tip}} data-tooltip-text="{{f.figure.tip}}"{{/if}}>
          {{!-- label-ok: read-only text, not a control a label can name --}}
          <label>{{f.figure.label}}</label>
          <div class="form-fields">
            <output class="acks-extras-effect-readonly" tabindex="0">{{f.figure.text}}</output>
            {{#if f.figure.page}}<span class="acks-extras-effect-cite">{{f.figure.page}}</span>{{/if}}
          </div>
          <p class="hint">{{f.figure.hint}}</p>
        </div>
        <div class="form-group">
          <label>{{f.side.label}}</label>
          <div class="form-fields">
            <select name="reach.side" aria-label="{{f.side.label}}">{{selectOptions f.side.choices selected=f.side.value}}</select>
          </div>
        </div>
        {{#each f.picks as |pick|}}
          <fieldset class="acks-extras-effect-set" data-tooltip-text="{{pick.tip}}">
            <legend>{{pick.label}}</legend>
            <div class="acks-extras-effect-picks">
              {{#each pick.options as |o|}}
                <label class="acks-extras-effect-pick">
                  <input type="checkbox" name="{{pick.name}}.{{o.key}}" {{checked o.checked}}>
                  <span>{{o.label}}</span>
                </label>
              {{/each}}
            </div>
          </fieldset>
        {{/each}}
        {{#if f.unit}}
          <div class="form-group"{{#if f.unit.tip}} data-tooltip-text="{{f.unit.tip}}"{{/if}}>
            {{!-- label-ok: read-only text, not a control a label can name --}}
            <label>{{f.unit.label}}</label>
            <div class="form-fields">
              <output class="acks-extras-effect-readonly" tabindex="0">{{f.unit.text}}</output>
            </div>
          </div>
        {{/if}}
        <div class="form-group">
          <label>{{f.show.label}}</label>
          <div class="form-fields">
            <input type="checkbox" name="reach.showReach" {{checked f.show.checked}}>
          </div>
          <p class="hint">{{f.show.hint}}</p>
        </div>
      </fieldset>
    {{else if (eq f.kind "readonly")}}
      <div class="form-group"{{#if f.tip}} data-tooltip-text="{{f.tip}}"{{/if}}>
        {{!-- label-ok: read-only text, not a control a label can name --}}
        <label>{{f.label}}</label>
        <div class="form-fields">
          <output class="acks-extras-effect-readonly" tabindex="0">{{f.text}}</output>
        </div>
      </div>
    {{else}}
      {{!-- A disabled control takes no pointer events, so a tooltip riding on one sits on its group. --}}
      <div class="form-group"{{#if f.drop}} data-acks-extras-ref-drop{{/if}}{{#if f.tip}} data-tooltip-text="{{f.tip}}"{{/if}}>
        <label>{{f.label}}</label>
        <div class="form-fields">
          {{#if (eq f.kind "boolean")}}
            <input type="checkbox" name="{{f.name}}" {{checked f.checked}}{{#if f.disabled}} disabled{{/if}}>
          {{else if (eq f.kind "select")}}
            <select name="{{f.name}}"{{#if f.tip}} aria-label="{{f.label}}"{{/if}}{{#if f.disabled}} disabled{{/if}}>{{selectOptions f.choices selected=f.value blank=@root.none}}</select>
          {{else if (eq f.kind "number")}}
            <input type="number" step="{{f.step}}"{{#if f.min}} min="{{f.min}}"{{/if}} name="{{f.name}}" value="{{f.value}}" placeholder="—">
          {{else if f.list}}
            <input type="text" name="{{f.name}}" value="{{f.value}}" list="{{@root.partId}}-{{f.name}}"{{#if f.disabled}} disabled{{/if}}>
            <datalist id="{{@root.partId}}-{{f.name}}">
              {{#each f.list as |o|}}<option value="{{o.key}}">{{o.label}}</option>{{/each}}
            </datalist>
          {{else}}
            <input type="text" name="{{f.name}}" value="{{f.value}}">
          {{/if}}
        </div>
        {{#if f.drop}}
          <p class="hint">{{localize "ACKS-LIB.effectEditor.refDrop"}}</p>
          {{#if f.refLine}}<p class="hint">{{f.refLine}}</p>{{/if}}
        {{/if}}
      </div>
    {{/if}}
  {{/each}}

  <p class="hint">{{localize "ACKS-LIB.effectEditor.hint"}}</p>
</div>
