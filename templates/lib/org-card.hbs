{{!-- One card of the chart and, beneath it, its unfolded cards (board 1f). A card with
      nothing in it offers Roll and a pen; a filled card a pen and Send out, and no die.
      A leader's card is the Follower Card, drawn in the role frame of its rank (board 1l).
      A card in edit draws its own form (troop, bodies, champion, Remove, Done). Recursive. --}}
<li role="treeitem"{{#if role}} aria-label="{{rank}} · {{role.word}}"{{/if}} {{#if hasKids}}aria-expanded="{{#if folded}}false{{else}}true{{/if}}"{{/if}} data-key="{{key}}">
  <div class="acks-extras-org-card{{#if leader}} is-leader{{/if}}{{#if empty}} is-empty{{/if}}{{#if hidden}} is-hidden{{/if}}{{#if twin}} is-twin{{/if}}{{#if byHand}} is-hand{{/if}}{{#if editing}} is-on{{/if}}">
    <div class="acks-extras-org-card__head">
      {{#unless leader}}{{#if role}}<span class="acks-extras-pf acks-extras-pf--{{role.key}}" role="group" aria-label="{{role.label}}">{{#if officer.img}}<img class="acks-extras-org-card__art" src="{{officer.img}}" alt="" />{{else if img}}<img class="acks-extras-org-card__art" src="{{img}}" alt="" />{{/if}}</span><span class="acks-extras-pf__word" data-tooltip-text="{{role.tip}}">{{role.word}}</span>{{/if}}{{/unless}}
      <span class="acks-extras-org-card__rank">{{rank}}{{#if editing}} · {{localize "ACKS-LIB.org.card.inEdit"}}{{/if}}</span>
      {{#if hasKids}}
        <button type="button" class="acks-extras-org-card__fold" data-action="orgToggle" aria-expanded="{{#if folded}}false{{else}}true{{/if}}" aria-label="{{localize 'ACKS-LIB.org.card.fold' name=rank}}" data-tooltip="ACKS-LIB.org.card.foldTip"><i class="fas {{#if folded}}fa-chevron-right{{else}}fa-chevron-down{{/if}}" aria-hidden="true"></i></button>
      {{/if}}
    </div>
    {{#if empty}}
      <div class="acks-extras-org-card__more">{{localize "ACKS-LIB.org.card.empty"}}</div>
    {{else}}
      {{#if leader}}{{{leader}}}{{/if}}
      <div class="acks-extras-org-card__body">
        <span class="acks-extras-org-card__count{{#if byHand}} is-hand{{/if}}" data-tooltip-text="{{#if byHand}}{{handTip}}{{else}}{{countTip}}{{/if}}">{{localize "ACKS-LIB.org.card.bodies" n=count}}</span>
        {{#if byHand}}<span class="cite">{{localize "ACKS-LIB.org.card.byHand"}}</span>{{/if}}
        {{#if hidden}}<span class="acks-tag" data-tooltip="ACKS-LIB.org.card.hiddenTip">{{localize "ACKS-LIB.org.card.hidden"}}</span>{{/if}}
        {{#if twin}}<span class="acks-tag" data-tooltip="ACKS-LIB.org.card.twinTip">{{localize "ACKS-LIB.org.card.twin"}}</span>{{/if}}
      </div>
      {{#if editing}}
        <div class="acks-extras-org-card__form">
          <label>{{localize "ACKS-LIB.org.edit.label"}} <input type="text" data-org-field="label" value="{{edit.label}}" /></label>
          {{#each edit.stacks}}
            <div class="acks-extras-org-card__stack" data-org-stack="{{key}}">
              <span>{{name}}</span>
              {{#if troop}}<select data-org-field="troop" data-was="{{#each troop.options}}{{#if selected}}{{key}}{{/if}}{{/each}}" aria-label="{{localize 'ACKS-LIB.org.edit.troop' name=name}}" data-tooltip="ACKS-LIB.org.edit.troopTip">{{#each troop.options}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}{{#if offBands}} · {{localize "ACKS-LIB.org.edit.offBands"}}{{/if}}</option>{{/each}}</select>{{/if}}
              <input type="text" inputmode="numeric" class="acks-extras-org-card__bodies" data-org-field="count" value="{{count}}" aria-label="{{localize 'ACKS-LIB.org.edit.count' name=name}}" data-tooltip="ACKS-LIB.org.edit.bodiesTip" />
            </div>
          {{/each}}
          {{#if edit.hasOfficer}}<button type="button" data-action="orgClearLeader" data-tooltip="ACKS-LIB.org.edit.clearLeaderTip">{{edit.clearLabel}}</button>{{/if}}
        </div>
      {{/if}}
      {{#if folded}}<div class="acks-extras-org-card__more" data-tooltip="ACKS-LIB.org.card.belowTip">{{localize "ACKS-LIB.org.card.below" rows=below.rows bodies=below.bodies}}</div>{{/if}}
    {{/if}}
    {{#if editing}}
      <div class="acks-extras-org-card__foot">
        <button type="button" data-action="orgEditRemove" data-tooltip="ACKS-LIB.org.card.deleteTip">{{localize "ACKS-LIB.org.edit.remove"}}</button>
        <button type="button" data-action="orgEditDone" data-tooltip="ACKS-LIB.org.edit.doneTip">{{localize "ACKS-LIB.org.edit.done"}}</button>
      </div>
    {{else}}
    <div class="acks-extras-org-card__foot">
      {{#if isOut}}<span class="acks-extras-org-card__out" data-tooltip="ACKS-LIB.org.card.outTip">{{localize "ACKS-LIB.org.card.out" place=out.[0]}}</span>{{/if}}
      {{#if holderUuid}}<button type="button" data-action="orgOpen" data-uuid="{{holderUuid}}" data-tooltip="ACKS-LIB.org.card.openTip">{{localize "ACKS-LIB.org.card.open"}}</button>{{/if}}
      {{#if canEdit}}
        {{#if canRoll}}<button type="button" data-action="orgRoll" data-tooltip="ACKS-LIB.org.card.rollTip"><i class="fas fa-dice" aria-hidden="true"></i> {{localize "ACKS-LIB.org.card.roll"}}</button>{{/if}}
        <button type="button" data-action="orgAdd" data-tooltip="ACKS-LIB.org.card.addTip" aria-label="{{localize 'ACKS-LIB.org.card.add'}}"><i class="fas fa-plus" aria-hidden="true"></i></button>
        <button type="button" data-action="orgEdit" data-tooltip="{{#if empty}}ACKS-LIB.org.card.fillTip{{else}}ACKS-LIB.org.card.editTip{{/if}}" aria-label="{{localize 'ACKS-LIB.org.card.edit'}}"><i class="fas fa-pen" aria-hidden="true"></i></button>
        {{#unless empty}}
          {{#if isOut}}
            <button type="button" data-action="orgRecall" data-tooltip="ACKS-LIB.org.card.recallTip" aria-label="{{localize 'ACKS-LIB.org.card.recall'}}"><i class="fas fa-rotate-left" aria-hidden="true"></i></button>
          {{/if}}
          <button type="button" data-action="orgSendOut" data-tooltip="ACKS-LIB.org.card.sendTip" aria-label="{{localize 'ACKS-LIB.org.card.send'}}"><i class="fas fa-arrow-up-right-from-square" aria-hidden="true"></i></button>
        {{/unless}}
      {{/if}}
    </div>
    {{/if}}
  </div>
  {{#if children.length}}
    <ul role="group">
      {{#each children}}{{> "modules/acks-extras/templates/lib/org-card.hbs"}}{{/each}}
    </ul>
  {{/if}}
</li>
