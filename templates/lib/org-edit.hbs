{{!-- A card's pen: its label and note, its visibility, and each stack's count. --}}
<div class="acks-lib-group-roll">
  <label>{{localize "ACKS-LIB.org.edit.label"}} <input type="text" name="label" value="{{label}}" /></label>
  <label>{{localize "ACKS-LIB.org.edit.notes"}} <input type="text" name="notes" value="{{notes}}" /></label>
  {{#if isGM}}<label><input type="checkbox" name="hidden" {{#if hidden}}checked{{/if}} /> {{localize "ACKS-LIB.org.edit.hidden"}}</label>{{/if}}
  {{#each stacks}}
    <label>{{label}} <input type="number" min="0" step="1" name="count-{{key}}" value="{{count}}" aria-label="{{localize 'ACKS-LIB.org.edit.count' name=label}}" /></label>
  {{/each}}
  {{#if onMap}}<p class="hint">{{localize "ACKS-LIB.org.edit.onMapHint"}}</p>{{/if}}
</div>
