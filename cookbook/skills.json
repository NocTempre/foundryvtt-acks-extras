              "type": "sense",
              "vision": "lightless",
              "condition": "moving at combat or exploration speed",
              "from": {
                "into": "range",
                "pattern": "sheds\\s*dim\\s*light\\s*in\\s*a\\s*(\\d+)"
              },
              "note": "Sight with no light source, equal to dim light out to the located radius. Usable to fight and to probe for traps."
            },
            {
              "type": "limitation",
              "restriction": "Fails when deafened or in magical silence"
            },
            {
              "type": "limitation",
              "restriction": "Fails in bright light or in magical darkness"
            },
            {
              "type": "limitation",
              "restriction": "No colour or fine detail; cannot read by it"
            },
            {
              "type": "limitation",
              "restriction": "Counts as dim light, so a foe can still hide"
            }
          ]
        }
      }
