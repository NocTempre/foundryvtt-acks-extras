# The bot's environment: only what it needs to REACH the world. Everything
# else — the Discord token, the server, the relay channel, the seat's size —
# is set in Foundry, under Settings → Extras → Discord Bot, and read from the
# world by the running bot.
#
# On the Linux host, `sudo npm run install-service` asks for these and writes
# the service's own file (/etc/acks-extras-discord.env). For a run by hand,
# copy this to .env beside src/. Never commit the copy.

# --- Foundry (the world the bot sits in) ---
FOUNDRY_ORIGIN=http://localhost:30000
# A dedicated user at Assistant Gamemaster, created for the bot. Its password, if it has one.
FOUNDRY_USER=Discord
FOUNDRY_PASSWORD=

# --- The seat's browser: a Chromium-family binary on this machine ---
# Found automatically in the usual places; set it only when it is somewhere else.
# Linux: apt install chromium (Debian/Ubuntu) puts it at /usr/bin/chromium.
# Windows: BROWSER=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
BROWSER=
# DevTools port the seat listens on locally; change only if something else holds it.
SEAT_PORT=9334

# --- Overrides ---
# Anything below wins over what Foundry says, for an operator who would rather
# keep it on the host. Leave them empty and configure the bot in Foundry.
DISCORD_TOKEN=
DISCORD_APP_ID=
DISCORD_GUILD_ID=
DISCORD_JUDGE_IDS=
DISCORD_CHAT_CHANNEL_ID=
LOG_LEVEL=
