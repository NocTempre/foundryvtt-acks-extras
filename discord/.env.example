# The bot's environment. On the Linux host, `sudo npm run install-service`
# asks for these and writes the service's own file (/etc/acks-extras-discord.env).
# For a run by hand, copy this to .env beside src/. Never commit the copy.

# --- Discord (from the Developer Portal; the operator creates the application) ---
DISCORD_TOKEN=
DISCORD_APP_ID=
DISCORD_GUILD_ID=
# Discord user ids who may run the Judge commands before anyone is linked (comma-separated).
DISCORD_JUDGE_IDS=
# Optional: a channel that receives the world's public chat.
DISCORD_CHAT_CHANNEL_ID=

# --- Foundry (the world the bot sits in) ---
FOUNDRY_ORIGIN=http://localhost:30000
# A dedicated user at Assistant Gamemaster, created for the bot. Its password, if it has one.
FOUNDRY_USER=Discord
FOUNDRY_PASSWORD=

# --- The seat's browser: a Chromium-family binary on this machine ---
# Linux: apt install chromium (Debian/Ubuntu) puts it here.
BROWSER=/usr/bin/chromium
# Windows: BROWSER=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
# DevTools port the seat listens on locally; change only if something else holds it.
SEAT_PORT=9334
