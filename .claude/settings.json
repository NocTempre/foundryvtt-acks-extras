{
  "permissions": {
    "allow": [
      "Bash(npm install)",
      "Bash(npm install *)",
      "Bash(npm ci)",
      "Bash(npm run *)",
      "Bash(npm test)",
      "Bash(npm ls *)",
      "Bash(node tools/*)",
      "Bash(node --check *)",
      "Bash(node -e *)",
      "Bash(node -p *)",
      "Bash(node --input-type=module -e *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git restore *)",
      "Bash(git commit *)",
      "Bash(git tag *)",
      "Bash(git push *)",
      "Bash(git ls-remote *)",
      "Bash(gh run *)",
      "Bash(gh release *)",
      "Bash(curl -s https://api.github.com/repos/NocTempre/*)",
      "Bash(curl -sL https://github.com/NocTempre/*)",
      "Bash(npm test *)",
      "Bash(node - *)",
      "Bash(node /c/Proj/acks-module-template/bin/sync-toolchain.mjs --check)",
      "Bash(git fetch *)",
      "Bash(git check-ignore *)",
      "mcp__Claude_Browser__read_console_messages",
      "mcp__Claude_Browser__find",
      "mcp__Claude_Browser__tabs_context",
      "mcp__ccd_session_mgmt__search_session_transcripts"
    ]
  },
  "worktree": {
    "bgIsolation": "none"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "if": "Bash(git *)",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/single-branch-guard.mjs\" pretool",
            "statusMessage": "Checking branch convention"
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/no-windows-path-heredoc.mjs\"",
            "statusMessage": "Checking heredoc for Windows paths"
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/shared-tree-guard.mjs\"",
            "statusMessage": "Checking the shared tree"
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/shared-tree-guard.mjs\"",
            "statusMessage": "Checking the shared tree"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/edit-ledger.mjs\"",
            "timeout": 20
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/single-branch-guard.mjs\" worktree-create"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/single-branch-guard.mjs\" session-start"
          }
        ]
      }
    ]
  }
}
