{
  "id": "acks-extras",
  "title": "ACKS II — Extras",
  "description": "Rules automation for ACKS II: proficiencies and class powers, equipment and fighting styles, exploration formations, henchmen and hirelings, influence and reactions, locations and storage, and the full Monstrous Manual stat block — over shared primitives and one rules-table registry.",
  "version": "4.15.1",
  "socket": true,
  "compatibility": {
    "minimum": "14",
    "verified": "14.364"
  },
  "authors": [
    {
      "name": "NocTempre"
    }
  ],
  "license": "LICENSE",
  "esmodules": [
    "scripts/module.mjs"
  ],
  "styles": [
    "styles/lib.css",
    "vendor/acks-design/acks-design.css",
    "styles/lib-sheet-theme.css",
    "styles/lib-follower-card.css",
    "styles/abilities.css",
    "styles/battlemap.css",
    "styles/classes.css",
    "styles/equipment.css",
    "styles/formation.css",
    "styles/henchmen.css",
    "styles/influence.css",
    "styles/location.css",
    "styles/markets.css",
    "styles/monsters.css",
    "styles/vehicles.css"
  ],
  "languages": [
