        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "equipment-samples",
      "label": "ACKS Equipment Samples (Shield Variants, Masterwork, Named)",
      "path": "packs/equipment-samples",
      "type": "Item",
      "system": "acks",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    },
    {
