  "packFolders": [
    {
      "name": "ACKS II",
      "sorting": "m",
      "color": "#822638",
      "packs": [
        "equipment-training",
        "equipment-proficiencies",
        "equipment-samples",
        "proficiencies-powers",
        "macros"
      ]
    }
  ],
  "relationships": {
    "systems": [
      {
        "id": "acks",
        "type": "system",
        "compatibility": {
          "minimum": "14"
        }
      }
    ],
    "requires": [
      {
        "id": "lib-wrapper",
        "type": "module",
        "reason": "Wraps core AcksItem roll and tag methods so every route into a roll picks up ability, equipment and proficiency modifiers.",
        "compatibility": {
          "minimum": "1.12.0"
        }
      },
      {
        "id": "socketlib",
        "type": "module",
        "reason": "Routes equip auto-resolve, loadout-effect writes and GM-only rolls through the primary GM so players can act without ownership grants.",
        "compatibility": {
          "minimum": "1.1.0"
        }
      }
    ]
  },
  "url": "https://github.com/NocTempre/foundryvtt-acks-extras",
