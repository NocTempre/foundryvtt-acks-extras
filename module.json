{
  "id": "acks-extras",
  "title": "ACKS II — Extras",
  "description": "Rules automation for ACKS II: proficiencies and class powers, equipment and fighting styles, exploration formations and overland travel — weather, wilderness encounters and the vehicles that carry a party — henchmen and hirelings, influence and reactions, locations and storage, and the full Monstrous Manual stat block, over shared primitives and one rules-table registry. Includes the importer: monsters, classes, proficiencies, equipment, price and rules tables, locations and roll tables read from the reader's own ACKS II PDFs — it ships extraction recipes, never the book text. Bring your own book.",
  "version": "6.1.0",
  "socket": true,
  "compatibility": {
    "minimum": "14",
    "verified": "14.364"
  },
  "authors": [
    {
      "name": "NocTempre"
    }
  ],
  "license": "LICENSE",
  "esmodules": [
    "scripts/module.mjs"
  ],
  "styles": [
    "styles/lib.css",
    "vendor/acks-design/acks-design.css",
    "styles/lib-sheet-theme.css",
    "styles/lib-follower-card.css",
    "styles/abilities.css",
    "styles/battlemap.css",
    "styles/classes.css",
    "styles/equipment.css",
    "styles/equipment-item-sheet.css",
    "styles/formation.css",
    "styles/henchmen.css",
    "styles/importer.css",
    "styles/influence.css",
    "styles/location.css",
    "styles/markets.css",
    "styles/monsters.css",
    "styles/vehicles.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "documentTypes": {
    "Actor": {
      "animal": {
        "htmlFields": [
          "details.biography"
        ]
      },
      "group": {
        "htmlFields": [
          "details.biography"
        ]
      },
      "template": {
        "htmlFields": [
          "details.biography"
        ]
      },
      "party": {},
      "location": {
        "htmlFields": [
          "notes"
        ]
      },
      "vehicle": {
        "htmlFields": [
          "description"
        ]
      }
    },
    "RegionBehavior": {
      "encounterZone": {},
      "trapZone": {}
    },
    "Item": {
      "attitude": {},
      "class": {
        "htmlFields": [
          "description",
          "codeOfBehavior"
        ]
      },
      "race": {
        "htmlFields": [
          "description"
        ]
      },
      "trap": {
        "htmlFields": [
          "description"
        ]
      },
      "variation": {
        "htmlFields": [
          "description"
        ]
      }
    }
  },
  "packs": [
    {
      "name": "macros",
      "label": "ACKS Extras Macros",
      "path": "packs/macros",
      "type": "Macro",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    }
  ],
  "packFolders": [
    {
      "name": "ACKS II — Extras",
      "sorting": "m",
      "color": "#822638",
      "packs": [],
      "folders": [
        {
          "name": "Macros",
          "sorting": "a",
          "color": "#822638",
          "packs": [
            "macros"
          ]
        }
      ]
    }
  ],
  "relationships": {
    "systems": [
      {
        "id": "acks",
        "type": "system",
        "compatibility": {
          "minimum": "14"
        }
      }
    ],
    "requires": [
      {
        "id": "lib-wrapper",
        "type": "module",
        "reason": "Wraps core AcksItem roll and tag methods so every route into a roll picks up ability, equipment and proficiency modifiers.",
        "compatibility": {
          "minimum": "1.12.0"
        }
      },
      {
        "id": "socketlib",
        "type": "module",
        "reason": "Routes equip auto-resolve, loadout-effect writes and GM-only rolls through the primary GM so players can act without ownership grants.",
        "compatibility": {
          "minimum": "1.1.0"
        }
      }
    ],
    "recommends": [
      {
        "id": "game-icons-net",
        "type": "module",
        "reason": "Niche ability icons for the ACKS-shaped corners of the imported corpus (Acrobatics, Blind Fighting, Caving, Mapping). Optional: without it every ability falls back to a core Foundry icon."
      }
    ],
    "conflicts": [
      {
        "id": "acks-importer",
        "type": "module",
        "reason": "The importer is part of this module now. With the separate module still active the built-in importer stays off and every load says so; disable acks-importer and reload, and the imported library is carried over."
      }
    ]
  },
  "url": "https://github.com/NocTempre/foundryvtt-acks-extras",
  "manifest": "https://github.com/NocTempre/foundryvtt-acks-extras/releases/latest/download/module.json",
  "download": "https://github.com/NocTempre/foundryvtt-acks-extras/releases/latest/download/module.zip",
  "flags": {
    "acks-extras": {
      "idPrefix": "acks"
    }
  }
}
