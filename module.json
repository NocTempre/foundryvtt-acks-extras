        ]
      }
    },
    "RegionBehavior": {
      "encounterZone": {},
      "trapZone": {}
    },
    "Item": {
      "attitude": {},
      "class": {
        "htmlFields": [
          "description",
          "codeOfBehavior"
        ]
      },
      "race": {
        "htmlFields": [
          "description"
